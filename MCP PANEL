        const [x0, y0] = p(a0), [x1, y1] = p(a1);
        return `<path class="ln" d="M${x0.toFixed(1)},${y0.toFixed(1)} A${r},${r} 0 0 ${a1 > a0 ? 1 : 0} ${x1.toFixed(1)},${y1.toFixed(1)}"/>`;
    };
    const ticks = (cx, cy, angles, r0, r1) => angles.map(a => {
        const s = Math.sin(a * Math.PI / 180), c = Math.cos(a * Math.PI / 180);
        return `<path class="ln" d="M${(cx + r0 * s).toFixed(1)},${(cy - r0 * c).toFixed(1)} L${(cx + r1 * s).toFixed(1)},${(cy - r1 * c).toFixed(1)}"/>`;

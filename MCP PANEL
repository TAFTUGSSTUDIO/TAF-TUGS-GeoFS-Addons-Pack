// ==UserScript==
// @name         MCP PANEL
// @namespace    http://tampermonkey.net/
// @version      5.1
// @description  Realistic MCP/FCU for GeoFS. Layout + colours switch per aircraft. Tu-144 radar (РЛС) mode now shows Immersive Airports ground data (runways, taxiways, aprons, stands) and multiplayer traffic.
// @match        https://*.geo-fs.com/geofs.php*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    ['geofs-mcp-container', 'geofs-mcp-tab', 'geofs-mcp-style'].forEach(id => {
        const e = document.getElementById(id);
        if (e) e.remove();
    });

    const $ = id => document.getElementById(id);
    let W = 1592, H = 253;
    let scaleMul = 1;

    // ------------------------------------------------------------------ CSS
    const style = document.createElement('style');
    style.id = 'geofs-mcp-style';
    style.textContent = `
    #geofs-mcp-container{position:fixed;bottom:34px;left:50%;transform:translateX(-50%);z-index:999999;display:none;
        user-select:none;cursor:move;border-radius:10px;box-shadow:0 14px 40px rgba(0,0,0,.85);
        --bg:#575b5f;--border:#26282a;--txt:#f3f3f3;--disp:#f6f6f6;--face:#17181a;--k1:#a7a9ab;--k2:#5a5d60;}
    #mcp-stage{position:absolute;left:0;top:0;box-sizing:border-box;transform-origin:0 0;
        border:4px solid var(--border);border-radius:14px;overflow:hidden;color:var(--txt);
        font-family:Arial,Helvetica,sans-serif;
        background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(0,0,0,.17)),var(--bg);}
    #mcp-stage .lab{position:absolute;transform:translate(-50%,-50%);font-weight:bold;font-size:17px;line-height:1.1;
        text-align:center;color:var(--txt);white-space:nowrap;letter-spacing:.3px;pointer-events:none}
    #mcp-stage .lab.sm{font-size:15px}
    #mcp-stage .lab.xs{font-size:12px}
    .mcp-static{position:absolute;left:0;top:0;pointer-events:none}

    .mcp-static .ln{stroke:var(--txt);stroke-width:2.5;fill:none;stroke-linecap:round}

    .disp{position:absolute;box-sizing:border-box;background:linear-gradient(#030303,#101010);border:3px solid #1c1c1c;
        border-radius:5px;box-shadow:0 0 0 2px rgba(0,0,0,.45),inset 0 0 10px #000;display:flex;align-items:center;
        justify-content:center;gap:8px;cursor:ns-resize;overflow:hidden}
    .disp::after{content:'';position:absolute;left:0;right:0;top:0;height:45%;
        background:linear-gradient(rgba(255,255,255,.09),rgba(255,255,255,0));pointer-events:none}
    .disp.lcd{background:none;border:none;box-shadow:none;gap:6px}
    .disp.lcd::after{display:none}
    .disp.drum{gap:0;justify-content:stretch;border-width:2px;border-radius:2px}
    .dg{width:23px;height:32px;flex:none;overflow:visible}
    .dg .off{fill:rgba(255,255,255,.07)}
    .dg .on{fill:var(--disp);filter:drop-shadow(0 0 2.5px var(--disp))}

    .dr{display:flex;width:100%;height:100%}
    .dr span{flex:1;display:flex;align-items:center;justify-content:center;font:bold 26px Arial,Helvetica,sans-serif;
        color:var(--disp);border-left:1px solid #3a3a3a;border-right:1px solid #1a1a1a;position:relative;
        background:linear-gradient(#0a0a0a,#1b1b1b 50%,#0a0a0a)}
    .dr span::after{content:'';position:absolute;inset:0;
        background:linear-gradient(rgba(0,0,0,.7),rgba(0,0,0,0) 32%,rgba(0,0,0,0) 68%,rgba(0,0,0,.7))}
    /* white-paper drum (Soviet KURS / declination windows) */
    .disp.paper{border-color:#0c0c0c;background:#d9d9d0}
    .disp.paper::after{display:none}
    .disp.paper .dr span{color:#111;border-left:1px solid #8d8d84;border-right:1px solid #f4f4ec;
        background:linear-gradient(#bdbdb3,#f6f6ee 50%,#bdbdb3)}
    .disp.paper .dr span::after{background:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,0) 30%,rgba(0,0,0,0) 70%,rgba(0,0,0,.45))}

    .lcdp{position:absolute;box-sizing:border-box;background:linear-gradient(#050505,#101214);border:2px solid #1b2024;
        border-radius:6px;box-shadow:inset 0 0 10px #000,0 0 0 2px rgba(0,0,0,.4)}

    .btn{position:absolute;box-sizing:border-box;border-radius:6px;
        background:linear-gradient(#34363a,#151618 60%,#0d0d0e);border:2px solid #050505;
        box-shadow:inset 0 1px 1px rgba(255,255,255,.28),0 0 0 2px rgba(0,0,0,.35),0 3px 6px rgba(0,0,0,.65);cursor:pointer}
    .btn:active{transform:translateY(2px);box-shadow:inset 0 2px 5px #000,0 0 0 2px rgba(0,0,0,.35)}
    .btn .bt{position:absolute;top:13px;left:0;right:0;text-align:center;font-weight:bold;font-size:15px;color:#f4f4f4;
        letter-spacing:-.3px;white-space:nowrap}
    .btn .lamp{position:absolute;left:50%;bottom:13px;width:44px;height:12px;margin-left:-22px;border-radius:1px;
        background-color:#173617;background-image:conic-gradient(#28522a 25%,#0d210e 0 50%,#28522a 0 75%,#0d210e 0);
        background-size:4px 4px;box-shadow:inset 0 0 2px #000}
    .btn.on .lamp{background-color:#2eea3c;
        background-image:conic-gradient(#5aff62 25%,#17a824 0 50%,#5aff62 0 75%,#17a824 0);
        box-shadow:0 0 9px 2px rgba(60,255,70,.65)}
    /* flat (747/777 style): legend lights up */
    .btn.flat{background:linear-gradient(#2a2b2e,#111214);border-radius:4px}
    .btn.flat .bt{top:50%;transform:translateY(-50%);font-size:13px;letter-spacing:0;color:#e9e9e9}
    .btn.flat .lamp{display:none}
    .btn.flat.on .bt{color:#72ff82;text-shadow:0 0 7px #2dff45}
    .btn.flat.on{box-shadow:inset 0 0 9px rgba(60,255,80,.38),0 0 0 2px rgba(0,0,0,.35),0 3px 6px rgba(0,0,0,.65)}
    /* airbus FCU style: green bar on top */
    .btn.ab{background:linear-gradient(#2c2e31,#101112);border-radius:4px}
    .btn.ab .bt{top:60%;transform:translateY(-50%);font-size:13px;letter-spacing:0}
    .btn.ab .lamp{top:5px;bottom:auto;width:30px;height:5px;margin-left:-15px;background:#17331a;background-image:none}
    .btn.ab.on .lamp{background:#58ff62;box-shadow:0 0 8px 2px rgba(80,255,90,.7)}

    .disp.led{background:linear-gradient(#030a04,#08140a);border-color:#16241a}
    .disp.led .dg .on{fill:#8dff3a;filter:drop-shadow(0 0 3px #4dff00)}
    .disp.s2{gap:4px}
    .disp.s2 .dg{width:18px;height:27px}
    .disp.blue{background:linear-gradient(#08122a,#0c1a3c);border:2px solid #2a3858}
    .disp.sm{gap:3px;border-radius:3px}
    .disp.sm .dg{width:11px;height:16px}
    .disp.dsm .dr span{font-size:16px}
    .dr span.dot{flex:.35}

    .btn.cc{border-radius:3px}
    .btn.cc .bt{font-size:10px;line-height:1.05;white-space:normal;padding:0 1px}
    .btn.cc.flat.on .bt{color:#ffb340;text-shadow:0 0 6px #ff9a00}
    .btn.sm .bt{font-size:10px}
    .tsw{position:absolute;box-sizing:border-box;border:2px solid #8b8e92;border-radius:3px;overflow:hidden;cursor:pointer;
        background:linear-gradient(90deg,#1b1c1e,#2a2b2e,#1b1c1e)}
    .tsw .lv{position:absolute;left:3px;right:3px;height:46%;top:50%;border-radius:2px;transition:top .12s;
        background:linear-gradient(#ececec,#9a9c9e)}
    .tsw.on .lv,.tsw.fd .lv{top:4px}
    .tsw.fd.off .lv{top:50%}
    .tsw.on::after{content:'';position:absolute;left:0;right:0;bottom:3px;height:4px;background:#5dff6a;box-shadow:0 0 6px #5dff6a}

    .afs{position:absolute;box-sizing:border-box;border-radius:3px;cursor:pointer;border:2px solid #555;
        background:linear-gradient(#f4f1e6,#bfb9a6);box-shadow:0 2px 4px rgba(0,0,0,.6)}
    .afs.on{background:linear-gradient(#c4ffca,#46d058);box-shadow:0 0 8px rgba(60,255,80,.6)}
    .afbox{position:absolute;box-sizing:border-box;display:flex;align-items:center;justify-content:center;font-weight:bold;
        font-size:14px;color:#fff;letter-spacing:.5px;background:linear-gradient(#17181a,#0c0c0d);border:2px solid #6b6e72;border-radius:3px}
    .rbtn{position:absolute;box-sizing:border-box;border-radius:50%;
        background:radial-gradient(circle at 50% 40%,#2c2c2e,#050505 70%);border:3px solid #8b8d90;
        box-shadow:inset 0 0 6px #000,0 0 0 2px rgba(0,0,0,.4);cursor:pointer}
    .rbtn:active{transform:translateY(1px);background:#000}

    .knob{position:absolute;cursor:pointer;touch-action:none}
    .knob svg{width:100%;height:100%;overflow:visible;display:block}
    .rot{transform-origin:50px 50px;transition:transform .08s ease-out}

    .vsw{position:absolute;box-sizing:border-box;border-radius:28px;background:#0c0c0d;border:3px solid #2a2a2c;
        box-shadow:inset 0 0 8px #000,0 0 0 2px rgba(0,0,0,.4);cursor:ns-resize;display:flex;align-items:center;justify-content:center}
    .vsw .wh{position:relative;border-radius:9px;overflow:hidden;
        background:repeating-linear-gradient(to bottom,#f6f6f3 0 4px,#b4b4af 4px 7px);box-shadow:0 0 4px #000}
    .vsw .wh::after{content:'';position:absolute;inset:0;
        background:linear-gradient(to bottom,rgba(0,0,0,.62),rgba(0,0,0,0) 28%,rgba(0,0,0,0) 72%,rgba(0,0,0,.62)),
                   linear-gradient(to right,rgba(0,0,0,.25),rgba(255,255,255,.12) 50%,rgba(0,0,0,.25))}

    .fdsw{position:absolute;box-sizing:border-box;border:2px solid var(--txt);border-radius:4px;background:#1a1a1b;cursor:pointer}
    .fdsw .lv{position:absolute;left:3px;right:3px;top:2px;height:20px;border-radius:3px;transition:top .1s;
        background:linear-gradient(90deg,#8e9092,#ececec,#85878a)}
    .fdsw.off .lv{top:21px}
    .rsw{position:absolute;box-sizing:border-box;border:2px solid var(--txt);border-radius:50%;cursor:pointer;
        background:radial-gradient(#2a2b2e,#0c0c0d)}
    .rsw .lv{position:absolute;left:14px;top:5px;width:10px;height:22px;border-radius:5px;transform-origin:50% 100%;
        transform:rotate(-28deg);transition:transform .12s;background:linear-gradient(90deg,#8c8f93,#ececec,#8c8f93)}
    .rsw.off .lv{transform:rotate(28deg)}

    .atsw{position:absolute;cursor:pointer}
    .atsw svg{width:100%;height:100%;display:block;overflow:visible}
    #at-lever{transform-origin:45px 45px}
    #at-led{position:absolute;box-sizing:border-box;border-radius:3px;background:#17351a;border:1px solid #0a1a0c;
        box-shadow:inset 0 1px 2px #000}
    #at-led.on{background:#52ff44;box-shadow:0 0 9px 2px rgba(80,255,70,.7)}

    .ma{position:absolute;box-sizing:border-box;border-radius:50%;background:radial-gradient(circle at 40% 35%,#1d3a1d,#071007);
        border:2px solid #0a0a0a;color:#2c8a2c;font-weight:bold;font-size:13px;display:flex;align-items:center;
        justify-content:center;box-shadow:inset 0 0 4px #000}
    .ma.on{background:radial-gradient(circle at 40% 35%,#3dff3d,#128c12);color:#031a03;box-shadow:0 0 10px 2px rgba(60,255,60,.6)}

    .disengage{position:absolute;box-sizing:border-box;border:3px solid var(--txt);border-radius:10px 10px 0 0;cursor:pointer}
    .disengage .bar{position:absolute;left:6px;right:6px;top:10px;bottom:-4px;border-radius:4px 4px 0 0;
        background:linear-gradient(#bfc2bf,#8d908d);box-shadow:inset 0 2px 3px rgba(255,255,255,.5),inset 0 -3px 6px rgba(0,0,0,.35)}
    .disengage.press .bar{filter:brightness(.85)}
    .disengage .tt{position:absolute;left:50%;top:-12px;transform:translateX(-50%);padding:0 8px;font-weight:bold;
        font-size:16px;color:var(--txt);background:var(--bg);white-space:nowrap}
    .disengage.alert .bar{background:linear-gradient(#ff9a8f,#d9382b)}
    .disengage.plain{border:none;border-radius:0}
    .disengage.plain .tt{top:-24px;background:none;padding:0;font-size:15px}
    .disengage.plain .bar{left:0;right:0;top:0;border-radius:2px 2px 0 0;background:linear-gradient(#f6f0de,#cdc5ae)}
    .disengage.plain.alert .bar{background:linear-gradient(#ff9a8f,#d9382b)}

    /* round lamp buttons (AN-124/225 + Tu-144 panels) */
    .rl{position:absolute;border-radius:50%;box-sizing:border-box;border:3px solid #050505;cursor:pointer;
        background:radial-gradient(circle at 40% 35%,var(--c1),var(--c2));filter:brightness(.5);
        box-shadow:inset 0 0 6px #000,0 0 0 2px rgba(0,0,0,.4)}
    .rl.on{filter:none;box-shadow:inset 0 0 4px rgba(255,255,255,.4),0 0 12px 3px var(--c1)}
    .rl:active{transform:translateY(1px)}

    /* Tu-144 round map indicator */
    .scope{position:absolute;border-radius:50%;cursor:pointer}
    .scope svg{display:block}
    .scope .face{fill:url(#glassOff);stroke:#050505;stroke-width:2}
    .scope .offglare{opacity:.55;transition:opacity .2s;pointer-events:none}
    .scope.on .offglare{opacity:0}
    .scope .glow{fill:none;pointer-events:none}
    .scope.on .face{fill:url(#paperGlow)}
    .scope.radar .face{fill:#07140b}
    .scope .trk{stroke:#101010}
    .scope.radar .trk{stroke:#bff5c8}
    .scope .trkt{fill:#222}
    .scope.radar .trkt{fill:#bff5c8}
    .scope .pmap{opacity:0;transition:opacity .2s}
    .scope.on .pmap{opacity:1}
    .scope.radar .pmap{opacity:0}
    .scope .map{opacity:0;transition:opacity .2s}
    .scope.on .map{opacity:1}
    /* radar mode */
    .scope .rdr{opacity:0;transition:opacity .2s;pointer-events:none}
    .scope.radar .rdr{opacity:1}
    .scope.radar .map{opacity:0}
    /* КУРС drum: the last digit sits in its own window */
    .disp.split .dr span:last-child{margin-left:5px;border-left:2px solid #050505;
        background:linear-gradient(#cfc7a0,#fbf4cc 50%,#cfc7a0)}
    .scope.on .glow{fill:url(#scopeGlow)}
    #scope-ring{transition:transform .25s linear}

    /* Tu-144 extras: amber annunciators, toggles, rotary selectors */
    .ann{position:absolute;box-sizing:border-box;border-radius:3px;border:2px solid #0a0a0a;cursor:pointer;
        display:flex;align-items:center;justify-content:center;text-align:center;font:bold 11px/1.05 Arial,Helvetica,sans-serif;
        color:#6b3000;background:linear-gradient(#b05a1c,#7c3b10);
        box-shadow:inset 0 0 6px rgba(0,0,0,.6),0 0 0 2px rgba(0,0,0,.4)}
    .ann.on{color:#2a1000;background:linear-gradient(#ffc650,#ff8a1a);
        box-shadow:inset 0 0 6px rgba(255,255,255,.5),0 0 12px 2px rgba(255,150,30,.7),0 0 0 2px rgba(0,0,0,.4)}
    .tgl{position:absolute;cursor:pointer}
    .tgl .nut{position:absolute;left:50%;top:50%;width:20px;height:20px;margin:-10px 0 0 -10px;border-radius:50%;z-index:2;
        background:radial-gradient(circle at 40% 35%,#9a9da0,#2a2b2d);border:2px solid #0a0a0a}
    .tgl .lv2{position:absolute;left:50%;top:50%;width:10px;height:36px;margin:-36px 0 0 -5px;border-radius:5px;
        transform-origin:50% 100%;transform:rotate(-12deg);transition:transform .22s cubic-bezier(.4,0,.2,1);
        background:linear-gradient(90deg,#8c8f93,#f2f2f2,#8c8f93);box-shadow:0 1px 3px #000}
    .tgl .lv2::after{content:'';position:absolute;left:-2px;right:-2px;top:-3px;height:10px;border-radius:5px;
        background:radial-gradient(circle at 40% 35%,#fff,#aeb2b6);box-shadow:0 1px 2px #000}
    .tgl.up .lv2{transform:rotate(168deg)}
    .tgl.blue .lv2{background:linear-gradient(90deg,#4a74c9,#b0c8ff,#4a74c9)}
    .tgl.h .lv2{width:54px;height:9px;margin:-4.5px 0 0 0;transform-origin:0 50%;transform:rotate(9deg);
        background:linear-gradient(180deg,#8c8f93,#f2f2f2,#8c8f93)}
    .tgl.h .lv2::after{left:auto;right:-3px;top:-2px;bottom:auto;width:11px;height:13px}
    .tgl.h.up .lv2{transform:rotate(171deg)}
    .btn.free.on .bt{color:#ffb340}
    .btn.flat.free.on{box-shadow:inset 0 0 10px rgba(255,40,70,.55),0 0 0 2px rgba(0,0,0,.35)}

    .disp.dec{border-color:#16171a;background:#cbb9a2}
    .disp.dec::after{display:none}
    .disp.dec .dr span{color:#2a1a10;border-left:1px solid #8f7e68;border-right:1px solid #f1e6d4;
        background:linear-gradient(#b3a28a,#f0e4d0 50%,#b3a28a)}
    .disp.dec .dr span::after{background:linear-gradient(rgba(0,0,0,.4),rgba(0,0,0,0) 30%,rgba(0,0,0,0) 70%,rgba(0,0,0,.4))}
    .lcap{position:absolute;border-radius:50%;cursor:pointer;box-sizing:border-box;border:3px solid #26282a;
        background:radial-gradient(circle at 40% 35%,#ff7656,#a3170b 55%,#4a0703);filter:brightness(.7);
        box-shadow:0 0 0 2px #6b4a2a,inset 0 0 6px #000}
    .lcap::after{content:'';position:absolute;left:0;right:0;top:0;bottom:0;border-radius:50%;
        background:repeating-conic-gradient(rgba(0,0,0,.35) 0 7deg,rgba(0,0,0,0) 7deg 15deg)}
    .lcap.on{filter:none;box-shadow:0 0 0 2px #6b4a2a,0 0 14px 4px rgba(255,70,40,.75)}
    .tgl:not(.h) .nut{width:30px;height:30px;margin:-15px 0 0 -15px;border:none;
        clip-path:polygon(25% 4%,75% 4%,100% 50%,75% 96%,25% 96%,0 50%);
        background:radial-gradient(circle at 40% 35%,#e3c46a,#8a6a24 60%,#4d3a12)}
    .tgl:not(.h) .lv2{height:30px;margin-top:-30px;width:8px;margin-left:-4px}
    .sw{position:absolute;border-radius:10px;cursor:ns-resize;overflow:hidden;background:#0a0a0b;border:2px solid #000;
        box-shadow:0 2px 6px #000,inset 0 0 6px #000;touch-action:none}
    .sw .rib{position:absolute;left:0;right:0;top:0;bottom:0;display:block;
        background:repeating-linear-gradient(to bottom,#585b60 0 3px,#17181a 3px 7px);transition:background-position .12s}
    .sw::after{content:'';position:absolute;left:0;right:0;top:0;bottom:0;pointer-events:none;
        background:linear-gradient(to bottom,rgba(0,0,0,.9),rgba(0,0,0,0) 36%,rgba(0,0,0,0) 64%,rgba(0,0,0,.9)),
                   linear-gradient(to right,rgba(0,0,0,.5),rgba(255,255,255,.10) 50%,rgba(0,0,0,.5))}
    .sw .emb{position:absolute;left:50%;top:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;z-index:2;display:block;
        background:radial-gradient(circle at 40% 35%,#1d1e20,#050505);border:3px solid #eee;box-sizing:border-box;
        color:#eee;font:bold 14px/19px Arial;text-align:center;font-style:normal}
    .ipo{position:absolute;cursor:pointer}
    .ipo svg{width:100%;height:100%;display:block;overflow:visible}
    .ipo:active{filter:brightness(.85)}
    .rk{position:absolute;border-radius:50%;cursor:pointer;touch-action:none;
        background:radial-gradient(circle at 40% 35%,#52555a,#0b0b0c 72%);border:2px solid #000;box-shadow:0 2px 5px #000,inset 0 0 4px rgba(255,255,255,.12)}
    .rk:hover{filter:brightness(1.3)}
    .rk svg{width:100%;height:100%;display:block;overflow:visible;pointer-events:none}
    .rlsunit .scr{fill:#a9b5b9}
    .rlsunit.on .scr{fill:#06130a}
    .rlsunit .fx{opacity:0;transition:opacity .25s}
    .rlsunit.on .fx{opacity:1}
    .rlsunit .rb{position:absolute;box-sizing:border-box;border:2px solid #050505;border-radius:3px;cursor:pointer;
        background:linear-gradient(#232425,#0d0d0e);color:#e6e6e0;font:bold 20px Arial;display:flex;align-items:center;
        justify-content:center;box-shadow:inset 0 1px 1px rgba(255,255,255,.2)}
    .rlsunit .rb.act{color:#7dff8f;text-shadow:0 0 8px #2dff45}
    .rbtn.on{border-color:#5dff6a;box-shadow:inset 0 0 6px #000,0 0 7px #5dff6a}
    .inop{opacity:.42;filter:saturate(.3) brightness(.8);cursor:not-allowed}
    .inop:active{transform:none}
    .mcp-toggle-tab{position:fixed;bottom:0;left:50%;transform:translateX(-50%);z-index:999998;
        --bg:#575b5f;--border:#26282a;--txt:#f3f3f3;
        background:var(--border);color:var(--txt);border:2px solid var(--bg);border-bottom:none;padding:6px 20px;
        border-radius:6px 6px 0 0;cursor:pointer;font-family:monospace;font-weight:bold;font-size:12px;
        box-shadow:0 -4px 10px rgba(0,0,0,.5);transition:background .4s,border-color .4s}
    `;
    document.head.appendChild(style);

    // ------------------------------------------------------- 7-segment digits
    const SEGS = {
        a: 'M3.5,1.5 L5.5,0 L14.5,0 L16.5,1.5 L14.5,3 L5.5,3Z',
        g: 'M3.5,16.5 L5.5,15 L14.5,15 L16.5,16.5 L14.5,18 L5.5,18Z',
        d: 'M3.5,31.5 L5.5,30 L14.5,30 L16.5,31.5 L14.5,33 L5.5,33Z',
        f: 'M1.5,2.5 L3,4 L3,13.5 L1.5,15 L0,13.5 L0,4Z',
        b: 'M18.5,2.5 L20,4 L20,13.5 L18.5,15 L17,13.5 L17,4Z',
        e: 'M1.5,18 L3,19.5 L3,29 L1.5,30.5 L0,29 L0,19.5Z',
        c: 'M18.5,18 L20,19.5 L20,29 L18.5,30.5 L17,29 L17,19.5Z'
    };
    const MAP = { '0': 'abcdef', '1': 'bc', '2': 'abdeg', '3': 'abcdg', '4': 'bcfg', '5': 'acdfg', '6': 'acdefg',
                  '7': 'abc', '8': 'abcdefg', '9': 'abcdfg', '-': 'g', ' ': '' };

    function digit(ch) {
        let inner;
        if (ch === '+') {
            inner = Object.keys(SEGS).map(k => `<path class="off" d="${SEGS[k]}"/>`).join('') +
                '<rect class="on" x="8.5" y="9" width="3" height="15"/><rect class="on" x="4" y="15" width="12" height="3"/>';
        } else {
            const lit = MAP[ch] || '';
            inner = Object.keys(SEGS).map(k => `<path class="${lit.includes(k) ? 'on' : 'off'}" d="${SEGS[k]}"/>`).join('');
        }
        return `<svg class="dg" viewBox="0 0 22 33"><g transform="translate(3,0) skewX(-6)">${inner}</g></svg>`;
    }

    // ------------------------------------------------------- builders/helpers
    const ctr = (cx, cy, w, h) => `left:${cx - w / 2}px;top:${cy - h / 2}px;width:${w}px;height:${h}px;`;
    const lab = (t, x, y, cls = '') => `<div class="lab ${cls}" style="left:${x}px;top:${y}px">${t}</div>`;
    const btn = (id, label, cx, cy, w = 66, h = 66, cls = '') =>

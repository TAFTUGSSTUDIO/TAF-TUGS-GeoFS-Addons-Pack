    const disp = (id, cx, cy, w, h, cls = '') => `<div class="disp ${cls}" id="${id}" style="${ctr(cx, cy, w, h)}"></div>`;
    const knob = (id, cx, cy, d, svg) => `<div class="knob" id="${id}" style="${ctr(cx, cy, d, d)}">${svg}</div>`;
    const rbtn = (id, cx, cy, d = 44) => `<div class="rbtn" id="${id}" style="${ctr(cx, cy, d, d)}"></div>`;
    const vsw = (cx, cy, w, h) =>

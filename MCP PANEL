    // lit round scope of the Tu-144 (cream map screen); compass ring turns with heading
    function scopeHTML(cx, cy, d) {
        let t = '';
        for (let a = 0; a < 360; a += 5) {
            const long = a % 30 === 0, r0 = long ? 124 : 132, r1 = 142;
            const sn = Math.sin(a * Math.PI / 180), cs = Math.cos(a * Math.PI / 180);
            t += `<path d="M${(r0 * sn).toFixed(1)},${(-r0 * cs).toFixed(1)} L${(r1 * sn).toFixed(1)},${(-r1 * cs).toFixed(1)}" stroke="#2a2a22" stroke-width="${long ? 2.4 : 1.2}"/>`;
            if (long) t += `<text x="${(108 * sn).toFixed(1)}" y="${(-108 * cs + 5).toFixed(1)}" text-anchor="middle" font-family="Arial" font-weight="bold" font-size="14" fill="#2a2a22" transform="rotate(${a} ${(108 * sn).toFixed(1)} ${(-108 * cs).toFixed(1)})">${a / 10}</text>`;
        }
        return `<div class="scope on" id="tu-scope" style="${ctr(cx, cy, d, d)}"><svg viewBox="-160 -160 320 320" width="${d}" height="${d}">
            <defs><radialGradient id="scopeGlow"><stop offset="0" stop-color="rgba(255,255,220,.35)"/><stop offset=".7" stop-color="rgba(255,255,200,0)"/><stop offset="1" stop-color="rgba(120,90,0,.25)"/></radialGradient></defs>
            <circle r="158" fill="#0c0d0e"/>
            <circle class="face" r="146"/>
            <circle r="146" fill="none" stroke="rgba(0,0,0,.25)" stroke-width="3"/>
            <circle r="48" fill="none" stroke="rgba(60,50,10,.28)" stroke-dasharray="4 5"/>
            <circle r="96" fill="none" stroke="rgba(60,50,10,.28)" stroke-dasharray="4 5"/>
            <g id="scope-ring">${t}</g>
            <path d="M0,-146 V0" stroke="#1d1f21" stroke-width="3"/>
            <path d="M0,-18 L9,10 L0,5 L-9,10Z" fill="#1d1f21"/>
            <circle class="glow" r="146"/></svg></div>
        `;
    }

    let scopeAng = 0;
    function updateScope() {
        const g = $('scope-ring');
        if (!g) return;
        const h = getPlaneHeading();
        if (h === null) return;
        const delta = ((-h - scopeAng + 540) % 360 + 360) % 360 - 180;
        scopeAng += delta;
        g.style.transform = `rotate(${scopeAng}deg)`;
    }


    const dialIds = { ias: ['dial-ias'], hdg: ['dial-hdg', 'dial-hdg2'], alt: ['dial-alt'], crs: ['dial-crsL', 'dial-crsR'] };
    const isDrum = () => !!curTheme && curTheme.dtype === 'drum';

    function fmt(p) {
        const v = values[p];
        switch (p) {
            case 'ias': return String(Math.round(v)).padStart(layout.iasW, (layout.name === 'tu144' && isDrum()) ? '0' : ' ').slice(-layout.iasW);
            case 'hdg':
            case 'crs': return String(v).padStart(3, '0');
            case 'alt': return String(v).padStart(5, isDrum() ? '0' : ' ').slice(-5);
            case 'vs':
                if (layout.vsStyle === 'blank') return v === 0 ? '     ' : (v < 0 ? '-' : ' ') + String(Math.abs(v)).padStart(4, ' ');
                return (v < 0 ? '-' : '+') + String(Math.abs(v)).padStart(4, '0');
        }
        return '';
    }

    function renderDisp(p) {
        const t = fmt(p), gdrum = isDrum();
        (dispIds[p] || []).forEach(id => {
            const e = $(id);
            if (!e) return;
            const drum = gdrum && !e.classList.contains('led');
            const key = (drum ? 'D' : 'L') + t;
            if (e.dataset.t === key) return;
            e.dataset.t = key;
            if (layout.drum) e.classList.toggle('drum', drum);
            e.innerHTML = (drum && layout.drum)
                ? `<div class="dr">${[...t].map(c => `<span>${c === ' ' ? '' : c}</span>`).join('')}</div>`
                : [...t].map(digit).join('');
        });
    }

    function updateDisplay(p, diff = 0) {
        renderDisp(p);
        rot[p] += diff / STEP[p] * 12;
        if (p === 'vs') {
            const w = $('vs-wheel');
            if (w) w.style.backgroundPositionY = (-rot.vs / 3) + 'px';
            const g = $('dial-vs');
            if (g) g.style.transform = `rotate(${rot.vs}deg)`;
        } else {
            (dialIds[p] || []).forEach(id => {
                const g = $(id);
                if (g) g.style.transform = `rotate(${rot[p]}deg)`;
            });
        }
    }

    function setBank(i, user) {
        if (!layout.banks) return;
        bankIdx = Math.min(layout.banks.length - 1, Math.max(0, i));
        if (user) bankTouched = true;
        const g = $('dial-bank');
        if (g) g.style.transform = `rotate(${layout.bankAngles[bankIdx]}deg)`;
        const k = $('wrap-hdg');
        if (k) k.title = 'Bank limit: ' + (layout.banks[bankIdx] === null ? 'AUTO' : layout.banks[bankIdx] + '°') +
            '  (click the outer ring, shift+wheel or right-click to change)';
        applyBankLimit();
    }

    function changeValue(param, amount) {
        if (param === 'hdg' && lnav.on) stopLNAV();
        if (param === 'vs' && flch.on) stopFLCH(false);
        const oldVal = values[param];
        let val = oldVal + amount;
        if (param === 'ias') val = Math.max(val, 0);
        else if (param === 'hdg' || param === 'crs') val = (val % 360 + 360) % 360;
        else if (param === 'vs') val = Math.min(Math.max(val, -6000), 6000);
        else if (param === 'alt') val = Math.min(Math.max(val, 0), 60000);

        let diff = val - oldVal;
        if (param === 'hdg' || param === 'crs') {
            if (diff > 180) diff -= 360;
            if (diff < -180) diff += 360;
        }
        values[param] = val;
        lastInteractionTime[param] = Date.now();
        updateDisplay(param, diff);
        if (param !== 'crs') pushValuesToGeoFS();
    }

    // ------------------------------------------------------------ OPTIONS
    const OPT = { hideInop: false };
    try { OPT.hideInop = localStorage.getItem('geofs-mcp-hide-inop') === '1'; } catch (e) {}

    function updateTabText() {
        tab.textContent = '🎛️ MCP PANEL' + (OPT.hideInop ? ' · active buttons only' : '');
    }

    // ---------------------------------------------------------- BANK LIMIT
    let bankTouched = false, bankDef = null, bankOrig = null;
    function applyBankLimit() {
        if (!bankTouched || !layout.banks) return;
        try {
            if (typeof geofs === 'undefined' || !geofs.autopilot) return;
            const def = geofs.autopilot.definition;
            if (!def || typeof def.maxBankAngle !== 'number') return;
            if (bankDef !== def) { bankDef = def; bankOrig = def.maxBankAngle; }
            const deg = layout.banks[bankIdx];
            const want = (deg === null || deg === undefined) ? bankOrig : deg;
            if (def.maxBankAngle !== want) def.maxBankAngle = want;
        } catch (e) {}
    }

    // ------------------------------------- real functions for some buttons
    const flch = { on: false }, lnav = { on: false, idx: 0 };
    const FLCH_IDS = ['btn-lvlchg', 'btn-flch'], LNAV_IDS = ['btn-lnav', 'btn-nav'];
    const apOn = () => !!(typeof geofs !== 'undefined' && geofs.autopilot && geofs.autopilot.on);
    const apModes = () => (typeof geofs !== 'undefined' && geofs.autopilot && geofs.autopilot.modes) || {};

    function getAltFt() {
        try {
            const v = geofs.animation.values;
            if (typeof v.altitude === 'number') return v.altitude;
            const l = geofs.aircraft.instance.llaLocation;
            if (l) return l[2] * 3.28084;
        } catch (e) {}
        return null;
    }

    function ownPos() {
        try {
            const l = geofs.aircraft.instance.llaLocation;
            if (l && isFinite(l[0]) && isFinite(l[1])) return { lat: l[0], lon: l[1] };
        } catch (e) {}
        return null;
    }
    function fpWaypoints() {
        try {
            const fp = geofs.flightPlan;
            const a = fp && (fp.waypointArray || fp.waypoints);
            return Array.isArray(a) ? a.filter(w => w && isFinite(w.lat) && isFinite(w.lon)) : [];
        } catch (e) { return []; }
    }
    const rad = d => d * Math.PI / 180;
    function distNm(a, b) {
        const dLat = rad(b.lat - a.lat), dLon = rad(b.lon - a.lon);
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
        return 2 * 3440.065 * Math.asin(Math.min(1, Math.sqrt(h)));
    }
    function bearingDeg(a, b) {
        const dLon = rad(b.lon - a.lon);
        const y = Math.sin(dLon) * Math.cos(rad(b.lat));
        const x = Math.cos(rad(a.lat)) * Math.sin(rad(b.lat)) - Math.sin(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.cos(dLon);
        return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
    }

    function setVal(key, val) {
        let diff = val - values[key];
        if (key === 'hdg') { if (diff > 180) diff -= 360; if (diff < -180) diff += 360; }
        values[key] = val;
        lastInteractionTime[key] = Date.now();
        updateDisplay(key, diff);
    }
    function flashBad(ids) {
        ids.forEach(id => {
            const e = document.getElementById(id);
            if (!e) return;
            e.style.outline = '3px solid #ff4a3d';
            setTimeout(() => { e.style.outline = ''; }, 700);
        });
    }
    function syncRealLamps() {
        FLCH_IDS.forEach(id => setOn(id, flch.on));
        LNAV_IDS.forEach(id => setOn(id, lnav.on));
    }

    // FLCH / LVL CHG
    function toggleFLCH() {
        if (flch.on) { stopFLCH(false); return; }
        const alt = getAltFt();
        if (alt === null || typeof geofs === 'undefined' || !geofs.autopilot) { flashBad(FLCH_IDS); return; }
        flch.on = true;
        if (!apModes().verticalSpeed) toggleGeoFSMode('verticalSpeed');
        syncRealLamps();
        flchStep();
    }
    function flchStep() {
        const alt = getAltFt();
        if (alt === null) return;
        const diff = values.alt - alt;
        if (Math.abs(diff) <= 150) { stopFLCH(true); return; }
        const rate = Math.min(diff > 0 ? 2500 : 2000, Math.max(500, Math.abs(diff) * 0.8));
        const vs = Math.sign(diff) * Math.round(rate / 100) * 100;
        if (values.vs !== vs) {
            setVal('vs', vs);
            pushValuesToGeoFS();
            try { if (typeof geofs.autopilot.setClimbrate === 'function') geofs.autopilot.setClimbrate(vs); } catch (e) {}
        } else {
            lastInteractionTime.vs = Date.now();
        }
    }
    function stopFLCH(captured) {
        if (!flch.on) return;
        flch.on = false;
        if (apOn()) {
            if (apModes().verticalSpeed) toggleGeoFSMode('verticalSpeed');
            if (captured && !apModes().altitude) toggleGeoFSMode('altitude');
        }
        syncRealLamps();
    }

    // L NAV / NAV
    function toggleLNAV() {
        if (lnav.on) { stopLNAV(); return; }
        const wps = fpWaypoints(), pos = ownPos();
        if (!wps.length || !pos || typeof geofs === 'undefined' || !geofs.autopilot) { flashBad(LNAV_IDS); return; }
        let best = 0, bd = Infinity;
        wps.forEach((w, i) => { const d = distNm(pos, w); if (d < bd) { bd = d; best = i; } });
        lnav.idx = bd < 1.5 ? best + 1 : best;
        lnav.on = true;
        if (!apModes().heading) toggleGeoFSMode('heading');
        syncRealLamps();
        lnavStep();
    }
    function lnavStep() {
        const wps = fpWaypoints(), pos = ownPos();
        const wp = wps[lnav.idx];
        if (!wp || !pos) { stopLNAV(); return; }
        if (distNm(pos, wp) < 1.2) { lnav.idx++; return; }
        const hdg = Math.round(bearingDeg(pos, wp)) % 360;
        if (values.hdg !== hdg) { setVal('hdg', hdg); pushValuesToGeoFS(); }
        else lastInteractionTime.hdg = Date.now();
    }
    function stopLNAV() {
        if (!lnav.on) return;
        lnav.on = false;
        syncRealLamps();
    }
    function navTick() {
        if (!flch.on && !lnav.on) return;
        if (!apOn()) { flch.on = false; lnav.on = false; syncRealLamps(); return; }
        if (flch.on) flchStep();
        if (lnav.on) lnavStep();
    }

    // SPD INTV / ALT INTV
    function toggleIntv(kind) {
        if (kind === 'spd') { STEP.ias = STEP.ias === 1 ? 10 : 1; setOn('btn-spdintv', STEP.ias > 1); }
        else { STEP.alt = STEP.alt === 100 ? 1000 : 100; setOn('btn-altintv', STEP.alt > 100); }
    }

    const INOP = ['btn-n1', 'btn-vnav', 'btn-vorloc', 'btn-app', 'btn-loc', 'btn-cwsa', 'btn-cwsb', 'btn-thr', 'btn-exped',
                  'btn-machhold', 'btn-iasacq', 'btn-ins', 'btn-trkhdg', 'btn-backbeam', 'btn-turb', 'btn-pitchhold',
                  'btn-goaround', 'btn-land', 'btn-mach2', 'btn-maxclimb', 'btn-ias2', 'btn-glide', 'btn-maxcruise',
                  'btn-altacq', 'btn-at2', 'btn-co', 'btn-sel', 'btn-spdmach', 'btn-hdgtrk', 'btn-metric', 'btn-truemag'];

    // ---- interaction
    const wheelMap = {};
    let dragState = null, holdTimer = null;
    window.addEventListener('mousemove', e => {
        if (!dragState) return;
        dragState.acc += dragState.startY - e.clientY;
        dragState.startY = e.clientY;
        if (Math.abs(dragState.acc) >= 8) {
            const raw = Math.trunc(dragState.acc / 8);
            const mult = Math.min(Math.max(Math.abs(raw), 1), 5);
            changeValue(dragState.param, raw > 0 ? dragState.base * mult : -dragState.base * mult);
            dragState.acc %= 8;
        }
    });
    window.addEventListener('mouseup', () => {
        dragState = null;
        if (holdTimer) { clearInterval(holdTimer); holdTimer = null; }
        const d = $('btn-disengage');
        if (d) d.classList.remove('press');
    });

    // MOUSE WHEEL over any knob / display / V-S wheel
    window.addEventListener('wheel', e => {
        if (e.altKey) {                     // Alt + wheel over the panel = resize
            if (container.style.display === 'block' && e.target.closest && e.target.closest('#geofs-mcp-container')) {
                scaleMul = Math.min(1.6, Math.max(0.5, scaleMul + (e.deltaY < 0 ? 0.05 : -0.05)));
                updateSize();
                e.preventDefault();
                e.stopImmediatePropagation();
            }
            return;
        }
        const t = e.target;
        if (!t || !t.closest) return;
        const el = t.closest('.knob,.disp,.vsw');
        if (!el || !container.contains(el)) return;
        const param = wheelMap[el.id];
        if (!param) return;
        const up = e.deltaY < 0;
        if (param === 'hdg' && e.shiftKey && layout.banks) setBank(bankIdx + (up ? 1 : -1), true);
        else changeValue(param, up ? STEP[param] : -STEP[param]);
        e.preventDefault();
        e.stopImmediatePropagation();
    }, { passive: false, capture: true });

    function makeInteractive(id, param, mode) {
        const el = $(id);
        if (!el) return;
        wheelMap[id] = param;
        el.addEventListener('mousedown', e => {
            if (e.button === 1) { // middle click = toggle the related autopilot mode
                if (modeOf[param]) toggleGeoFSMode(modeOf[param]);
                e.preventDefault(); e.stopPropagation();
                return;
            }
            if (e.button !== 0) return;
            if (mode === 'hold') {
                const r = el.getBoundingClientRect();
                const dir = (e.clientX - r.left) > r.width / 2 ? 1 : -1;
                if (!holdTimer) {
                    changeValue(param, dir * STEP[param]);
                    holdTimer = setInterval(() => changeValue(param, dir * STEP[param]), 120);
                }
            } else {
                dragState = { param, base: STEP[param], startY: e.clientY, acc: 0 };
            }
            e.stopPropagation();
            e.preventDefault();
        });
    }

    // ---------------------------------------------------------- GeoFS bridge
    const domSelectors = {
        ias: ['#autopilotSpeed', 'input[data-autopilot="speed"]', '.autopilot-speed-input', '.geofs-ap-speed', '#geofs-ap-input-speed'],
        hdg: [
            '#autopilotTargetHeading', '#autopilotHeading', '.geofs-ap-targetHeading', '.geofs-ap-target-heading',
            'input[data-autopilot="targetHeading"]', 'input[data-autopilot="heading"]', 'input[data-ap="heading"]',
            '.autopilot-heading-input', '.autopilot-target-heading-input', '.geofs-ap-heading', 'input.geofs-autopilot-heading',
            '#geofs-ap-input-heading', '#geofs-ap-input-targetHeading'
        ],
        alt: ['#autopilotAltitude', 'input[data-autopilot="altitude"]', '.autopilot-altitude-input', '.geofs-ap-altitude', '#geofs-ap-input-altitude'],
        vs:  ['#autopilotVerticalSpeed', '#autopilotVS', 'input[data-autopilot="verticalSpeed"]', '.geofs-ap-vs', '#geofs-ap-input-vs']
    };

    function getPlaneHeading() {
        try {
            if (typeof geofs !== 'undefined') {
                if (geofs.animation && geofs.animation.values) {
                    if (typeof geofs.animation.values.heading360 === 'number') return geofs.animation.values.heading360;
                    if (typeof geofs.animation.values.heading === 'number') return (geofs.animation.values.heading % 360 + 360) % 360;
                }
                if (geofs.aircraft && geofs.aircraft.instance && typeof geofs.aircraft.instance.htg === 'number') {
                    return (geofs.aircraft.instance.htg % 360 + 360) % 360;
                }
            }
        } catch (e) {}
        return null;
    }

    function isAircraftStationary() {
        try {
            if (typeof geofs !== 'undefined' && geofs.animation && geofs.animation.values) {
                const kias = geofs.animation.values.kias || 0;
                const groundSpeed = geofs.animation.values.groundSpeed || 0;
                return (kias < 2 && groundSpeed < 2);
            }
        } catch (e) {}
        return false;
    }

    function pushValuesToGeoFS() {
        try {
            Object.keys(domSelectors).forEach(key => {
                const val = values[key];
                domSelectors[key].forEach(sel => {
                    document.querySelectorAll(sel).forEach(el => {
                        if ((el.tagName === 'INPUT' || typeof el.value !== 'undefined') && el.value != val) {
                            el.value = val;
                            el.dispatchEvent(new Event('input', { bubbles: true }));
                            el.dispatchEvent(new Event('change', { bubbles: true }));
                        } else if (el.tagName !== 'INPUT' && el.innerText !== undefined && el.innerText != val) {
                            el.innerText = val;
                        }
                    });
                });
            });

            document.querySelectorAll('input').forEach(input => {
                if (container.contains(input)) return;
                const parentText = (input.parentElement ? input.parentElement.innerText : '') + (input.className || '') + (input.id || '');
                if (parentText.toLowerCase().includes('hdg') || parentText.toLowerCase().includes('heading')) {
                    if (input.value != values.hdg) {
                        input.value = values.hdg;
                        input.dispatchEvent(new Event('input', { bubbles: true }));
                        input.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                }
            });

            if (typeof geofs !== 'undefined' && geofs.autopilot) {
                geofs.autopilot.speed = values.ias;
                geofs.autopilot.heading = values.hdg;
                geofs.autopilot.targetHeading = values.hdg;
                geofs.autopilot.altitude = values.alt;
                geofs.autopilot.verticalSpeed = values.vs;

                if (geofs.autopilot.values) {
                    geofs.autopilot.values.speed = values.ias;
                    geofs.autopilot.values.heading = values.hdg;
                    geofs.autopilot.values.targetHeading = values.hdg;
                    geofs.autopilot.values.altitude = values.alt;
                    geofs.autopilot.values.verticalSpeed = values.vs;
                    geofs.autopilot.values.climbRate = values.vs;
                }

                if (typeof geofs.autopilot.setTargetHeading === 'function') geofs.autopilot.setTargetHeading(values.hdg);
                if (typeof geofs.autopilot.setHeading === 'function') geofs.autopilot.setHeading(values.hdg);
                if (typeof geofs.autopilot.turnTo === 'function') geofs.autopilot.turnTo(values.hdg);
            }
        } catch (err) {
            console.warn('[GeoFS MCP] Sync notice:', err);
        }
    }

    function toggleGeoFSMode(modeName, forceState) {
        try {
            if (typeof geofs !== 'undefined' && geofs.autopilot) {
                if (!geofs.autopilot.on && forceState !== false) {
                    if (typeof geofs.autopilot.turnOn === 'function') geofs.autopilot.turnOn();
                    else geofs.autopilot.on = true;
                }

                if (typeof geofs.autopilot.setMode === 'function') {
                    geofs.autopilot.setMode(modeName);
                } else if (geofs.autopilot.modes) {
                    const currentState = !!geofs.autopilot.modes[modeName];
                    const newState = forceState !== undefined ? forceState : !currentState;
                    geofs.autopilot.modes[modeName] = newState;
                    if (modeName === 'heading') geofs.autopilot.modes['targetHeading'] = newState;
                }

                if (geofs.autopilot.modes && modeName === 'heading') {
                    geofs.autopilot.modes.heading = true;
                    geofs.autopilot.modes.targetHeading = true;
                }

                lastInteractionTime.hdg = Date.now();
                pushValuesToGeoFS();
                syncModeButtons();
            }
        } catch (err) {
            console.warn('[GeoFS MCP] Mode notice:', err);
        }
    }

    // ------------------------------------------------- buttons & indicators
    const setOn = (id, on) => { const e = $(id); if (e) e.classList.toggle('on', !!on); };

    let atShown = 180, atAnim = null;
    function animateLever(lever, target) {
        if (atAnim) cancelAnimationFrame(atAnim);
        const from = atShown, t0 = performance.now(), D = 124;
        const step = now => {
            const k = Math.min(1, (now - t0) / D);
            const e = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
            atShown = from + (target - from) * e;
            lever.style.transform = `rotate(${atShown}deg)`;
            if (k < 1) atAnim = requestAnimationFrame(step);
            else { atShown = target; lever.style.transform = `rotate(${target}deg)`; atAnim = null; }
        };
        atAnim = requestAnimationFrame(step);
    }
    function setAT(on) {
        atOn = !!on;
        const lever = $('at-lever');
        if (lever) {
            if (((atAngle % 360) + 360) % 360 !== (atOn ? 0 : 180)) atAngle += 180;
            if (lever.dataset.init) animateLever(lever, atAngle);
            else { lever.dataset.init = '1'; atShown = atAngle; lever.style.transform = `rotate(${atAngle}deg)`; }
        }
        setOn('at-led', atOn);
        setOn('atsw', atOn);
    }

    function setFD(on) {
        fdOn = !!on;
        ['fd-L', 'fd-R'].forEach(id => { const e = $(id); if (e) e.classList.toggle('off', !fdOn); });
        setOn('ma-L', fdOn);
        setOn('ma-R', fdOn);
    }

    function syncModeButtons() {
        if (typeof geofs === 'undefined' || !geofs.autopilot) return;
        const ap = geofs.autopilot;
        const modes = ap.modes || {};
        const speedOn = !!modes.speed;
        setOn('btn-speed', speedOn);
        setOn('btn-athr', speedOn);
        setOn('btn-hdgsel', modes.heading || modes.targetHeading);
        setOn('btn-hdghold', modes.heading || modes.targetHeading);
        setOn('btn-althld', modes.altitude);
        setOn('btn-vs', modes.verticalSpeed);
        setOn('btn-cmda', ap.on && apChannel === 'A');
        setOn('btn-cmdb', ap.on && apChannel === 'B');
        setOn('btn-cmdc', ap.on && apChannel === 'C');
        syncRealLamps();
        if (speedOn !== lastSpeedMode) { lastSpeedMode = speedOn; if (Date.now() >= atLockUntil) setAT(speedOn); }
    }

    function toggleAP(channel) {
        try {
            if (typeof geofs === 'undefined' || !geofs.autopilot) return;
            apChannel = channel;

            if (!geofs.autopilot.on) {
                if (typeof geofs.autopilot.turnOn === 'function') geofs.autopilot.turnOn();
                else geofs.autopilot.on = true;
            } else {
                if (typeof geofs.autopilot.turnOff === 'function') geofs.autopilot.turnOff();
                else geofs.autopilot.on = false;
            }
            pushValuesToGeoFS();
            syncModeButtons();
        } catch (err) {
            console.warn('[GeoFS MCP] Engage notice:', err);
        }
    }

    const REAL_MODES = { 'btn-speed': 'speed', 'btn-athr': 'speed', 'btn-hdgsel': 'heading', 'btn-hdghold': 'heading',
                         'btn-althld': 'altitude', 'btn-vs': 'verticalSpeed' };

    function bindControls() {
        // outer ring of the heading knob = bank limit selector
        const hk0 = $('wrap-hdg');
        if (hk0 && layout.banks) {
            hk0.addEventListener('mousedown', e => {
                if (e.button !== 0) return;
                const r = hk0.getBoundingClientRect();
                const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
                if (Math.hypot(dx, dy) / (r.width / 2) < (layout.capR || 0.5)) return;
                setBank(bankIdx + (dx > 0 ? 1 : -1), true);
                e.stopImmediatePropagation();
                e.preventDefault();
            });
        }
        [['ias', 'ias'], ['hdg', 'hdg'], ['alt', 'alt'], ['vs', 'vs']].forEach(([k, p]) => {
            makeInteractive('wrap-' + k, p, k === 'vs' && $('vs-wheel') ? 'drag' : 'hold');
            makeInteractive('disp-' + k, p, 'drag');
        });
        makeInteractive('wrap-hdg2', 'hdg', 'hold');
        makeInteractive('disp-hdg2', 'hdg', 'drag');
        makeInteractive('wrap-crsL', 'crs', 'hold');
        makeInteractive('wrap-crsR', 'crs', 'hold');
        makeInteractive('disp-crsL', 'crs', 'drag');
        makeInteractive('disp-crsR', 'crs', 'drag');

        const hk = $('wrap-hdg');
        if (hk) hk.addEventListener('contextmenu', e => {
            if (layout.banks) setBank(bankIdx >= layout.banks.length - 1 ? 0 : bankIdx + 1, true);
            e.preventDefault();
        });

        Object.keys(REAL_MODES).forEach(id => {
            const e = $(id);
            if (e) e.addEventListener('click', () => toggleGeoFSMode(REAL_MODES[id]));
        });
        const at = $('atsw');

        if (at) {
            let y0 = null;
            at.addEventListener('mousedown', e => {
                if (e.button !== 0) return;
                y0 = e.clientY;
                e.stopPropagation();
                e.preventDefault();
            });
            document.addEventListener('mouseup', e => {
                if (y0 === null) return;
                const dy = e.clientY - y0;
                y0 = null;
                const want = Math.abs(dy) > 6 ? dy < 0 : !atOn;
                if (want === atOn) return;
                setAT(want);
                atLockUntil = Date.now() + 1500;
                const geoSpeed = !!(typeof geofs !== 'undefined' && geofs.autopilot && geofs.autopilot.modes && geofs.autopilot.modes.speed);
                if (geoSpeed !== want) toggleGeoFSMode('speed');
                lastSpeedMode = !!(typeof geofs !== 'undefined' && geofs.autopilot && geofs.autopilot.modes && geofs.autopilot.modes.speed);
            }, true);
        }

        FLCH_IDS.forEach(id => { const e = $(id); if (e) e.addEventListener('click', toggleFLCH); });
        LNAV_IDS.forEach(id => { const e = $(id); if (e) e.addEventListener('click', toggleLNAV); });
        const si = $('btn-spdintv'); if (si) si.addEventListener('click', () => toggleIntv('spd'));
        const ai = $('btn-altintv'); if (ai) ai.addEventListener('click', () => toggleIntv('alt'));
        setOn('btn-spdintv', STEP.ias > 1);
        setOn('btn-altintv', STEP.alt > 100);
        const ak = $('wrap-alt');
        if (ak && $('btn-altintv') === null) ak.addEventListener('contextmenu', e => { toggleIntv('alt'); e.preventDefault(); });

        const sc = $('tu-scope');
        if (sc) { sc.title = 'Click: indicator screen on / off'; sc.addEventListener('click', () => sc.classList.toggle('on')); }
        const sy = $('btn-sync');
        if (sy) sy.addEventListener('click', () => {
            const h = getPlaneHeading();
            if (h !== null) { setVal('hdg', Math.round(h) % 360); pushValuesToGeoFS(); }
            sy.classList.add('on');
            setTimeout(() => sy.classList.remove('on'), 350);
        });

        // ---- Tu-144 extras -------------------------------------------------
        stage.querySelectorAll('.selk').forEach(el => {
            const angs = (el.dataset.angs || '0').split(',').map(Number);
            let i = Math.min(angs.length - 1, Math.max(0, parseInt(el.dataset.i, 10) || 0));
            const g = el.querySelector('.rot');
            const apply = () => {
                if (g) g.style.transform = `rotate(${angs[i]}deg)`;
                if (el.dataset.fx === 'lamp') {                       // ЛАМПА 1-4 = indicator brightness
                    const s = $('tu-scope');
                    if (s) s.style.filter = `brightness(${[0.55, 0.8, 1, 1.25][i] || 1})`;
                }
            };
            apply();
            el.addEventListener('click', () => { i = (i + 1) % angs.length; apply(); });
            el.addEventListener('contextmenu', e => { e.preventDefault(); i = (i - 1 + angs.length) % angs.length; apply(); });
        });
        stage.querySelectorAll('.tgl').forEach(el => el.addEventListener('click', () => el.classList.toggle('up')));
        stage.querySelectorAll('.free').forEach(el => el.addEventListener('click', () => el.classList.toggle('on')));
        // ВВОД advances the КАДР (frame) counter, or cycles radar range in radar mode
        const vv = $('tu-vvod'), kd = $('tu-kadr');
        if (vv && kd) {
            let n = 112;
            const draw = () => { kd.innerHTML = `<div class="dr">${String(n).padStart(3, '0').split('').map(c => `<span>${c}</span>`).join('')}</div>`; };
            draw();
            vv.addEventListener('click', () => { if (radarOn) { cycleRadarRange(); return; } n = n % 999 + 1; draw(); });
        }

        const rb = $('tu-rdr');
        if (rb) rb.addEventListener('click', () => setRadar(!radarOn));
        stage.querySelectorAll('.rk').forEach(el => {
            const angs = (el.dataset.angs || '0').split(',').map(Number);
            let i = Math.min(angs.length - 1, Math.max(0, parseInt(el.dataset.i, 10) || 0));
            const g = el.querySelector('.rot');
            const apply = () => {
                if (g) g.style.transform = `rotate(${angs[i]}deg)`;
                switch (el.id) {
                    case 'rk-mode': rlsState.mode = i; applyRls(); break;
                    case 'rk-bright': rlsState.bright = i; applyRls(); break;
                    case 'rk-contr': rlsState.contr = i; applyRls(); break;
                    case 'rk-marks': rlsState.marks = i; applyRls(); break;
                    case 'rk-range': radarRangeIdx = 4 - i; updateRadarRange(); updateRadar(); break;
                }
            };
            apply();
            const step = d => { i = (i + d + angs.length) % angs.length; apply(); };
            el.addEventListener('click', () => step(1));
            el.addEventListener('contextmenu', e => { e.preventDefault(); step(-1); });
            el.addEventListener('wheel', e => { e.preventDefault(); e.stopPropagation(); step(e.deltaY < 0 ? 1 : -1); }, { passive: false });
        });
        const pw = $('tu-podsvet');
        if (pw) {
            pw.addEventListener('wheel', e => {
                e.preventDefault(); e.stopPropagation();
                podsvet = Math.max(0, Math.min(10, podsvet + (e.deltaY < 0 ? 1 : -1))); applyPodsvet();
            }, { passive: false });
            pw.addEventListener('mousedown', e => { if (e.button !== 0) return; podDrag = { y: e.clientY, acc: 0 }; e.preventDefault(); e.stopPropagation(); });
        }
        applyPodsvet();
        const ip = $('tu-ipo');
        if (ip) ip.addEventListener('mousedown', e => {
            if (e.button !== 0) return;
            const r = ip.getBoundingClientRect(), x = e.clientX - (r.left + r.width / 2), y = e.clientY - (r.top + r.height / 2);
            e.preventDefault(); e.stopPropagation();
            if (Math.hypot(x, y) < r.width * 0.16) { mapX = 0; mapY = 0; applyMapPan(); return; }
            const dx = Math.abs(x) > Math.abs(y) ? (x > 0 ? 1 : -1) : 0, dy = dx ? 0 : (y > 0 ? 1 : -1);
            ipoMove(dx, dy);
            if (!holdTimer) holdTimer = setInterval(() => ipoMove(dx, dy), 90);
        });
        applyMapPan();
        const rlsOn = $('rls-on'), rlsOff = $('rls-off');
        if (rlsOn) rlsOn.addEventListener('click', () => { if (radarOn) cycleRadarRange(); else setRadar(true); });
        if (rlsOff) rlsOff.addEventListener('click', () => setRadar(false));
        const rays = stage.querySelector('.rlsrays');
        if (rays && !rays.childNodes.length) {
            let rr = '';
            for (let a = -80; a <= 80; a += 8) rr += `<line x1="0" y1="0" x2="${(160 * Math.sin(a * Math.PI / 180)).toFixed(1)}" y2="${(-160 * Math.cos(a * Math.PI / 180)).toFixed(1)}"/>`;
            rays.innerHTML = rr;
        }
        if (rb || rlsOn) setRadar(radarOn);

        syncRealLamps();
        INOP.forEach(id => {
            const e = $(id);
            if (!e) return;
            if (OPT.hideInop) { e.style.display = 'none'; return; }
            e.classList.toggle('on', !!localLit[id]);
            e.addEventListener('click', () => { localLit[id] = !localLit[id]; e.classList.toggle('on', localLit[id]); });
        });

        [['btn-cmda', 'A'], ['btn-cmdb', 'B'], ['btn-cmdc', 'C']].forEach(([id, ch]) => {
            const e = $(id);
            if (e) e.addEventListener('click', () => toggleAP(ch));
        });

        const dis = $('btn-disengage');
        if (dis) {
            dis.addEventListener('mousedown', () => dis.classList.add('press'));
            dis.addEventListener('click', () => {
                try {
                    if (typeof geofs !== 'undefined' && geofs.autopilot && geofs.autopilot.on) {
                        if (typeof geofs.autopilot.turnOff === 'function') geofs.autopilot.turnOff();
                        else geofs.autopilot.on = false;
                    }
                } catch (err) {}
                stopFLCH(false);
                stopLNAV();
                INOP.forEach(id => { localLit[id] = false; setOn(id, false); });
                dis.classList.add('alert');
                setTimeout(() => dis.classList.remove('alert'), 1200);
                syncModeButtons();
            });
        }

        ['fd-L', 'fd-R'].forEach(id => {
            const e = $(id);
            if (e) e.addEventListener('click', () => setFD(!fdOn));
        });
    }

    // ----------------------------------------------------- layout switching
    function buildLayout(name) {
        layout = LAYOUTS[name] || LAYOUTS.b737;
        W = layout.W; H = layout.H;
        stage.style.width = W + 'px';
        stage.style.height = H + 'px';
        stage.innerHTML = layout.build();
        updateSize();
        bindControls();
        ['ias', 'hdg', 'vs', 'alt', 'crs'].forEach(p => updateDisplay(p, 0));
        bankTouched = false;
        bankIdx = layout.bankDefault || 0;
        setBank(bankIdx);
        setAT(atOn);
        setFD(fdOn);
        syncModeButtons();
    }

    function applyTheme(t) {
        const need = !curTheme || curTheme.layout !== t.layout || curTheme.dtype !== t.dtype;
        curTheme = t;
        const vars = { '--bg': t.bg, '--border': t.border, '--txt': t.txt, '--disp': t.disp, '--face': t.face, '--k1': t.k1, '--k2': t.k2 };
        Object.keys(vars).forEach(k => {
            container.style.setProperty(k, vars[k]);
            tab.style.setProperty(k, vars[k]);
        });
        if (need) buildLayout(t.layout);
    }

    let currentAircraftId = null;
    function updateAircraftTheme() {
        try {
            if (typeof geofs === 'undefined' || !geofs.aircraft || !geofs.aircraft.instance) return;
            const inst = geofs.aircraft.instance;
            const acId = inst.id;
            const acName = ((inst.aircraftRecord && inst.aircraftRecord.name) || inst.name || '').toLowerCase();
            if (acId === currentAircraftId) return;
            currentAircraftId = acId;
            let theme = THEMES.DEFAULT;
            for (const [regex, key] of THEME_RULES) {
                if (regex.test(acName)) { theme = THEMES[key]; break; }
            }
            applyTheme(theme);
        } catch (e) {
            console.warn('[GeoFS MCP] Theme update error:', e);
        }
    }

    // ------------------------------------------------------- pull from GeoFS
    function updateMach() {
        const e = $('disp-mach');
        if (!e) return;
        let m = 0;
        try {
            if (typeof geofs !== 'undefined' && geofs.animation && geofs.animation.values) m = Number(geofs.animation.values.mach) || 0;
        } catch (err) {}
        const t = m.toFixed(2).slice(0, 4);
        const key = 'M' + t;
        if (e.dataset.t === key) return;
        e.dataset.t = key;
        e.classList.add('drum');
        e.innerHTML = `<div class="dr">${[...t].map(c => `<span${c === '.' ? ' class="dot"' : ''}>${c}</span>`).join('')}</div>`;
    }

    function pullFromNativeUI() {
        const now = Date.now();
        updateAircraftTheme();
        updateMach();
        navTick();
        applyBankLimit();
        updateScope();
        updateGauges();

        try {
            if (typeof geofs !== 'undefined' && geofs.autopilot) {
                const ap = geofs.autopilot;
                const sourceVals = ap.values || ap;
                const isHdgActive = !!(ap.modes && (ap.modes.heading || ap.modes.targetHeading));
                const planeHdg = getPlaneHeading();
                const stationary = isAircraftStationary();

                const nativeIas = sourceVals.speed;
                let nativeHdg;
                if (stationary || !isHdgActive) {
                    nativeHdg = (planeHdg !== null && planeHdg !== undefined)
                        ? planeHdg
                        : (sourceVals.targetHeading !== undefined ? sourceVals.targetHeading : ap.targetHeading);
                } else {
                    nativeHdg = (sourceVals.targetHeading !== undefined ? sourceVals.targetHeading : (sourceVals.heading !== undefined ? sourceVals.heading : ap.targetHeading));
                }
                const nativeAlt = sourceVals.altitude;
                const nativeVs = sourceVals.verticalSpeed !== undefined ? sourceVals.verticalSpeed : sourceVals.climbRate;

                const map = { ias: nativeIas, hdg: nativeHdg, alt: nativeAlt, vs: nativeVs };
                Object.keys(map).forEach(key => {
                    if (now - (lastInteractionTime[key] || 0) < 1000) return;
                    const nativeVal = map[key];
                    if (nativeVal !== undefined && nativeVal !== null && !isNaN(parseFloat(nativeVal))) {
                        let rounded = Math.round(parseFloat(nativeVal));
                        if (key === 'hdg') rounded = (rounded % 360 + 360) % 360;
                        if (rounded !== values[key]) {
                            let diff = rounded - values[key];
                            if (key === 'hdg') {
                                if (diff > 180) diff -= 360;
                                if (diff < -180) diff += 360;
                            }
                            values[key] = rounded;
                            updateDisplay(key, diff);
                        }
                    }
                });
                syncModeButtons();
            }
        } catch (err) {
            console.warn('[GeoFS MCP] Pull notice:', err);
        }
    }

    // ------------------------------------------------------------------ init
    updateTabText();
    applyTheme(THEMES.DEFAULT);
    setInterval(pullFromNativeUI, 200);
    setTimeout(() => {
        pullFromNativeUI();
        ['ias', 'hdg', 'vs', 'alt', 'crs'].forEach(p => updateDisplay(p, 0));
    }, 1500);
})();

    // ---- Tu-144 radar mode: shows other GeoFS multiplayer aircraft around you (track-up),
    // plus airport ground data (runways, taxiways, aprons, stands) from Immersive Airports
    // when that script is installed and has an airport loaded.
    // Blip label = altitude difference in hundreds of feet; red = within 1000 ft of you.
    // In radar mode the ВВОД button cycles the range.
    const RADAR_RANGES = [30, 50, 125, 250, 375];   // km (matches the range knob scale)
    let radarOn = false, radarRangeIdx = 2;
    let podsvet = 10, mapX = 0, mapY = 0, podDrag = null;
    function applyPodsvet() {
        const w = $('tu-podsvet');
        stage.style.filter = w ? `brightness(${(0.55 + 0.045 * podsvet).toFixed(2)})` : '';
        const rib = w && w.querySelector('.rib');
        if (rib) rib.style.backgroundPositionY = (podsvet * 11) + 'px';
    }
    function applyMapPan() {
        const m = $('scope-map');
        if (m) m.setAttribute('transform', `translate(${mapX.toFixed(1)},${mapY.toFixed(1)})`);
    }
    function ipoMove(dx, dy) {          // screen direction (-1/0/1); the map slides the opposite way
        const th = (typeof scopeAng === 'number' ? scopeAng : 0) * Math.PI / 180, st = 6;
        const sx = -dx * st, sy = -dy * st;
        mapX = Math.max(-110, Math.min(110, mapX + Math.cos(th) * sx + Math.sin(th) * sy));
        mapY = Math.max(-110, Math.min(110, mapY - Math.sin(th) * sx + Math.cos(th) * sy));
        applyMapPan();
    }
    window.addEventListener('mousemove', e => {
        if (!podDrag) return;
        podDrag.acc += podDrag.y - e.clientY; podDrag.y = e.clientY;
        while (Math.abs(podDrag.acc) >= 7) {
            const d = podDrag.acc > 0 ? 1 : -1;
            podsvet = Math.max(0, Math.min(10, podsvet + d)); podDrag.acc -= d * 7; applyPodsvet();
        }
    });
    window.addEventListener('mouseup', () => { podDrag = null; });
    const rlsState = { mode: 1, bright: 3, contr: 3, marks: 1 };   // mode: 0 ГОТОВ, 1 ЗЕМЛЯ, 2 МЕТЕО, 3 КОНТУР
    function rotateRk(id, i) {
        const el = $(id); if (!el) return;
        const angs = (el.dataset.angs || '0').split(',').map(Number);
        const g = el.querySelector('.rot');
        if (g) g.style.transform = `rotate(${angs[i]}deg)`;
    }
    function applyRls() {
        const scr = $('rls-screen');
        if (scr) scr.style.filter = `brightness(${[0.45, 0.7, 1, 1.25, 1.5][rlsState.bright]}) contrast(${[0.6, 0.8, 1, 1.25, 1.5][rlsState.contr]})`;
        const rg = $('rls-rings');
        if (rg) rg.style.opacity = [0, 0.5, 1][rlsState.marks];
        updateRadar();
    }
    function updateRadarRange() {
        const t = $('radar-range');
        if (t) t.textContent = RADAR_RANGES[radarRangeIdx] + ' км';
    }
    function setRadar(on) {
        radarOn = !!on;
        const sc = $('tu-scope');
        if (sc) sc.classList.toggle('radar', radarOn);
        setOn('tu-rdr', radarOn);
        const ru = $('tu-rlsunit'); if (ru) ru.classList.toggle('on', radarOn);
        const rbOn = $('rls-on'); if (rbOn) rbOn.classList.toggle('act', radarOn);
        const k = $('tu-kadr');
        if (k) k.style.opacity = radarOn ? '.35' : '1';
        updateRadarRange();
        if (radarOn) updateRadar();
    }
    function cycleRadarRange() {
        radarRangeIdx = (radarRangeIdx + 1) % RADAR_RANGES.length;
        rotateRk('rk-range', 4 - radarRangeIdx);
        updateRadarRange();
        updateRadar();
    }
    function radarTraffic() {
        const out = [];
        try {
            const mp = window.multiplayer || (window.geofs && geofs.multiplayer);
            const src = mp && (mp.visibleUsers || mp.users);
            if (!src) return out;
            const list = Array.isArray(src) ? src : Object.values(src);
            const myId = window.geofs && geofs.userRecord ? geofs.userRecord.id : undefined;
            for (const u of list) {
                if (!u || (myId !== undefined && u.id === myId)) continue;
                let lat, lon, alt, hdg;
                const co = u.lastUpdate && u.lastUpdate.co;
                if (Array.isArray(co)) { lat = co[0]; lon = co[1]; alt = co[2]; hdg = co[3]; }
                else if (u.referencePoint) { lat = u.referencePoint.lat; lon = u.referencePoint.lon; alt = u.referencePoint.alt; }
                else if (Array.isArray(u.llaLocation)) { lat = u.llaLocation[0]; lon = u.llaLocation[1]; alt = u.llaLocation[2]; }
                lat = Number(lat); lon = Number(lon);
                if (!isFinite(lat) || !isFinite(lon)) continue;
                out.push({ lat: lat, lon: lon, altFt: (Number(alt) || 0) * 3.28084, hdg: isFinite(Number(hdg)) ? Number(hdg) : null,
                           cs: String(u.callsign || u.name || '').slice(0, 8).replace(/[<>&]/g, '') });
            }
        } catch (e) {}
        return out;
    }

    // Airport ground layer, read from Immersive Airports (window.IA_DATA.state)
    function radarAirport(me, hdg, rangeM, R) {
        const IA = window.IA_DATA, st = IA && IA.state;
        if (!st) return '';
        const k = R / rangeM, h = hdg * Math.PI / 180, cH = Math.cos(h), sH = Math.sin(h);
        const lonScale = 111320 * Math.max(.15, Math.cos(me.lat * Math.PI / 180));
        const proj = p => {
            const e = (p.lon - me.lon) * lonScale, n = (p.lat - me.lat) * 111320;
            return [(e * cH - n * sH) * k, -(e * sH + n * cH) * k];
        };
        const lim = R * 1.6;
        let budget = 2500;
        const path = (map, close) => {
            let d = '';
            if (!map) return d;
            for (const f of map.values()) {
                const pts = f.points;
                if (!pts || pts.length < 2 || budget <= 0) continue;
                const xy = pts.map(proj);
                if (!xy.some(q => Math.abs(q[0]) < lim && Math.abs(q[1]) < lim)) continue;
                budget -= xy.length;
                d += 'M' + xy.map(q => q[0].toFixed(1) + ',' + q[1].toFixed(1)).join('L') + (close ? 'Z' : '');
            }
            return d;
        };
        let out = '';
        const ap = path(st.aprons, true);
        if (ap) out += `<path d="${ap}" fill="rgba(140,150,150,.22)" stroke="none"/>`;
        const tl = path(st.taxilanes);
        if (tl) out += `<path d="${tl}" fill="none" stroke="#8c7c30" stroke-width=".7" stroke-linejoin="round"/>`;
        const tw = path(st.taxiways);
        if (tw) out += `<path d="${tw}" fill="none" stroke="#f1c918" stroke-width="1.1" stroke-linejoin="round"/>`;
        const rw = path(st.runways);
        if (rw) out += `<path d="${rw}" fill="none" stroke="#e8e8e0" stroke-width="3.2" stroke-linecap="butt"/>`;
        if (st.runways) for (const f of st.runways.values()) {
            const pts = f.points;
            if (!pts || pts.length < 2 || !f.ref) continue;
            const q = proj(pts[Math.floor(pts.length / 2)]);
            if (Math.abs(q[0]) > R || Math.abs(q[1]) > R) continue;
            out += `<text x="${q[0].toFixed(1)}" y="${(q[1] + 3).toFixed(1)}" text-anchor="middle" font-size="8" font-weight="bold" font-family="Arial" fill="#7dff8f" stroke="#08210f" stroke-width=".4">${String(f.ref).replace(/[<>&]/g, '')}</text>`;
        }
        if (st.parking) for (const f of st.parking.values()) {
            const p = f.point || (f.points && f.points[f.points.length - 1]);
            if (!p) continue;
            const q = proj(p);
            if (Math.abs(q[0]) > R || Math.abs(q[1]) > R) continue;
            out += `<circle cx="${q[0].toFixed(1)}" cy="${q[1].toFixed(1)}" r="1.3" fill="#ffd21a"/>`;
        }
        return out;
    }

    function updateRadar() {
        const g = $('radar-blips'), a = $('radar-ap');
        if (!g) return;
        const me = ownPos(), hdg = getPlaneHeading();
        if (!me || hdg === null) { g.innerHTML = ''; if (a) a.innerHTML = ''; const x1 = $('rls-ap'), x2 = $('rls-blips'); if (x1) x1.innerHTML = ''; if (x2) x2.innerHTML = ''; return; }
        const rangeM = RADAR_RANGES[radarRangeIdx] * 1000, R = 120, myAlt = getAltFt() || 0;
        const showAp = rlsState.mode === 1 || rlsState.mode === 3, showTr = rlsState.mode === 1 || rlsState.mode === 2;
        const apSvg = showAp ? radarAirport(me, hdg, rangeM, R) : '';
        if (a) a.innerHTML = apSvg;
        const ra = $('rls-ap'); if (ra) ra.innerHTML = apSvg;
        let svg = '';
        for (const t of (showTr ? radarTraffic() : []).slice(0, 80)) {
            const d = distNm(me, t) * 1852;
            if (d > rangeM) continue;
            const rel = (bearingDeg(me, t) - hdg) * Math.PI / 180;
            const r = d / rangeM * R, x = r * Math.sin(rel), y = -r * Math.cos(rel);
            const dA = Math.round((t.altFt - myAlt) / 100);
            const col = Math.abs(dA) < 10 ? '#ff5a4a' : '#7dff8f';
            const lbl = (dA >= 0 ? '+' : '-') + String(Math.abs(dA)).padStart(2, '0');
            let vec = '';
            if (t.hdg !== null) {
                const hh = (t.hdg - hdg) * Math.PI / 180;
                vec = `<line x1="${x.toFixed(1)}" y1="${y.toFixed(1)}" x2="${(x + 10 * Math.sin(hh)).toFixed(1)}" y2="${(y - 10 * Math.cos(hh)).toFixed(1)}" stroke="${col}" stroke-width="1.3"/>`;
            }
            svg += `${vec}<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="3.2" fill="${col}"/>` +
                   `<text x="${(x + 6).toFixed(1)}" y="${(y - 3).toFixed(1)}" font-size="8" font-family="Arial" font-weight="bold" fill="${col}">${t.cs}</text>` +
                   `<text x="${(x + 6).toFixed(1)}" y="${(y + 6).toFixed(1)}" font-size="8" font-family="Arial" fill="${col}">${lbl}</text>`;
        }
        g.innerHTML = svg;
        const rb2 = $('rls-blips'); if (rb2) rb2.innerHTML = svg;
    }


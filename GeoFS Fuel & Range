  // Typical mean jet-stream headwind (+ = headwind, - = tailwind). Rough planning estimate, not a forecast.
  function bearing(a, b) {
    const rad = Math.PI / 180, dLon = (b[1] - a[1]) * rad;
    const y = Math.sin(dLon) * Math.cos(b[0] * rad);
    const x = Math.cos(a[0] * rad) * Math.sin(b[0] * rad) - Math.sin(a[0] * rad) * Math.cos(b[0] * rad) * Math.cos(dLon);
    return Math.atan2(y, x);
  }
  function autoWind(a, b) {
    const lat = Math.abs((a[0] + b[0]) / 2);
    if (lat < 25 || lat > 70) return 0;
    const eastness = (Math.sin(bearing(a, b)) + Math.sin(bearing(b, a) + Math.PI)) / 2;   // +1 eastbound, -1 westbound
    const u = 40 * Math.min(1, (lat - 25) / 15) * (lat > 60 ? 0.7 : 1);                 // mean westerly, kt
    const scale = F.speed > 700 ? 0.2 : F.speed < 250 ? 0.3 : 1;                         // supersonic flies above the jet stream; light aircraft lower
    const w = -u * eastness * scale;
    return Math.round(w > 0 ? w : w * 0.5);                                             // only half credit for tailwinds (conservative)
  }

  function resolve(str, allowBlankAsHere) {

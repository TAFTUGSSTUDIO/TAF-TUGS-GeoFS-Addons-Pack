  const save = () => LS.set('gfl_fuel2', F);
  const n0 = x => Math.round(x).toLocaleString();
  const nice = x => x < 1000 ? Math.round(x) : Math.round(x / 10) * 10;

  // ---- engine control: flame-out when the tank is empty ----

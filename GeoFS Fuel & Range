  // ---- status tab controls ----
  loadInputs();
  ['fu-cap', 'fu-cb', 'fu-sp', 'fu-res'].forEach(id => $(id).addEventListener('change', () => {
    const cap = parseFloat($('fu-cap').value), cb = parseFloat($('fu-cb').value), sp = parseFloat($('fu-sp').value), rs = parseFloat($('fu-res').value);
    if (cap > 0) F.cap = cap; if (cb > 0) F.cruise = cb; if (sp > 0) F.speed = sp; if (rs >= 0) F.reserve = rs;

  let lastCut = 0;
  function engineState() {          // true = running, false = off, null = unknown
    try {
      const inst = geofs.aircraft.instance;
      if (inst.engine && typeof inst.engine.on === 'boolean') return inst.engine.on;
      if (Array.isArray(inst.engines) && inst.engines.some(e => typeof e.on === 'boolean')) return inst.engines.some(e => e.on === true);
    } catch (e) { /* ignore */ }
    return null;
  }

  function cutEngines() {
    const now = performance.now(); if (now - lastCut < 500) return; lastCut = now;
    try {
      const inst = geofs.aircraft.instance;
      if (typeof inst.stopEngine === 'function') inst.stopEngine();
      if (inst.engine && typeof inst.engine.on === 'boolean') inst.engine.on = false;

      if (Array.isArray(inst.engines)) inst.engines.forEach(e => { if (typeof e.on === 'boolean') e.on = false; });
    } catch (e) { /* ignore */ }
  }

  function aircraftKey() {
    try { return String((geofs.aircraft.instance.aircraftRecord || {}).name || '').toLowerCase(); } catch (e) { return ''; }
  }
  function profileFor(key) { for (const pr of PROFILES) if (pr[0].test(key)) return pr; return null; }
  function refFor(key) { for (const r of REFDATA) if (r[0].test(key)) return r; return null; }

      reach.textContent = spare >= 0 ? '✓ reachable (+' + n0(spare) + ' nm)' : '✗ short by ' + n0(-spare) + ' nm';
      reach.style.color = spare >= 0 ? '#4ade80' : '#f87171';
    } else { reach.textContent = tg ? '—' : 'not set (use Flight plan)'; reach.style.color = ''; }
    const arr = $('fu-arr');
    if (tg && lla) {
      const leftAtTarget = F.left - haversineNm(lla, tg) / spd * pb;
      arr.textContent = n0(Math.max(0, leftAtTarget)) + ' lb';

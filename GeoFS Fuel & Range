    box.innerHTML = '<div class="muted">Real-world reference: ' + esc(r[1]) + '</div>' +
      '<div class="ref"><span>Max nonstop endurance</span><b>' + esc(r[2]) + '</b></div>' +
      '<div class="ref"><span>Max range (single flight)</span><b>' + esc(r[3]) + '</b></div>' +

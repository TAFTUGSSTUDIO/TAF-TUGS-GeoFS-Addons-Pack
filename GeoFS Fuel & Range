    route = pts;
    $('fp-from').value = pts[0][0].toFixed(4) + ', ' + pts[0][1].toFixed(4);
    $('fp-to').value = pts[pts.length - 1][0].toFixed(4) + ', ' + pts[pts.length - 1][1].toFixed(4);
    $('fp-extra').value = 2; readPlan();
    msg('Imported ' + pts.length + ' waypoints from the GeoFS flight plan.', '#4ade80');
  };

  // Splits a trip into climb / cruise / descent and returns fuel + time for each phase
  function tripModel(dist, wind) {
    const ph = phasesFor(aircraftKey()), cs = F.speed;
    // ph: [re, -, climbMin, climbSpdFrac, climbBurnX, descMin, descSpdFrac, descBurnX, taxiFrac]
    let cT = ph[2] / 60, dT = ph[5] / 60;
    let cNm = cT * Math.max(40, cs * ph[3] - wind), dNm = dT * Math.max(40, cs * ph[6] - wind);
    if (cNm + dNm > dist * 0.8) {                      // short hop: squeeze climb/descent
      const k = dist * 0.8 / (cNm + dNm);
      cT *= k; dT *= k; cNm *= k; dNm *= k;
    }
    const gs = Math.max(60, cs - wind);
    const cruiseNm = Math.max(0, dist - cNm - dNm), cruiseH = cruiseNm / gs;
    const climbLb = cT * F.cruise * ph[4], descLb = dT * F.cruise * ph[7], cruiseLb = cruiseH * F.cruise;
    return { ph, gs, cNm, dNm, cT, dT, cruiseNm, cruiseH, climbLb, descLb, cruiseLb,
             trip: climbLb + cruiseLb + descLb, hrs: cT + cruiseH + dT };
  }

  function calculate() {
    readPlan();
    const from = resolve(PL.from, true), to = resolve(PL.to, false);
    let alt = PL.alt ? resolve(PL.alt, false) : undefined, altTag = '';
    const autoAltCode = DEFAULT_ALT[PL.to.toUpperCase()];
    if (!PL.alt && PL.autoAlt && autoAltCode) { altTag = autoAltCode + ', '; alt = AIRPORTS[autoAltCode]; }
    if (!from) { msg(PL.from ? 'Unknown "From": use an ICAO from the built-in list or "lat, lon".' : 'Waiting for the sim — or type a From airport.', '#f87171'); return null; }
    if (!to) { msg(PL.to ? 'Unknown "To": use an ICAO from the built-in list or "lat, lon".' : 'Enter a destination.', '#f87171'); return null; }
    if (PL.alt && !alt) { msg('Unknown alternate: use an ICAO from the built-in list or "lat, lon".', '#f87171'); return null; }
    let dist = 0;
    if (route && route.length > 1) for (let i = 1; i < route.length; i++) dist += haversineNm(route[i - 1], route[i]);
    else dist = haversineNm(from, to);
    dist *= 1 + PL.extra / 100;

    let wind = PL.wind, windAuto = false;
    if (PL.autoWind && !PL.wind && dist > 300) { wind = autoWind(from, to); windAuto = true; }
    const tm = tripModel(dist, wind);
    const taxi = PL.taxi / 60 * F.cruise * tm.ph[8];
    const cont = tm.trip * 0.05;
    const altDist = alt ? haversineNm(to, alt) * 1.05 : 0;
    const altFuel = alt ? tripModel(Math.max(altDist, 20), 0).trip : 0;
    const reserve = F.reserve / 60 * F.cruise;
    const block = nice(tm.trip + taxi + cont + altFuel + reserve + PL.add);

    // max range with a full tank, using the same phase model
    const big = tripModel(1e5, 0);
    const availCruise = (F.cap - reserve - taxi) / 1.05 - big.climbLb - big.descLb;
    const maxRange = Math.max(0, availCruise / F.cruise) * big.gs + big.cNm + big.dNm;

    lastPlan = { block, to, dist };
    const pct = F.cap > 0 ? block / F.cap * 100 : 0;

    const row = (a, b, cls) => `<div class="row ${cls || ''}"><span>${a}</span><b>${b}</b></div>`;
    $('fp-out').innerHTML = `<div class="sec">` +
      row('Distance', n0(dist) + ' nm') + row('Ground speed', n0(tm.gs) + ' kt') + (wind ? row('Wind' + (windAuto ? ' (est.)' : ''), n0(Math.abs(wind)) + ' kt ' + (wind > 0 ? 'head' : 'tail')) : '') + row('Flight time', fmtHM(tm.hrs)) +
      row('Climb / accel', n0(tm.climbLb) + ' lb') + row('Cruise', n0(tm.cruiseLb) + ' lb') + row('Descent', n0(tm.descLb) + ' lb') +
      row('Trip fuel', n0(tm.trip) + ' lb') + row('Taxi', n0(taxi) + ' lb') + row('Contingency (5%)', n0(cont) + ' lb') +
      (alt ? row('Alternate (' + altTag + n0(altDist) + ' nm)', n0(altFuel) + ' lb') : '') +
      row('Final reserve (' + F.reserve + ' min)', n0(reserve) + ' lb') + (PL.add ? row('Extra', n0(PL.add) + ' lb') : '') +
      row('BLOCK FUEL', n0(block) + ' lb (' + Math.round(pct) + '%)', 'tot') +
      row('Max range, full tank', n0(maxRange) + ' nm') + `</div>`;
    if (block > F.cap) msg('⚠ Needs ' + n0(block - F.cap) + ' lb more than the tank holds. Add a fuel stop or choose a closer destination.', '#fb923c');
    else if (!alt && dist > 600) msg('Plan OK — ' + n0(F.cap - block) + ' lb spare. No alternate set: consider adding one.', '#fde047');
    else msg('Plan OK — ' + n0(F.cap - block) + ' lb of spare tank capacity.', '#4ade80');
    return lastPlan;
  }
  $('fp-calc').onclick = calculate;
  $('fp-apply').onclick = () => {
    const pl = calculate(); if (!pl) return;
    F.left = Math.min(pl.block, F.cap); save();
    Target.set([pl.to[0], pl.to[1]]);
    msg('Loaded ' + n0(F.left) + ' lb (' + Math.round(F.left / F.cap * 100) + '%) and set your target. Safe flight!', '#4ade80');
  };

  showTab('status');

  render(null, null);

  // ---- every frame ----
  createTracker(function (c) {
    lastLla = c.lla; lastT = c.T;
    const key = aircraftKey();
    if (key && key !== F.acKey) {                 // new aircraft detected
      F.acKey = key;
      if (F.auto) { applyProfile(key); F.left = F.cap; }
      save();
    }
    const running = engineState() !== false;                     // engines off = no burn
    if (c.dt > 0) {
      const thr = typeof c.av.throttle === 'number' ? clamp(c.av.throttle, 0, 1) : 0.3;
      const sst = /concorde|tu-?144/.test(key);
      const refThr = sst ? 0.95 : 0.74;                                      // throttle that gives cruise burn
      const accel = (sst && !c.onGround && thr > 0.85 && c.T.gs < F.speed * 0.8) ? 1.6 : 1;   // reheat / transonic acceleration
      const rate = running ? (F.cruise / refThr) * (0.12 + 0.88 * thr) * accel : 0;   // idle ≈ 12% of cruise-throttle burn
      burnRate = burnRate ? burnRate * 0.98 + rate * 0.02 : rate;
      F.left = Math.max(0, F.left - rate * c.dt / 3600);
      const now = performance.now();
      if (now - lastSave > 5000) { lastSave = now; save(); }
    }
    const empty = F.left <= 0 && F.cutoff;
    if (empty && running) cutEngines();                           // also blocks restart attempts
    banner.style.display = empty ? 'block' : 'none';
    onGroundNow = c.onGround;
    render(c.T, c.lla);
  }, function () { /* landing: nothing to do */ });

})();

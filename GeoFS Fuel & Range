    const bar = $('fu-bar'); bar.style.width = (pct * 100) + '%';
    bar.style.background = pct > 0.25 ? '#4ade80' : pct > 0.1 ? '#fb923c' : '#ef4444';
    $('fu-burn').textContent = n0(burnRate) + ' lb/h';

    // Plan with cruise burn on the ground; in the air use the real burn, kept within a sensible band
    const airborne = T && !onGroundNow;
    const pb = airborne && burnRate > 0 ? clamp(burnRate, F.cruise * 0.8, F.cruise * 1.3) : F.cruise;
    const reserveLb = pb * (F.reserve / 60);
    const usable = Math.max(0, F.left - reserveLb);
    const endH = pb > 0 ? usable / pb : Infinity;
    $('fu-end').textContent = fmtHM(endH);
    // use real ground speed only once near cruise; during climb/accel it would understate range
    const spd = (T && T.gs > F.speed * 0.85) ? T.gs : F.speed;
    let range = null;
    if (isFinite(endH)) { range = endH * spd; $('fu-range').textContent = n0(range) + ' nm'; }
    else $('fu-range').textContent = '—';

    window.addEventListener('mousemove', e => {
      if (!drag) return;
      el.style.left = (e.clientX - ox) + 'px'; el.style.top = (e.clientY - oy) + 'px'; el.style.right = 'auto';
    });
    // typing in a panel must not trigger GeoFS hotkeys
    ['keydown', 'keyup', 'keypress'].forEach(ev =>

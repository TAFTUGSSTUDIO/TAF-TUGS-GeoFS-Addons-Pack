  $('fu-clr').onclick = () => Target.set(null);
  $('fu-full').onclick = () => { F.left = F.cap; save(); };
  $('fu-auto').onclick = () => { F.auto = true; applyProfile(aircraftKey()); F.left = Math.min(F.left, F.cap); save(); };
  const slider = $('fu-fill');
  slider.addEventListener('mousedown', () => sliding = true);
  window.addEventListener('mouseup', () => { if (sliding) { sliding = false; save(); } });
  slider.addEventListener('input', () => { F.left = F.cap * slider.value / 100; });

  function render(T, lla) {
    const pct = F.cap > 0 ? F.left / F.cap : 0;
    $('fu-ac').textContent = aircraftKey() ? (geofs.aircraft.instance.aircraftRecord.name) : '—';
    $('fu-prof').textContent = F.auto ? (F.profile ? '✓ Auto profile: ' + F.profile : '') : '✎ ' + (F.profile || 'Manual settings');
    updateRef(aircraftKey());
    $('fu-left').textContent = n0(F.left) + ' lb (' + Math.round(pct * 100) + '%)';
    $('fu-fillv').textContent = Math.round(pct * 100) + '%';

  // Reads GeoFS ~10x/s and calls onTick every frame and onTouchdown on a real landing
  function createTracker(onTick, onTouchdown) {
    const T = { last: null, vs: 0, gs: 0, prevVs: 0, prevGs: 0, wasGround: true, wasHigh: false, airSec: 0 };
    function tick() {
      const inst = window.geofs && geofs.aircraft && geofs.aircraft.instance;
      if (!inst || !inst.llaLocation) return;
      if (typeof geofs.isPaused === 'function' && geofs.isPaused()) return;
      const lla = inst.llaLocation.slice(0, 3);
      const now = performance.now() / 1000;
      const av = (geofs.animation && geofs.animation.values) || {};
      const hagl = typeof av.haglFeet === 'number' ? av.haglFeet : null;
      const onGround = !!inst.groundContact || (hagl !== null && hagl < 2);
      if (!onGround && (hagl === null ? T.airSec > 15 : hagl > 50)) T.wasHigh = true;
      let dt = 0, dNm = 0, gsInst = 0;
      if (T.last) {
        const d = now - T.last.t;
        if (d > 0 && d < 1) {
          const nm = haversineNm(T.last.lla, lla), g = (nm * 3600) / d;
          if (g < 3000) {
            dt = d; dNm = nm; gsInst = g;
            const vsInst = ((lla[2] - T.last.lla[2]) * M_TO_FT * 60) / d;
            T.gs = T.gs * 0.8 + g * 0.2; T.vs = T.vs * 0.8 + vsInst * 0.2;
            if (!onGround) T.airSec += d;
          }
        }
      }
      onTick({ T, lla, dt, dNm, gsInst, onGround, av });
      if (!T.wasGround && onGround && T.wasHigh) {
        onTouchdown({ vs: Math.max(0, -T.prevVs), gs: T.prevGs });
        T.wasHigh = false;
      }
      if (!onGround) { T.prevVs = T.vs; T.prevGs = T.gs; }
      T.wasGround = onGround; T.last = { lla, t: now };
    }
    setInterval(() => { try { tick(); } catch (e) { /* GeoFS not ready yet */ } }, 100);
    return T;
  }

    el.className = 'gfl-panel'; el.id = 'gfl-' + opts.id; el.style.width = (opts.width || 250) + 'px';
    el.innerHTML = `<div class="gfl-hd"><span>${opts.title}</span><span class="gfl-min" title="Collapse / expand">–</span></div><div class="gfl-bd"></div>`;
    document.body.appendChild(el);

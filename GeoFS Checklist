  let typeSel = LS.get('gfl_cktype4', 'auto');
  let follow = !!LS.get('gfl_ckfollow', false);
  let phase = LS.get('gfl_phase4', 'Preflight');
  const checks = LS.get('gfl_checks4', {});

  const curType = () => typeSel === 'auto' ? detectType(nameLC) : typeSel;
  const listKey = () => LISTKEY[curType()] || 'B';
  const ckey = n => listKey() + '|' + n;

  function profile() {
    const t = curType();
    let e = null;
    for (const f of FLAPS) if (f[0].test(nameLC)) { e = f[1]; break; }
    const P = Object.assign({}, FLAPS_DEFAULT[t] || {}, e || {});
    P.fixed = FIXED_GEAR.test(nameLC);
    P.single = SINGLE_ENGINE.test(nameLC);
    return P;
  }

  function matches(tags, t) {
    if (!tags) return true;
    return tags.indexOf(t) >= 0 || (t === 'M' && tags.indexOf('G') >= 0);
  }

  function allPhases() { const L = LISTS[listKey()]; return L ? L.normal.concat(L.emerg) : []; }
  function normalCount() { const L = LISTS[listKey()]; return L ? L.normal.length : 0; }

  function itemsFor(name) {
    const t = curType(), P = profile(), out = [];
    const ph = allPhases().find(a => a[0] === name);
    if (!ph) return out;
    ph[1].forEach(raw => {
      let s = raw, tags = null, m = s.match(/^\[([A-Z]+)\]/);
      if (m) { tags = m[1]; s = s.slice(m[0].length); }
      let needFlaps = false, needGear = false, single = false, multi = false;
      while (s[0] === '~' || s[0] === '^' || s[0] === '*' || s[0] === '+') {
        if (s[0] === '~') needFlaps = true; else if (s[0] === '^') needGear = true;
        else if (s[0] === '*') single = true; else multi = true;
        s = s.slice(1);
      }
      // a second tag block may follow a marker, e.g. ^[ABFTPE]text
      m = s.match(/^\[([A-Z]+)\]/);
      if (m) { tags = m[1]; s = s.slice(m[0].length); }
      while (s[0] === '~' || s[0] === '^' || s[0] === '*' || s[0] === '+') {
        if (s[0] === '~') needFlaps = true; else if (s[0] === '^') needGear = true;
        else if (s[0] === '*') single = true; else multi = true;
        s = s.slice(1);
      }
      if (!matches(tags, t)) return;
      if (needFlaps && P.noFlaps) return;
      if (needGear && P.fixed) return;
      if (single && !P.single) return;
      if (multi && P.single) return;
      s = s.replace(/\{TO\}/g, P.to || '').replace(/\{APP\}/g, P.app || '').replace(/\{LDG\}/g, P.ldg || '');
      out.push(s);
    });
    return out;
  }

  function visPhases() { return allPhases().filter(a => itemsFor(a[0]).length > 0); }
  function visNames() { return visPhases().map(a => a[0]); }
  const doneCount = name => { const st = checks[ckey(name)] || {}; const it = itemsFor(name); return [it.filter(x => st[x]).length, it.length]; };

  function infoHtml() {
    const t = curType(), P = profile();
    if (listKey() === 'N') return '';
    let h = '';
    if (!P.noFlaps && (P.to || P.ldg)) {
      h += `Flaps · TO: <b>${esc(P.to || '—')}</b> · APP: <b>${esc(P.app || '—')}</b> · LDG: <b>${esc(P.ldg || '—')}</b>`;
    } else if (P.noFlaps && t !== 'H') {
      h += 'Flaps: <b>none</b>';
    }
    if (P.note) h += (h ? '<br>' : '') + esc(P.note);
    return h ? `<div class="fl">${h}</div>` : '';
  }

  function buildSelect() {
    const sel = $('ck-phase'), nn = normalCount();
    const opt = n => { const d = doneCount(n); return `<option value="${esc(n)}"${n === phase ? ' selected' : ''}>${d[0] === d[1] ? '✓ ' : ''}${esc(n)} (${d[0]}/${d[1]})</option>`; };
    const normal = visPhases().filter(a => LISTS[listKey()].normal.indexOf(a) >= 0).map(a => opt(a[0])).join('');
    const emerg = visPhases().filter(a => LISTS[listKey()].emerg.indexOf(a) >= 0).map(a => opt(a[0])).join('');
    sel.innerHTML = '<optgroup label="Normal procedures">' + normal + '</optgroup><optgroup label="Emergency / abnormal">' + emerg + '</optgroup>';
  }

  function render() {
    const t = curType(), key = listKey(), isN = key === 'N';
    $('ck-type').value = typeSel;
    $('ck-follow').checked = follow;
    $('ck-info').innerHTML = infoHtml();
    ['ck-nav', 'ck-btns', 'ck-fol', 'ck-hint'].forEach(id => { $(id).style.display = isN ? 'none' : ''; });
    if (isN) {
      $('ck-list').innerHTML = `<div class="muted" style="margin:8px 0">No checklist for this aircraft (${esc(nameRaw || 'unknown')}). Balloons, paragliders, wingsuits, hang gliders and cars have no normal procedures. Pick a type above if you want a checklist anyway.</div>`;
      return;
    }
    const names = visNames();
    if (names.indexOf(phase) < 0) phase = names[0];
    buildSelect();
    const st = checks[ckey(phase)] || {}, items = itemsFor(phase), d = doneCount(phase);
    $('ck-list').innerHTML =
      `<div class="muted" style="margin-bottom:2px">${d[0]}/${d[1]} complete${d[0] === d[1] ? ' ✓' : ''} · ${esc(TYPE_LABEL[t])}${nameRaw ? ' · ' + esc(nameRaw) : ''}</div>` +
      items.map((x, i) => `<label class="ck ${st[x] ? 'done' : ''}"><input type="checkbox" data-i="${i}" ${st[x] ? 'checked' : ''}><span>${esc(x)}</span></label>`).join('');
    $('ck-list').querySelectorAll('input').forEach(cb => cb.onchange = () => {
      const map = checks[ckey(phase)] || (checks[ckey(phase)] = {});
      map[items[+cb.dataset.i]] = cb.checked; LS.set('gfl_checks4', checks); render();
    });
    const nrm = LISTS[key].normal.map(a => a[0]).filter(n => names.indexOf(n) >= 0);
    const idx = nrm.indexOf(phase), hint = $('ck-hint');
    if (d[0] === d[1] && d[1] > 0 && idx >= 0 && idx < nrm.length - 1) {
      hint.innerHTML = `<button id="ck-go" style="margin-top:6px">Next: ${esc(nrm[idx + 1])} ▶</button>`;
      $('ck-go').onclick = () => setPhase(nrm[idx + 1]);
    } else hint.innerHTML = '';
  }
  function setPhase(n) { phase = n; LS.set('gfl_phase4', phase); render(); }

  $('ck-phase').onchange = e => setPhase(e.target.value);
  $('ck-prev').onclick = () => { const n = visNames(); setPhase(n[(n.indexOf(phase) - 1 + n.length) % n.length]); };
  $('ck-next').onclick = () => { const n = visNames(); setPhase(n[(n.indexOf(phase) + 1) % n.length]); };
  $('ck-type').onchange = e => { typeSel = e.target.value; LS.set('gfl_cktype4', typeSel); render(); };
  $('ck-follow').onchange = e => { follow = e.target.checked; LS.set('gfl_ckfollow', follow); };
  $('ck-reset').onclick = () => { checks[ckey(phase)] = {}; LS.set('gfl_checks4', checks); render(); };
  $('ck-resetall').onclick = () => { if (confirm('Untick every checklist?')) { Object.keys(checks).forEach(k => delete checks[k]); LS.set('gfl_checks4', checks); render(); } };
  render();

  // ---- aircraft change detection + optional follow-the-flight ----
  let landed = false, cand = null, candAt = 0;
  createTracker(function (c) {
    const nm = acName();
    if (nm !== nameRaw) { nameRaw = nm; nameLC = nm.toLowerCase(); render(); }
    if (!follow || listKey() === 'N') return;
    const T = c.T, h = typeof c.av.haglFeet === 'number' ? c.av.haglFeet : (c.onGround ? 0 : 5000), vs = T.vs;
    let ph = null;
    if (c.onGround) {
      if (landed) ph = T.gs > 3 ? 'After landing' : 'Shutdown';
      else if (T.gs > 40) ph = 'Takeoff & climb-out';
      else if (T.gs > 3) ph = 'Taxi';
    } else {
      landed = false;
      if (h < 1500 && vs > 200) ph = 'Takeoff & climb-out';
      else if (vs > 300) ph = 'Climb';
      else if (h > 3000 && vs > -300) ph = 'Cruise';
      else if (h > 3000) ph = 'Descent';
      else if (h > 800) ph = 'Approach';
      else ph = 'Before landing';
    }
    if (ph && visNames().indexOf(ph) < 0) ph = null;      // this aircraft has no such phase
    const now = performance.now();
    if (ph && ph !== phase) {
      if (cand !== ph) { cand = ph; candAt = now; }
      else if (now - candAt > 3000) { cand = null; setPhase(ph); }
    } else cand = null;
  }, function () { landed = true; });

})();

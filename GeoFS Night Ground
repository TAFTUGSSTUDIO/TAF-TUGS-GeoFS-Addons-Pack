// ==UserScript==
// @name         GeoFS Night Ground - city lights from satellite tiles + NASA map
// @namespace    geofs-night-ground
// @version      1
// @description  Night ground = perfect middle-ground brightness for realistic night flying.
// @match        https://www.geo-fs.com/*
// @match        https://beta.geo-fs.com/*
// @run-at       document-end
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const TAG = '[Night Ground]';
    const VERSION = '2.8';

    if (window.__geofsNightGroundLoaded) {
        console.warn(TAG, 'a second Night Ground script is running (' + window.__geofsNightGroundLoaded + ' and ' + VERSION + '). Disable the old one in Tampermonkey!');
    }
    window.__geofsNightGroundLoaded = VERSION;

    const NASA_URL = 'https://svs.gsfc.nasa.gov/vis/a030000/a030000/a030003/dmsp_4096.png';
    const ESRI_URL = 'https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}';

    const settings = window.geofsNightGround = {
        version: VERSION,
        enabled: true,
        forceNight: false,    // Shift+X to test in daytime
        brightness: 0.75,     // Sweet spot: brighter than v2.8, darker than v2.6
        density: 0.95,        // Balanced fill
        glow: 0.3,            // Subtle realistic ambient bloom
        buildings: true,      // tint GeoFS 3D building models at night
        maxLevel: 17,         // highest tile zoom requested
        size: 1,              // Base light size
        orangeShare: 0.18,    // 18% orange sodium lights, 82% warm yellow
        yellow: [245, 195, 95],
        orange: [240, 125, 35]
    };

    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const hash = n => { const s = Math.sin(n * 12.9898) * 43758.5453; return s - Math.floor(s); };

    function getViewer() {
        const g = window.geofs;
        return (g && g.api && g.api.viewer) || window.viewer || (g && g.viewer) || null;
    }

    function loadImage(url) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = () => resolve(img);
            img.onerror = () => reject(new Error('tile failed'));
            img.src = url;
        });
    }

    function toast(text, ms) {
        try {
            let el = document.getElementById('nightGroundToast');
            if (!el) {
                el = document.createElement('div');
                el.id = 'nightGroundToast';
                el.style.cssText = 'position:fixed;top:44px;left:50%;transform:translateX(-50%);z-index:99999;' +
                    'background:rgba(0,0,0,0.8);color:#ffc846;padding:6px 14px;border-radius:6px;' +
                    'font:14px sans-serif;pointer-events:none;transition:opacity .3s;';
                document.body.appendChild(el);
            }
            el.textContent = text;
            el.style.opacity = '1';
            clearTimeout(el._t);
            el._t = setTimeout(() => { el.style.opacity = '0'; }, ms || 3000);
        } catch (e) {}
    }

    let nasa = null;
    const nasaReady = (async () => {
        try {
            const img = await loadImage(NASA_URL);
            const c = document.createElement('canvas');
            c.width = img.naturalWidth; c.height = img.naturalHeight;
            const ctx = c.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(img, 0, 0);
            nasa = { w: c.width, h: c.height, data: ctx.getImageData(0, 0, c.width, c.height).data };
            console.log(TAG, 'NASA night map loaded');
        } catch (e) {
            nasa = false;
            console.warn(TAG, 'NASA map blocked (CORS) - using flat density');
        }
    })();

    function densityAt(lon, lat, span) {
        if (!nasa) return 0.7;
        let sum = 0, n = 0;
        for (let i = -1; i <= 1; i++) for (let j = -1; j <= 1; j++) {
            const x = clamp(Math.floor(((lon + i * span * 0.5 + 180) / 360) * nasa.w), 0, nasa.w - 1);
            const y = clamp(Math.floor(((90 - (lat + j * span * 0.5)) / 180) * nasa.h), 0, nasa.h - 1);
            const k = (y * nasa.w + x) * 4;
            sum += (nasa.data[k] * 0.299 + nasa.data[k + 1] * 0.587 + nasa.data[k + 2] * 0.114) / 255;
            n++;
        }
        return Math.pow(clamp(sum / n, 0, 1), 0.7);
    }

    const NOISE = new Float32Array(65536);
    for (let i = 0; i < 65536; i++) NOISE[i] = hash(i + 0.5);
    const pack = c => (255 << 24) | (c[2] << 16) | (c[1] << 8) | c[0];

    function renderNightTile(img, dens, level, x, y) {
        const S = 256;
        const cv = document.createElement('canvas');
        cv.width = cv.height = S;
        const ctx = cv.getContext('2d', { willReadFrequently: true });
        ctx.drawImage(img, 0, 0, S, S);
        const id = ctx.getImageData(0, 0, S, S);
        const d = id.data;
        const u32 = new Uint32Array(id.data.buffer);

        const dn = clamp(dens * settings.density, 0, 1.3);
        const lowZoom = level < 9;
        const seed = (x * 7919 + y * 104729 + level * 31) | 0;
        const cseed = (x * 17 + y * 29 + level) | 0;
        const br = settings.brightness, og = settings.orangeShare;
        const Y = settings.yellow, O = settings.orange;
        const BLACK = pack([1, 1, 3]);

        const thinningFactor = level < 11 ? Math.pow(0.55, 11 - level) : 1.0;

        const Lmap = new Float32Array(65536);
        for (let i = 0, p = 0; p < 65536; i += 4, p++) {
            const r = d[i], g = d[i + 1], b = d[i + 2];
            const n1 = NOISE[(p * 13 + seed) & 65535];
            let L = 0;
            if (lowZoom) {
                L = (n1 < dn * 0.32 * thinningFactor) ? 0.35 + 0.55 * n1 : 0;
            } else {
                const lum = 0.299 * r + 0.587 * g + 0.114 * b;
                if (lum > 55) { // Slightly lowered threshold back down so neighborhood grids catch the light
                    const mx = r > g ? (r > b ? r : b) : (g > b ? g : b);
                    const mn = r < g ? (r < b ? r : b) : (g < b ? g : b);
                    const sat = (mx - mn) / (mx + 1);
                    let built = Math.min(1, (lum - 55) / 100) * Math.max(0, 1 - sat * 2.1);
                    if (r > b * 1.1) built *= 0.28;
                    const pr = built * (0.08 + 1.25 * dn);
                    if (pr > 0.4 + 0.38 * n1) L = pr > 1 ? 1 : pr;
                }
            }
            Lmap[p] = L;
        }

        const sz = level < 10 ? 1 : (settings.size | 0);
        for (let p = 0; p < 65536; p++) {
            const col = p & 255;
            let L = Lmap[p];
            if (sz > 1 && level >= 10) {
                for (let dy = 0; dy < sz; dy++) for (let dx = 0; dx < sz; dx++) {
                    if (!dx && !dy) continue;
                    if (col - dx < 0 || p - dy * 256 - dx < 0) continue;
                    const v = Lmap[p - dy * 256 - dx];
                    if (v > L) L = v;
                }
            }
            if (L <= 0) { u32[p] = BLACK; continue; }
            const row = p >> 8;
            const cell = NOISE[(((col >> 2) * 131 + (row >> 2) * 977 + cseed) & 65535)];
            const c = cell < og ? O : Y;
            let k = L * br; k = (k > 1 ? 1 : k < 0.2 ? 0.2 : k) * (0.75 + 0.25 * NOISE[(p * 7 + 3) & 65535]);
            u32[p] = (255 << 24) | ((c[2] * k) << 16) | ((c[1] * k) << 8) | (c[0] * k);
        }
        ctx.putImageData(id, 0, 0);

        if (settings.glow > 0 && level >= 10) {
            ctx.save();
            ctx.globalCompositeOperation = 'lighter';
            ctx.filter = 'blur(2px)';
            ctx.globalAlpha = settings.glow;
            ctx.drawImage(cv, 0, 0);
            ctx.restore();
        }
        return cv;
    }

    function quadKey(x, y, z) {
        let key = '';
        for (let i = z; i > 0; i--) {
            let digit = 0; const mask = 1 << (i - 1);
            if (x & mask) digit += 1;
            if (y & mask) digit += 2;
            key += digit;
        }
        return key;
    }

    const SOURCES = [
        { name: 'Bing',   maxLevel: 19, url: (x, y, z) => 'https://ecn.t' + ((x + y) % 4) + '.tiles.virtualearth.net/tiles/a' + quadKey(x, y, z) + '.jpeg?g=1&n=z' },
        { name: 'Esri',   maxLevel: 19, url: (x, y, z) => ESRI_URL.replace('{z}', z).replace('{y}', y).replace('{x}', x) },
        { name: 'Google', maxLevel: 20, url: (x, y, z) => 'https://mt' + ((x + y) % 4) + '.google.com/vt/lyrs=s&x=' + x + '&y=' + y + '&z=' + z }
    ];

    function createProvider() {
        const tiling = new Cesium.WebMercatorTilingScheme();
        const failed = new Set();

        function ancestorFailed(name, x, y, level) {
            for (let l = level, cx = x, cy = y; l >= 0; l--, cx >>= 1, cy >>= 1) {
                if (failed.has(name + '/' + l + '/' + cx + '/' + cy)) return true;
            }
            return false;
        }

        async function requestImage(x, y, level) {
            await Promise.race([nasaReady, new Promise(r => setTimeout(r, 800))]);
            for (const s of SOURCES) {
                if (level > Math.min(s.maxLevel, settings.maxLevel) || ancestorFailed(s.name, x, y, level)) continue;
                try {
                    const img = await loadImage(s.url(x, y, level));
                    const rect = tiling.tileXYToRectangle(x, y, level);
                    const lon = Cesium.Math.toDegrees((rect.west + rect.east) / 2);
                    const lat = Cesium.Math.toDegrees((rect.south + rect.north) / 2);
                    const span = Cesium.Math.toDegrees(rect.east - rect.west);
                    return renderNightTile(img, densityAt(lon, lat, span), level, x, y);
                } catch (e) {
                    failed.add(s.name + '/' + level + '/' + x + '/' + y);
                }
            }
            throw new Error('No imagery for ' + level + '/' + x + '/' + y);
        }

        return {
            tilingScheme: tiling, rectangle: tiling.rectangle,
            tileWidth: 256, tileHeight: 256, minimumLevel: 0, maximumLevel: settings.maxLevel,
            tileDiscardPolicy: undefined, errorEvent: new Cesium.Event(),
            credit: new Cesium.Credit('Microsoft Bing, Esri, Maxar, Google, NASA DMSP'),
            proxy: undefined, ready: true, readyPromise: Promise.resolve(true),
            hasAlphaChannel: false, getTileCredits: () => [], pickFeatures: () => undefined,
            requestImage
        };
    }

    function sunHeights(viewer) {
        const res = { clock: NaN, light: NaN };
        let up = null;
        try { up = Cesium.Cartesian3.normalize(viewer.camera.positionWC, new Cesium.Cartesian3()); } catch (e) { return res; }
        try {
            const t = viewer.clock.currentTime;
            const inertial = Cesium.Simon1994PlanetaryPositions.computeSunPositionInEarthInertialFrame(t);
            const m = Cesium.Transforms.computeTemeToPseudoFixedMatrix(t);
            if (m && inertial) {
                const fixed = Cesium.Matrix3.multiplyByVector(m, inertial, new Cesium.Cartesian3());
                res.clock = Cesium.Cartesian3.dot(up, Cesium.Cartesian3.normalize(fixed, fixed));
            }
        } catch (e) {}
        try {
            const toSun = Cesium.Cartesian3.negate(viewer.scene.light.direction, new Cesium.Cartesian3());
            res.light = Cesium.Cartesian3.dot(up, toSun);
        } catch (e) {}
        return res;
    }

    function nightState(viewer) {
        if (settings.forceNight) return { a: 1, pre: true };
        const h = sunHeights(viewer);
        let d = settings.source === 'light' ? h.light : settings.source === 'clock' ? h.clock : (isNaN(h.clock) ? h.light : h.clock);
        if (isNaN(d)) d = isNaN(h.light) ? 1 : h.light;
        return { a: clamp((0.05 - d) / 0.2, 0, 1), pre: d < 0.35 };
    }

    settings.source = 'auto';

    function findTilesets(scene) {
        const out = [];
        const walk = (col, depth) => {
            for (let i = 0; i < col.length; i++) {
                const pr = col.get(i);
                if (pr instanceof Cesium.Cesium3DTileset) out.push(pr);
                else if (depth < 2 && pr && typeof pr.get === 'function' && typeof pr.length === 'number') walk(pr, depth + 1);
            }
        };
        try { walk(scene.primitives, 0); } catch (e) {}
        return out;
    }

    let nightStyle = null;
    function updateBuildings(viewer, isNight) {
        if (!settings.buildings && !isNight) isNight = false;
        let sets;
        try { sets = findTilesets(viewer.scene); } catch (e) { return; }
        if (!nightStyle) {
            try {
                nightStyle = new Cesium.Cesium3DTileStyle({
                    color: { conditions: [
                        ["Number(${feature['cesium#estimatedHeight']}) % 7 < 1", "color('#e68a35', 0.9)"],
                        ["true", "color('#f0ca65', 0.9)"]
                    ] }
                });
            } catch (e) { return; }
        }
        for (const ts of sets) {
            try {
                if (isNight && settings.buildings) {
                    if (!ts._ngStyled) { ts._ngOrigStyle = ts.style; ts.style = nightStyle; ts._ngStyled = true; }
                } else if (ts._ngStyled) {
                    ts.style = ts._ngOrigStyle; ts._ngStyled = false;
                }
            } catch (e) {}
        }
    }

    function start() {
        const viewer = getViewer();
        const layers = viewer.imageryLayers;
        const layer = layers.addImageryProvider(createProvider());
        layer.brightness = 1; layer.contrast = 1; layer.hue = 0; layer.saturation = 1; layer.gamma = 1;
        layer.alpha = 0;
        layer.show = false;

        let lastLen = layers.length;
        let lastBuildCheck = 0;
        layer._nightGround = true;
        viewer.scene.preRender.addEventListener(() => {
            if (layers.length !== lastLen || layers.indexOf(layer) !== layers.length - 1) {
                lastLen = layers.length;
                try { layers.raiseToTop(layer); } catch (e) {}
            }
            const st = settings.enabled ? nightState(viewer) : { a: 0, pre: false };
            layer.show = st.a > 0.01 || st.pre;
            layer.alpha = st.a > 0.01 ? st.a : 0.004;
            const now = Date.now();
            if (now - lastBuildCheck > 1500) { lastBuildCheck = now; updateBuildings(viewer, st.a > 0.5); }
        });

        window.addEventListener('keydown', (e) => {
            if (!e.shiftKey || /input|textarea/i.test((e.target || {}).tagName || '')) return;
            const k = e.key.toLowerCase();
            if (k === 'n') settings.enabled = !settings.enabled;
            else if (k === 'x') settings.forceNight = !settings.forceNight;
            else if (e.key === '}' || e.key === ']') settings.brightness = Math.min(2, settings.brightness + 0.1);
            else if (e.key === '{' || e.key === '[') settings.brightness = Math.max(0.2, settings.brightness - 0.1);
            else if (k === 'd') settings.density = settings.density >= 1.4 ? 0.4 : settings.density + 0.2;
            else return;
            toast('Night Ground ' + (settings.enabled ? 'on' : 'off') + ' (Brightness: ' + settings.brightness.toFixed(2) + ')');
            try { viewer.scene.requestRender(); } catch (er) {}
        });

        toast('Night Ground v' + VERSION + ' loaded (Balanced Brightness)', 5000);
        console.log(TAG, 'v' + VERSION + ' active.');
    }

    const wait = setInterval(() => {
        if (window.geofs && window.geofs.api && window.Cesium && getViewer()) {
            clearInterval(wait);
            setTimeout(start, 2500);
        }
    }, 500);
})();

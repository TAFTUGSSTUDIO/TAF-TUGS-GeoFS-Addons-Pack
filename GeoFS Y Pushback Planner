    p.addEventListener("click", function (e) {
        const b = e.target.closest("button");
        if (!b || b.disabled) return;

        switch (b.dataset.act) {
            case "rotL":      rotateFinalHeading(-ROTATE_STEP_DEG); break;
            case "rotR":      rotateFinalHeading(ROTATE_STEP_DEG); break;
            case "undo":      undoStop(); break;
            case "clear":     clearStops(); break;
            case "cancel":    cancelSelection(); break;
            case "ready":     confirmReady(); break;
            case "stop":      stopPushback(); break;
            case "cam":       setCameraMode(b.dataset.cam); break;
            case "spdD":      changeSpeed(-SPEED_STEP); break;
            case "spdU":      changeSpeed(SPEED_STEP); break;
            case "nonstop":   toggleNonstop(); break;
            case "waitD":     changeWait(-WAIT_STEP); break;
            case "waitU":     changeWait(WAIT_STEP); break;
            case "tune":      nudgeCamera(b.dataset.k, parseFloat(b.dataset.d)); break;
            case "tuneToggle": tuneOpen = !tuneOpen; updatePanel(); break;
            case "tuneReset": resetTune(); break;
            case "tuneShow":  showTuneValues(); break;
            case "zoomIn":    zoomView(1 / ZOOM_STEP); break;
            case "zoomOut":   zoomView(ZOOM_STEP); break;
            case "straight":  toggleStraight(); break;
            case "savePlan":  savePlan(); break;
            case "openSaved": openSaved(); break;
        }

        b.blur();   // so Space / Enter in GeoFS never re-trigger a button
    });


// Top-view zoom: factor < 1 = closer, factor > 1 = further away.
function zoomView(factor) {
    cameraHeight = clamp(cameraHeight * factor, CAMERA_HEIGHT_MIN, CAMERA_HEIGHT_MAX);
}

function changeSpeed(delta) {
    speedSetting = clamp(Math.round((speedSetting + delta) * 10) / 10, SPEED_MIN, SPEED_MAX);
    updatePanel();
    notify("SPEED " + speedSetting.toFixed(1) + " m/s");
}


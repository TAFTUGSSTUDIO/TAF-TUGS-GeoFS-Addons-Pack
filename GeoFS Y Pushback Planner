// SAVED PLANS (per airport)
// ============================================================

function loadStore() {
    try {
        const v = JSON.parse(localStorage.getItem(STORE_KEY));
        return Array.isArray(v) ? v : [];
    } catch (e) {
        return [];
    }
}

function writeStore(list) {
    try {
        localStorage.setItem(STORE_KEY, JSON.stringify(list));
        return true;
    } catch (e) {
        console.error("[Y Pushback] Could not save:", e);
        notify("COULD NOT SAVE — BROWSER STORAGE BLOCKED");
        return false;
    }
}

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
}

function savePlan() {
    if (!selecting || !stops.length) {
        notify("ADD AT LEAST ONE STOP BEFORE SAVING");
        return;
    }

    let lastAirport = "";
    try { lastAirport = localStorage.getItem(STORE_LAST_AIRPORT_KEY) || ""; } catch (e) {}

    const airport = window.prompt("Airport (e.g. ENGM):", lastAirport);
    if (airport === null) return;

    const name = window.prompt("Name for this plan (e.g. Gate 12 → taxiway A):", "Gate");
    if (name === null) return;

    const entry = {
        id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
        airport: (airport.trim() || "UNSORTED").toUpperCase(),
        name: name.trim() || "Plan",
        forward: towForward,
        straight: straightMode,
        speed: speedSetting,
        aircraft: aircraftName(),
        start: { lat: startPosition.lat, lon: startPosition.lon, heading: startHeading },
        stops: stops.map(function (s) { return { lat: s.lat, lon: s.lon, heading: s.heading }; }),
        saved: Date.now()
    };

    const list = loadStore();
    list.push(entry);

    if (writeStore(list)) {
        try { localStorage.setItem(STORE_LAST_AIRPORT_KEY, entry.airport); } catch (e) {}
        notify("SAVED: " + entry.airport + " — " + entry.name);
    }
}

function createSavedMenu() {
    if (document.getElementById("y-pb-saved")) return;

    const m = document.createElement("div");
    m.id = "y-pb-saved";
    m.style.cssText = `
        position:fixed;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%) scale(${UI_SCALE});
        z-index:1000001;
        display:none;
        background:rgba(8,10,12,.97);

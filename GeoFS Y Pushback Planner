let notifyTimer = null;

function notify(text) {
    const ui = document.getElementById("y-pushback-ui");
    if (!ui) return;
    if (notifyTimer) { clearTimeout(notifyTimer); notifyTimer = null; }
    if (inMotion()) notifyTimer = setTimeout(hideUI, 5000);   // keep the screen clean while pushing
    ui.style.display = "block";
    const title = document.getElementById("y-pushback-title");
    if (title) title.textContent = modeName() + " PLANNER";
    const status = document.getElementById("y-pushback-status");
    if (status) status.textContent = text;
}

function updateDistanceUI(d) {
    const el = document.getElementById("y-pushback-distance");
    if (el) el.textContent = "Distance: " + d.toFixed(1) + " m";
}

function updateHeadingUI() {
    const el = document.getElementById("y-pushback-heading");
    if (!el) return;

    let t = "Heading: " + getAircraftHeading().toFixed(0) + "°";
    if (selecting) t += "  →  next stop " + finalHeading.toFixed(0) + "°";

    if (pushing) t += "  →  stop " + Math.min(stopIndex + 1, stops.length) + "/" + stops.length +
                      "  •  " + measuredSpeed.toFixed(1) + " m/s (set " + speedSetting.toFixed(1) + ")";
    if (selecting || pushing) t += "  •  " + planeLabel();
    el.textContent = t;
}

function hideUI() {
    const ui = document.getElementById("y-pushback-ui");
    if (ui) ui.style.display = "none";
}


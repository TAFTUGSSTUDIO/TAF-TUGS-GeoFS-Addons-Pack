function createPlannerCanvas() {
    if (document.getElementById("y-pushback-planner")) return;


    plannerCanvas = document.createElement("canvas");
    plannerCanvas.id = "y-pushback-planner";

    plannerCanvas.style.cssText = `
        position:fixed;
        inset:0;
        width:100vw;
        height:100vh;
        z-index:999998;
        display:none;
        pointer-events:auto;
        cursor:crosshair;
    `;

    document.body.appendChild(plannerCanvas);
    plannerCtx = plannerCanvas.getContext("2d");


    resizePlanner();
    window.addEventListener("resize", resizePlanner);

    plannerCanvas.addEventListener("mousemove", plannerMouseMove);
    plannerCanvas.addEventListener("click", plannerClick);

    // Cursor left the map (e.g. onto the buttons): drop the hover preview,
    // so the rotate buttons act on the last confirmed stop.
    plannerCanvas.addEventListener("mouseleave", function () {
        if (!selecting || !preview) return;
        preview = null;

        rebuildRoute();
    });

    // Right-click: undo the last stop, or cancel when there are none.
    plannerCanvas.addEventListener("contextmenu", function (event) {
        event.preventDefault();
        if (!selecting) return;
        if (stops.length) undoStop();
        else cancelSelection();
    });

    // Mouse wheel = rotate the heading of the stop.
    // Shift = fine steps, Ctrl = zoom the top view.
    plannerCanvas.addEventListener(
        "wheel",
        function (event) {
            event.preventDefault();

            const dir = (event.deltaY || event.deltaX) > 0 ? 1 : -1;

            if (event.ctrlKey) {

                cameraHeight = clamp(
                    cameraHeight * (dir > 0 ? 1.12 : 1 / 1.12),
                    CAMERA_HEIGHT_MIN,
                    CAMERA_HEIGHT_MAX
                );
                return;
            }

            if (!selecting) return;

            rotateFinalHeading(
                dir * (event.shiftKey ? ROTATE_STEP_FINE_DEG : ROTATE_STEP_DEG)
            );
        },
        { passive: false }
    );

}

// Heading the nose must have so the aircraft travels straight from `from` to `to`.
function lineHeading(from, to) {
    const l = geoToLocal(from, to);
    return noseHeadingForTravel(degrees(Math.atan2(l.x, l.y)));
}

// Straight mode: every stop's heading follows the line that leads to it.
function straightenStops() {
    let prev = startPosition;

    stops.forEach(function (s) {
        s.heading = lineHeading(prev, s);
        prev = s;
    });
    finalHeading = stops.length ? stops[stops.length - 1].heading : startHeading;
}

function toggleStraight() {
    if (!selecting) return;

    const oldStops = stops.map(function (s) { return { lat: s.lat, lon: s.lon, heading: s.heading }; });
    const oldFinal = finalHeading;

    straightMode = !straightMode;
    preview = null;
    if (straightMode) straightenStops();

    if (!rebuildRoute()) {
        straightMode = !straightMode;
        stops = oldStops;
        finalHeading = oldFinal;
        rebuildRoute();
        notify("CAN'T STRAIGHTEN THIS ROUTE — UNDO OR MOVE A STOP");

        updatePanel();
        return;
    }

    notify(straightMode ? "STRAIGHT LINES ON — HEADING FOLLOWS THE LINE" : "STRAIGHT LINES OFF — CURVED ROUTE");
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
    updatePanel();
}

// Rotates the stop being placed (the hover preview), or the last
// confirmed stop when nothing is under the cursor.
function rotateFinalHeading(delta) {
    if (straightMode) {
        notify("STRAIGHT MODE — HEADING FOLLOWS THE LINE (PRESS L TO TURN OFF)");

        return;
    }

    finalHeading = normalizeAngle(finalHeading + delta);

    if (preview) {
        preview.heading = finalHeading;
    } else if (stops.length) {
        stops[stops.length - 1].heading = finalHeading;
    }


    rebuildRoute();
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
}

function resizePlanner() {
    if (!plannerCanvas) return;

    const dpr = window.devicePixelRatio || 1;

    plannerCanvas.width = window.innerWidth * dpr;
    plannerCanvas.height = window.innerHeight * dpr;
    plannerCanvas.style.width = window.innerWidth + "px";
    plannerCanvas.style.height = window.innerHeight + "px";

    if (plannerCtx) plannerCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}

function showPlanner() {
    if (plannerCanvas) plannerCanvas.style.display = "block";
}

function hidePlanner() {
    if (plannerCanvas) plannerCanvas.style.display = "none";

}

// ============================================================
// PLANE TEXTURE
// ============================================================

// Starts loading the images of the current aircraft.
function loadPlaneTexture() {
    planeSpec();
}

// Finds the aircraft inside the picture (ignores the empty margin) and
// returns its bounding box in image pixels: {x, y, w, h}.
function computeCrop(img) {

    const W = img.naturalWidth;
    const H = img.naturalHeight;
    const full = { x: 0, y: 0, w: W, h: H, cropped: false };

    try {
        const k = Math.min(1, CROP_ANALYSE_SIZE / Math.max(W, H));
        const cw = Math.max(1, Math.round(W * k));
        const ch = Math.max(1, Math.round(H * k));


        const c = document.createElement("canvas");
        c.width = cw;
        c.height = ch;

        const g = c.getContext("2d", { willReadFrequently: true });
        g.drawImage(img, 0, 0, cw, ch);

        const d = g.getImageData(0, 0, cw, ch).data;

        // Background = the four corners. Transparent corners -> use alpha,
        // otherwise compare colours with the corner colour.
        const corners = [
            0,
            (cw - 1) * 4,
            (ch - 1) * cw * 4,
            ((ch - 1) * cw + (cw - 1)) * 4
        ];

        let transparentBg = true;
        let br = 0, bg = 0, bb = 0;

        corners.forEach(function (o) {
            if (d[o + 3] >= CROP_ALPHA_MIN) transparentBg = false;
            br += d[o]; bg += d[o + 1]; bb += d[o + 2];
        });

        br /= 4; bg /= 4; bb /= 4;


        let minX = cw, minY = ch, maxX = -1, maxY = -1;

        for (let y = 0; y < ch; y++) {
            for (let x = 0; x < cw; x++) {
                const o = (y * cw + x) * 4;
                if (d[o + 3] < CROP_ALPHA_MIN) continue;

                if (!transparentBg) {
                    const diff = Math.max(
                        Math.abs(d[o] - br),
                        Math.abs(d[o + 1] - bg),
                        Math.abs(d[o + 2] - bb)

                    );
                    if (diff <= CROP_COLOR_DIFF) continue;
                }

                if (x < minX) minX = x;
                if (x > maxX) maxX = x;
                if (y < minY) minY = y;
                if (y > maxY) maxY = y;

            }
        }

        if (maxX < minX || maxY < minY) return full;

        const x0 = Math.max(0, Math.floor(minX / k));
        const y0 = Math.max(0, Math.floor(minY / k));
        const x1 = Math.min(W, Math.ceil((maxX + 1) / k));
        const y1 = Math.min(H, Math.ceil((maxY + 1) / k));

        const box = { x: x0, y: y0, w: x1 - x0, h: y1 - y0, cropped: true,
            bg: transparentBg ? null : { r: br, g: bg, b: bb } };

        // Something went wrong (almost nothing found): use the whole image.
        if (box.w < W * 0.08 || box.h < H * 0.08) return full;

        return box;
    } catch (e) {
        // Image from another site without CORS: pixels can't be read.
        console.warn("[Y Pushback] Can't read image pixels to crop it (CORS) — using the whole image.", e);
        return full;
    }
}

// Loads (once) and returns the cache slot for an image file name.
function getTexture(file) {
    const url = IMG + file;
    let slot = textureCache[url];
    if (slot) return slot;


    slot = textureCache[url] = { img: null, loaded: false, crop: null, failed: false };

    let triedWithoutCors = false;

    function load(useCors) {
        const img = new Image();
        if (useCors) img.crossOrigin = "anonymous";

        img.onload = function () {
            slot.img = img;
            slot.crop = computeCrop(img);

            slot.loaded = true;
            console.log("[Y Pushback] texture loaded:", file,
                img.naturalWidth + "x" + img.naturalHeight,
                "aircraft area:", slot.crop.w + "x" + slot.crop.h,
                slot.crop.cropped ? "(cropped)" : "(not cropped)");
        };


        img.onerror = function () {
            slot.loaded = false;
            // Retry without CORS: the image can still be drawn, just not cropped.
            if (!triedWithoutCors) {
                triedWithoutCors = true;
                load(false);
            } else {
                slot.failed = true;
                console.warn("[Y Pushback] texture failed to load:", file);
            }
        };

        img.src = url;
    }

    load(true);
    return slot;
}

// Is the sun below the horizon at the aircraft (in GeoFS's own clock)?
function isNight() {
    const now = performance.now();
    if (now - nightCache.t < 2000) return nightCache.value;

    let night = false;

    try {
        const C = window.Cesium;
        const viewer = geofs.api.viewer;
        const p = getPosition();
        const jd = viewer.clock.currentTime;


        const sunInertial =
            C.Simon1994PlanetaryPositions.computeSunPositionInEarthInertialFrame(jd);

        const m = C.Transforms.computeTemeToPseudoFixedMatrix(jd);
        const sun = C.Matrix3.multiplyByVector(m, sunInertial, new C.Cartesian3());
        C.Cartesian3.normalize(sun, sun);

        const up = C.Ellipsoid.WGS84.geodeticSurfaceNormal(
            C.Cartesian3.fromDegrees(p.lon, p.lat, 0),
            new C.Cartesian3()

        );

        night = C.Cartesian3.dot(sun, up) < NIGHT_SUN_THRESHOLD;
    } catch (e) {
        night = false;
    }


    nightCache = { t: now, value: night };
    return night;
}

// The day or night picture of the current aircraft: {img, crop} or null.
function currentTexture() {
    const spec = planeSpec();
    if (!spec) return null;

    const day = getTexture(spec.tex.day);
    const night = getTexture(spec.tex.night);

    const first = isNight() ? night : day;
    const second = isNight() ? day : night;

    if (first.loaded && first.img && first.img.naturalWidth > 0) return first;
    if (second.loaded && second.img && second.img.naturalWidth > 0) return second;
    return null;
}

// ============================================================
// SCREEN <-> GROUND
// ============================================================

function canvasRect() {
    return geofs.api.viewer.canvas.getBoundingClientRect();
}

function getGroundPoint(clientX, clientY) {
    const viewer = geofs.api.viewer;
    const Cesium = window.Cesium;


    try {
        const r = canvasRect();
        const pos = new Cesium.Cartesian2(clientX - r.left, clientY - r.top);

        let position = null;

        const ray = viewer.camera.getPickRay(pos);
        if (ray) position = viewer.scene.globe.pick(ray, viewer.scene);

        if (!position) {

            position = viewer.camera.pickEllipsoid(pos, Cesium.Ellipsoid.WGS84);
        }

        if (!position) return null;


        const c = Cesium.Cartographic.fromCartesian(position);
        return { lat: degrees(c.latitude), lon: degrees(c.longitude) };
    } catch (e) {
        console.error("[Y Pushback] Ground pick error:", e);
        return null;
    }
}

// Geo point -> screen pixels, using the real Cesium camera.
function getScreenPosition(point, alt) {
    if (!point) return null;

    if (alt === undefined) {
        alt = startPosition ? startPosition.alt : (getPosition() || {}).alt || 0;
    }

    try {
        const Cesium = window.Cesium;
        const viewer = geofs.api.viewer;

        const cart = Cesium.Cartesian3.fromDegrees(point.lon, point.lat, alt);

        // Ignore anything behind the camera.
        const cam = viewer.camera;
        const toPoint = Cesium.Cartesian3.subtract(cart, cam.positionWC, new Cesium.Cartesian3());
        if (Cesium.Cartesian3.dot(toPoint, cam.directionWC) <= 0) return null;

        const fn =
            Cesium.SceneTransforms.worldToWindowCoordinates ||
            Cesium.SceneTransforms.wgs84ToWindowCoordinates;

        const w = fn.call(Cesium.SceneTransforms, viewer.scene, cart);
        if (!w) return null;

        const r = canvasRect();

        return { x: w.x + r.left, y: w.y + r.top };
    } catch (e) {
        return null;
    }
}

// ============================================================
// BUILD ROUTE (chain of segments, one per stop)
// ============================================================


// One segment: from `o` (local metres) travelling along `heading`'s travel
// direction (backwards for pushback, forwards for pull), ending at `t`
// while travelling along `endHeading`'s travel direction.

// The path is: straight leg -> smooth curve -> straight run-in to the stop.
// Returns an array of local points, or null if the stop can't be reached.
function buildSegment(o, heading, t, endHeading) {
    const dx = t.x - o.x;
    const dy = t.y - o.y;

    if (Math.hypot(dx, dy) < 1) return null;

    const tr = travelDir(heading);
    const rearX = tr.x;
    const rearY = tr.y;

    const bearingToTarget = normalizeAngle(degrees(Math.atan2(dx, dy)));
    const angleFromRear = Math.abs(
        angleDifference(bearingToTarget, normalizeAngle(travelHeading(heading)))
    );

    if (angleFromRear > MAX_LATERAL_ANGLE) return null;

    // Straight mode: a plain straight line from o to t.
    if (straightMode) {
        const len = Math.hypot(dx, dy);
        const n = Math.max(2, Math.ceil(len / 2));
        const line = [];
        for (let i = 0; i <= n; i++) {
            line.push({ x: o.x + dx * i / n, y: o.y + dy * i / n });
        }
        return line;
    }

    // 1) a straight leg dead along the travel direction, 2) a smooth curve,
    // 3) a straight run-in lined up with the stop's heading.
    const rearProj = dx * rearX + dy * rearY;
    let straight = 0;

    if (rearProj > STRAIGHT_MIN_DISTANCE) {
        straight = clamp(rearProj * STRAIGHT_FRACTION, 0, STRAIGHT_MAX);

    }

    const S = { x: o.x + rearX * straight, y: o.y + rearY * straight };

    // The tug arrives travelling along ITS final heading's travel direction.
    const endTr = travelDir(endHeading);
    const endRearX = endTr.x;
    const endRearY = endTr.y;


    // The curve ends at E, a few metres before the stop; E -> stop is a straight run-in.
    const dTotal = Math.hypot(t.x - S.x, t.y - S.y);

    const endStraight = Math.min(END_STRAIGHT_M, dTotal * END_STRAIGHT_MAX_FRACTION);

    const E = { x: t.x - endRearX * endStraight, y: t.y - endRearY * endStraight };

    const d2 = Math.hypot(E.x - S.x, E.y - S.y);
    const k1 = clamp(d2 * 0.5, 8, 60);
    const k2 = clamp(d2 * 0.4, 7, 45);

    const c1 = { x: S.x + rearX * k1, y: S.y + rearY * k1 };
    const c2 = { x: E.x - endRearX * k2, y: E.y - endRearY * k2 };

    const pts = [];

    if (straight > 0) {
        const n = Math.max(2, Math.ceil(straight / 2));
        for (let i = 0; i < n; i++) {
            pts.push({
                x: o.x + rearX * straight * i / n,
                y: o.y + rearY * straight * i / n
            });
        }
    }

    const STEPS = 80;

    for (let i = 0; i <= STEPS; i++) {
        const u = i / STEPS;
        const mu = 1 - u;

        pts.push({
            x: mu * mu * mu * S.x + 3 * mu * mu * u * c1.x + 3 * mu * u * u * c2.x + u * u * u * E.x,
            y: mu * mu * mu * S.y + 3 * mu * mu * u * c1.y + 3 * mu * u * u * c2.y + u * u * u * E.y
        });
    }

    // Straight run-in from E to the stop.
    if (endStraight > 0.5) {
        const n = Math.max(2, Math.ceil(endStraight / 2));
        for (let i = 1; i <= n; i++) {

            pts.push({
                x: E.x + (t.x - E.x) * i / n,
                y: E.y + (t.y - E.y) * i / n
            });
        }
    }


    return pts;
}


// Builds the whole route through `list` (array of {lat, lon, heading}).
// On failure nothing is changed and false is returned.
function buildChain(list) {
    if (!startPosition) return false;

    const pts = [];
    const endIdx = [];

    let prev = { x: 0, y: 0 };
    let prevHeading = startHeading;

    for (let s = 0; s < list.length; s++) {
        const tl = geoToLocal(startPosition, list[s]);
        const seg = buildSegment(prev, prevHeading, tl, list[s].heading);

        if (!seg) return false;

        for (let i = pts.length ? 1 : 0; i < seg.length; i++) pts.push(seg[i]);

        endIdx.push(pts.length - 1);
        prev = tl;
        prevHeading = list[s].heading;
    }

    const lens = [0];
    let total = 0;

    for (let i = 1; i < pts.length; i++) {
        total += Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
        lens.push(total);
    }

    routePoints = pts;
    routeLengths = lens;
    routeTotalLength = total;
    stopEnds = endIdx.map(function (i) { return lens[i]; });

    return true;
}


// Rebuild the drawn route from the confirmed stops (+ the hover preview).
function rebuildRoute() {
    const list = stops.concat(preview ? [preview] : []);

    if (buildChain(list)) return true;


    // The preview can't be reached: drop it and keep the confirmed route.

    preview = null;
    buildChain(stops);
    return false;
}

function getRoutePointAtDistance(distanceAlong) {
    if (!routePoints.length) return null;

    distanceAlong = clamp(distanceAlong, 0, routeTotalLength);

    for (let i = 1; i < routeLengths.length; i++) {
        if (routeLengths[i] >= distanceAlong) {
            const previous = routeLengths[i - 1];
            const segment = routeLengths[i] - previous;
            const t = segment <= 0 ? 0 : (distanceAlong - previous) / segment;

            return {
                x: lerp(routePoints[i - 1].x, routePoints[i].x, t),
                y: lerp(routePoints[i - 1].y, routePoints[i].y, t)
            };
        }
    }

    return routePoints[routePoints.length - 1];
}

// Nearest point on the route, searched only around the progress made so far,
// so routes that pass close to themselves don't make the plane jump ahead.
function findNearestRouteDistance(localPosition) {
    if (!routePoints.length) return 0;

    // Projects the position onto the route line itself (not just onto its corner points),
    // so the progress along the route is continuous and the movement stays smooth.
    function search(lo, hi) {
        let best = Infinity;
        let bestDist = -1;

        for (let i = 1; i < routePoints.length; i++) {
            if (routeLengths[i] < lo || routeLengths[i - 1] > hi) continue;

            const ax = routePoints[i - 1].x, ay = routePoints[i - 1].y;
            const bx = routePoints[i].x, by = routePoints[i].y;
            const dx = bx - ax, dy = by - ay;
            const l2 = dx * dx + dy * dy;
            const t = l2 > 0 ? clamp(((localPosition.x - ax) * dx + (localPosition.y - ay) * dy) / l2, 0, 1) : 0;
            const px = ax + dx * t - localPosition.x;
            const py = ay + dy * t - localPosition.y;
            const d = px * px + py * py;

            if (d < best) {

                best = d;
                bestDist = routeLengths[i - 1] + (routeLengths[i] - routeLengths[i - 1]) * t;
            }
        }

        return bestDist;
    }

    let dist = search(routeProgress - 8, routeProgress + 60);

    if (dist < 0) dist = search(-Infinity, Infinity);

    return dist < 0 ? 0 : dist;
}

function getRouteTangent(distanceAlong) {
    const sample = 2;

    const a = getRoutePointAtDistance(Math.max(0, distanceAlong - sample));
    const b = getRoutePointAtDistance(Math.min(routeTotalLength, distanceAlong + sample));

    if (!a || !b) return { x: 0, y: 0 };

    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const len = Math.hypot(dx, dy);

    if (len < 0.001) return { x: 0, y: 0 };

    return { x: dx / len, y: dy / len };
}

// ============================================================
// COLLISION CHECK
// ============================================================
// Samples the scene height at points along the aircraft's footprint
// (fuselage, wings, tail). Anything clearly taller than the ground there
// (buildings, vehicles, other aircraft...) counts as a hit. The aircraft you
// are flying is ignored. Online aircraft are also checked by distance.

const collisionCache = {};
let collisionCount = 0;
let collisionBudgetEnd = 0;
let collisionWarn = false;
let collisionNoteShown = false;

function clearCollisionCache() {
    for (const k in collisionCache) delete collisionCache[k];
    collisionCount = 0;
}


function collisionSupported() {
    if (!COLLISION_CHECK) return false;

    try {

        const s = geofs.api.viewer.scene;
        return typeof s.sampleHeight === "function" && s.sampleHeightSupported !== false;
    } catch (e) {
        return false;

    }
}

// Points (geo) covering the aircraft's footprint at `center`, nose along `heading`.
function footprintPoints(center, heading, light) {
    const L = planeLength();
    const S = L * planeSpanRatio();
    const halfL = L / 2 + COLLISION_MARGIN_M;
    const halfS = S / 2 + COLLISION_MARGIN_M;

    const h = radians(heading);
    const sh = Math.sin(h);
    const ch = Math.cos(h);
    const pts = [];

    function add(fwd, right) {
        pts.push(localToGeo(center, { x: fwd * sh + right * ch, y: fwd * ch - right * sh }));
    }

    const fus = light ? 2 : 4;           // fuselage points per side of the centre
    for (let i = -fus; i <= fus; i++) add(i / fus * halfL, 0);

    for (let i = -2; i <= 2; i++) {      // wings
        if (i) add(L * 0.05, i / 2 * halfS);
    }

    if (!light) {                        // tailplane
        add(-L * 0.42, -S * 0.18);
        add(-L * 0.42, S * 0.18);
    }

    return pts;
}

function insideOwnFootprint(geo, own) {
    if (!own) return false;

    const l = geoToLocal(own.pos, geo);
    const h = radians(own.heading);

    const fwd = l.x * Math.sin(h) + l.y * Math.cos(h);
    const right = l.x * Math.cos(h) - l.y * Math.sin(h);
    const L = planeLength();

    if (Math.abs(fwd) < L / 2 + 3 && Math.abs(right) < L * planeSpanRatio() / 2 + 3) return true;

    // The pushback tug is part of "us" too (it is a tall 3D model that the

    // height check would otherwise mistake for an obstacle).
    if (tugActive && Math.hypot(fwd - tugNoseOffset, right) < TUG_CLEAR_RADIUS_M) return true;


    return false;
}

function pointBlocked(geo) {
    const C = window.Cesium;
    const scene = geofs.api.viewer.scene;
    const carto = C.Cartographic.fromDegrees(geo.lon, geo.lat);

    let top, ground;

    try { top = scene.sampleHeight(carto); } catch (e) { return false; }
    if (typeof top !== "number" || !isFinite(top)) return false;

    try { ground = scene.globe.getHeight(carto); } catch (e) {}
    if (typeof ground !== "number" || !isFinite(ground)) return false;

    return top - ground > COLLISION_OBSTACLE_HEIGHT_M;
}

// Another online aircraft close to `center`?
function multiplayerNear(center, own) {
    try {
        const users = window.multiplayer && multiplayer.visibleUsers;
        if (!users) return false;

        const list = Array.isArray(users) ? users : Object.values(users);
        const limit = planeLength() / 2 + COLLISION_MP_EXTRA_M;

        for (let i = 0; i < list.length; i++) {
            const u = list[i];
            const lla = u && ((u.referencePoint && u.referencePoint.lla) || u.coordinates ||
                (u.lastUpdate && u.lastUpdate.co));

            if (!Array.isArray(lla) || !Number.isFinite(lla[0]) || !Number.isFinite(lla[1])) continue;

            const p = { lat: lla[0], lon: lla[1] };

            if (own && distance(own.pos, p) < 3) continue;                       // that's us

            if (Number.isFinite(lla[2]) && own && Math.abs(lla[2] - own.pos.alt) > 30) continue;   // flying overhead

            if (distance(center, p) < limit) return true;
        }
    } catch (e) {}

    return false;
}


function evalPose(center, heading, light) {
    const p = getPosition();

    const own = p ? { pos: p, heading: getAircraftHeading() } : null;

    const hits = [];
    const pts = footprintPoints(center, heading, light);

    for (let i = 0; i < pts.length; i++) {
        if (insideOwnFootprint(pts[i], own)) continue;
        if (pointBlocked(pts[i])) hits.push(pts[i]);
    }

    return { hit: hits.length > 0 || multiplayerNear(center, own), hits: hits, t: performance.now() };
}

// Cached check. Results are refreshed after `ttl` ms, a little at a time so
// the game never stalls.
function getCollision(center, heading, ttl, light) {
    const key = center.lat.toFixed(6) + "," + center.lon.toFixed(6) + "," + Math.round(heading) + (light ? "L" : "F");
    const now = performance.now();
    const c = collisionCache[key];

    if (c && now - c.t < ttl) return c;
    if (now > collisionBudgetEnd) return c || null;

    if (collisionCount > 600) clearCollisionCache();

    const r = evalPose(center, heading, light);
    if (!collisionCache[key]) collisionCount++;
    collisionCache[key] = r;
    return r;
}

// Poses along the route where the aircraft would hit something.
function pathCollisions() {
    const out = [];
    if (routeTotalLength < 1) return out;

    for (let d = COLLISION_PATH_STEP_M; d < routeTotalLength; d += COLLISION_PATH_STEP_M) {

        if (pushing && d < routeProgress) continue;

        const lp = getRoutePointAtDistance(d);
        const t = getRouteTangent(d);
        if (!lp || (!t.x && !t.y)) continue;

        const center = localToGeo(startPosition, lp);
        const heading = noseHeadingForTravel(degrees(Math.atan2(t.x, t.y)));
        const c = getCollision(center, heading, 3000, true);

        if (c && c.hit) out.push({ center: center, heading: heading, hits: c.hits });

    }


    return out;
}

// Line through the aircraft along its heading: green ahead of the nose, red behind the tail.
function drawHeadingAxis(ctx, geo, alt, heading) {
    const L = planeLength();
    const h = radians(heading);
    const dir = { x: Math.sin(h), y: Math.cos(h) };

    function line(from, to, color) {
        const a = getScreenPosition(localToGeo(geo, { x: dir.x * from, y: dir.y * from }), alt);
        const b = getScreenPosition(localToGeo(geo, { x: dir.x * to, y: dir.y * to }), alt);
        if (!a || !b) return;

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.stroke();
    }

    ctx.save();
    ctx.globalAlpha = 0.9;
    line(L / 2, L / 2 + 80, COLOR_PLACED);       // ahead of the nose
    line(-L / 2, -L / 2 - 80, COLOR_BLOCKED);    // behind the tail
    ctx.restore();
}

function drawHitDots(ctx, hits, alt) {
    ctx.save();
    ctx.fillStyle = COLOR_BLOCKED;
    ctx.strokeStyle = "rgba(255,255,255,.9)";
    ctx.lineWidth = 1.5;


    hits.forEach(function (g) {
        const s = getScreenPosition(g, alt);
        if (!s) return;
        ctx.beginPath();
        ctx.arc(s.x, s.y, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
    });

    ctx.restore();
}

// ============================================================
// DRAWING
// ============================================================

function drawPlanner() {
    if (!plannerCtx || !plannerCanvas) return;
    if (plannerCanvas.style.display === "none") return;

    const ctx = plannerCtx;
    const width = window.innerWidth;
    const height = window.innerHeight;

    ctx.clearRect(0, 0, width, height);

    if (!startPosition) return;
    if (!overheadActive && !SHOW_OVERLAY_IN_FREE_CAMERA) return;

    if (routePoints.length) drawRoute(ctx);

    const items = [];

    stops.forEach(function (s, i) {
        if (pushing && i < stopIndex) return;   // already reached
        items.push({ s: s, n: i + 1, alpha: 0.85, ttl: 2500, state: "placed" });
    });

    if (preview) items.push({ s: preview, n: stops.length + 1, alpha: 0.9, ttl: 150, state: "placing" });

    const alt = startPosition.alt;
    const useCollision = collisionSupported();
    let warn = false;

    if (COLLISION_CHECK && !useCollision && !collisionNoteShown) {
        collisionNoteShown = true;
        console.warn("[Y Pushback] Collision check unavailable (scene.sampleHeight not supported).");
    }

    collisionBudgetEnd = performance.now() + COLLISION_FRAME_BUDGET_MS;


    // Route legs first (drawn underneath), stops get the check budget first.
    const results = items.map(function (item) {
        return useCollision ? getCollision(item.s, item.s.heading, item.ttl, false) : null;
    });

    if (useCollision && routePoints.length) {
        pathCollisions().forEach(function (p) {
            warn = true;
            drawGhostPlane(ctx, p.center, alt, p.heading, 0.3, "danger");
            drawHitDots(ctx, p.hits, alt);
        });
    }



    items.forEach(function (item, i) {
        const c = results[i];
        const danger = !!(c && c.hit);

        if (danger) {
            warn = true;
            drawHitDots(ctx, c.hits, alt);
        }

        if (item.state === "placing" && SHOW_HEADING_AXIS) drawHeadingAxis(ctx, item.s, alt, item.s.heading);

        const g = drawGhostPlane(ctx, item.s, alt, item.s.heading, item.alpha, danger ? "danger" : item.state);
        if (g) {
            const label = "STOP " + item.n + "  •  HDG " +
                Math.round(item.s.heading).toString().padStart(3, "0") + "°" +
                (danger ? "  •  BLOCKED" : "");
            drawTargetLabel(ctx, g.x, g.y, planeLength() * g.ppm, label, danger);
        }
    });

    if (warn !== collisionWarn) {
        collisionWarn = warn;
        updatePanel();
    }

    drawPlannerText(ctx, width, height);
}

// Draws a polyline given in local metres, skipping parts behind the camera.
function strokeLocalLine(ctx, localPts, color, width) {
    const segments = [];
    let cur = [];

    for (let i = 0; i < localPts.length; i++) {

        const sp = getScreenPosition(localToGeo(startPosition, localPts[i]));
        if (sp) {
            cur.push(sp);
        } else if (cur.length) {
            segments.push(cur);
            cur = [];
        }
    }
    if (cur.length) segments.push(cur);

    ctx.beginPath();
    segments.forEach(function (pts) {
        if (pts.length < 2) return;
        ctx.moveTo(pts[0].x, pts[0].y);

        for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);

    });

    ctx.lineWidth = width;
    ctx.strokeStyle = color;
    ctx.stroke();
}

// Blue centre line plus a purple line for each wingtip (the route shifted
// sideways by half the wingspan).
function drawRoute(ctx) {
    if (routePoints.length < 2) return;

    const half = planeLength() * planeSpanRatio() / 2;
    const left = [];
    const right = [];

    for (let i = 0; i < routePoints.length; i++) {
        const a = routePoints[Math.max(0, i - 1)];
        const b = routePoints[Math.min(routePoints.length - 1, i + 1)];
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const len = Math.hypot(dx, dy) || 1;

        // Unit vector to the right of the direction of travel.
        const nx = dy / len;
        const ny = -dx / len;
        const p = routePoints[i];

        right.push({ x: p.x + nx * half, y: p.y + ny * half });
        left.push({ x: p.x - nx * half, y: p.y - ny * half });
    }

    ctx.save();

    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    strokeLocalLine(ctx, left, COLOR_WINGTIP, 2);
    strokeLocalLine(ctx, right, COLOR_WINGTIP, 2);
    strokeLocalLine(ctx, routePoints, COLOR_ROUTE, 3);

    ctx.restore();
}

// The aircraft texture, true-to-scale, laid flat on the ground at the stop
// (projected through the real camera) and rotated to the stop's heading.
// Only the aircraft part of the image (empty margins cropped away) is used,
// and it is scaled so its length equals the real aircraft length.
// Copy of a texture coloured with `color` (keeps the aircraft's details), cached per colour.

function tintedTexture(tex, color) {
    tex.tints = tex.tints || {};

    if (tex.tints[color]) return tex.tints[color];

    const k = tex.crop;
    const c = document.createElement("canvas");
    c.width = k.w;
    c.height = k.h;

    const g = c.getContext("2d");
    g.drawImage(tex.img, k.x, k.y, k.w, k.h, 0, 0, k.w, k.h);

    // Pictures with a solid (non-transparent) background: remove the
    // background first so only the aircraft gets coloured, not a rectangle.
    if (k.bg) {
        try {
            const data = g.getImageData(0, 0, k.w, k.h);
            const d = data.data;
            for (let i = 0; i < d.length; i += 4) {
                if (Math.max(Math.abs(d[i] - k.bg.r), Math.abs(d[i + 1] - k.bg.g), Math.abs(d[i + 2] - k.bg.b)) <= CROP_COLOR_DIFF) d[i + 3] = 0;
            }
            g.putImageData(data, 0, 0);
        } catch (e) {}
    }

    g.globalCompositeOperation = "source-atop";
    g.globalAlpha = TEXTURE_TINT_ALPHA;
    g.fillStyle = color;
    g.fillRect(0, 0, k.w, k.h);

    // The drawings are thin lines that get shrunk a lot on screen, so they
    // turn faint and dotted. Draw the coloured copy slightly offset in all
    // directions to make the lines thicker (and the colour solid).

    let out = c;
    const r = TEXTURE_LINE_BOOST * Math.max(k.w, k.h) / 320;

    if (r > 0.4) {
        out = document.createElement("canvas");
        out.width = k.w;
        out.height = k.h;
        const o = out.getContext("2d");

        for (let ring = 1; ring >= 0.5; ring -= 0.5) {
            for (let a = 0; a < 8; a++) {
                const ang = a * Math.PI / 4;
                o.drawImage(c, Math.cos(ang) * r * ring, Math.sin(ang) * r * ring);
            }
        }
        o.drawImage(c, 0, 0);

    }

    tex.tints[color] = out;

    return out;
}

// state: "placing" (yellow), "placed" (green) or "danger" (red). Returns the screen position.
function drawGhostPlane(ctx, geo, alt, heading, alpha, state) {
    const danger = state === "danger";
    const c = getScreenPosition(geo, alt);
    const e = getScreenPosition(localToGeo(geo, { x: 10, y: 0 }), alt);
    const n = getScreenPosition(localToGeo(geo, { x: 0, y: 10 }), alt);

    if (!c || !e || !n) return null;

    const ex = { x: (e.x - c.x) / 10, y: (e.y - c.y) / 10 };
    const ny = { x: (n.x - c.x) / 10, y: (n.y - c.y) / 10 };

    const h = radians(heading);
    const sh = Math.sin(h);
    const ch = Math.cos(h);

    const tex = GHOST_STYLE === "texture" ? currentTexture() : null;
    const outline = !tex;

    const nose = planeNose();
    const lengthIsWidth = !!tex && (nose === 90 || nose === 270);

    // Length of the aircraft in image pixels (cropped area only).
    let unitsLen;
    if (outline) unitsLen = 1000;
    else if (tex) unitsLen = lengthIsWidth ? tex.crop.w : tex.crop.h;

    else unitsLen = 120;

    const m = planeLength() / unitsLen;

    const uX = m * ch,  uY = -m * sh;
    const vX = -m * sh, vY = -m * ch;

    ctx.save();

    ctx.transform(
        uX * ex.x + uY * ny.x,
        uX * ex.y + uY * ny.y,
        vX * ex.x + vY * ny.x,
        vX * ex.y + vY * ny.y,
        c.x,
        c.y
    );


    ctx.translate(0, -(PLANE_PIVOT_FROM_NOSE - 0.5) * unitsLen);

    ctx.globalAlpha = alpha === undefined ? 0.85 : alpha;

    ctx.shadowBlur = 0;

    if (outline) {
        ctx.globalAlpha = (alpha !== undefined && alpha < 0.5) ? 0.5 : 1;
        const color = danger ? COLOR_BLOCKED : (state === "placed" ? COLOR_PLACED : COLOR_PLACING);
        drawOutlineAircraft(ctx, color, planeSpanRatio(), 2.5 / (m * Math.hypot(ex.x, ex.y)));
    } else if (tex) {
        const k = tex.crop;
        ctx.rotate(radians(-nose));
        const color = danger ? COLOR_BLOCKED : (state === "placed" ? COLOR_PLACED : COLOR_PLACING);
        ctx.drawImage(tintedTexture(tex, color), 0, 0, k.w, k.h, -k.w / 2, -k.h / 2, k.w, k.h);
    } else {
        drawFallbackAircraft(ctx, danger);
    }

    ctx.restore();

    return { x: c.x, y: c.y, ppm: Math.hypot(ex.x, ex.y) };
}

// Flat outline of an airliner, nose up, 1000 units long, centred on (0,0).
// `lw` = line width in these units (so it stays ~2.5 screen pixels).
function drawOutlineAircraft(ctx, color, spanRatio, lw) {
    const k = spanRatio / 0.9;            // 1 = a typical airliner
    const wx = function (x) { return x * k; };

    // Right half, from the nose back to the tail.

    const R = [
        [45, -370],
        [45, -110],
        [wx(450), 70],
        [wx(440), 122],
        [45, 150],
        [45, 350],
        [180, 440],
        [175, 480],
        [22, 462],
        [10, 500]
    ];

    ctx.save();
    ctx.lineJoin = "round";
    ctx.lineWidth = lw;
    ctx.strokeStyle = color;


    ctx.beginPath();
    ctx.moveTo(0, -500);
    ctx.quadraticCurveTo(45, -470, R[0][0], R[0][1]);
    for (let i = 1; i < R.length; i++) ctx.lineTo(R[i][0], R[i][1]);
    for (let i = R.length - 1; i >= 0; i--) ctx.lineTo(-R[i][0], R[i][1]);

    ctx.quadraticCurveTo(-45, -470, 0, -500);
    ctx.closePath();

    ctx.save();
    ctx.globalAlpha *= OUTLINE_FILL_ALPHA;
    ctx.fillStyle = color;
    ctx.fill();
    ctx.restore();
    ctx.stroke();

    // Engines
    ctx.beginPath();
    ctx.rect(wx(95), -150, 62, 115);
    ctx.rect(-wx(95) - 62, -150, 62, 115);
    ctx.stroke();

    ctx.restore();
}

function drawFallbackAircraft(ctx, danger) {
    ctx.save();

    ctx.fillStyle = danger ? "rgba(255,50,50,.95)" : "rgba(230,235,240,.95)";
    ctx.strokeStyle = "rgba(20,25,30,.95)";
    ctx.lineWidth = 2;


    function poly(points) {
        ctx.beginPath();
        ctx.moveTo(points[0][0], points[0][1]);
        for (let i = 1; i < points.length; i++) ctx.lineTo(points[i][0], points[i][1]);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
    }

    ctx.beginPath();
    ctx.moveTo(0, -58);
    ctx.quadraticCurveTo(8, -30, 7, 30);
    ctx.quadraticCurveTo(6, 53, 0, 61);
    ctx.quadraticCurveTo(-6, 53, -7, 30);
    ctx.quadraticCurveTo(-8, -30, 0, -58);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();


    poly([[-7, -2], [-52, 17], [-55, 25], [-7, 17]]);
    poly([[7, -2], [52, 17], [55, 25], [7, 17]]);
    poly([[-6, 43], [-28, 54], [-25, 61], [0, 52]]);
    poly([[6, 43], [28, 54], [25, 61], [0, 52]]);


    ctx.restore();
}

function drawTargetLabel(ctx, x, y, planeLengthPx, label, danger) {
    ctx.save();

    const r = Math.max(14, planeLengthPx * 0.5);

    ctx.font = "bold 13px Arial";
    ctx.textAlign = "center";
    ctx.lineJoin = "round";
    ctx.lineWidth = 4;
    ctx.strokeStyle = "rgba(0,0,0,.7)";
    ctx.fillStyle = danger ? "#ff6b6b" : "white";
    ctx.strokeText(label, x, y + r + 18);
    ctx.fillText(label, x, y + r + 18);

    ctx.restore();
}

function drawPlannerText(ctx, width, height) {
    ctx.save();
    ctx.textAlign = "center";

    ctx.lineJoin = "round";
    ctx.lineWidth = 4;
    ctx.strokeStyle = "rgba(0,0,0,.7)";

    function text(str, y, font, fill) {
        ctx.font = font;
        ctx.fillStyle = fill;
        ctx.strokeText(str, width / 2, y);
        ctx.fillText(str, width / 2, y);
    }

    if (selecting) {
        text("CLICK TO ADD STOPS " + sideWord() + " THE AIRCRAFT — THEN PRESS READY  (" + modeName() + ")", height - 55,
            "bold 13px Arial", "rgba(255,255,255,.95)");
        text("Wheel = rotate (Shift = fine)  •  Ctrl+wheel or [ ] = zoom  •  +/- = speed  •  N = stops/nonstop  •  , . = wait  •  S = save  •  Z / right-click = undo  •  R = reset heading  •  L = straight line  •  Enter = ready  •  Esc = cancel", height - 34,
            "11px Arial", "rgba(255,255,255,.8)");
    } else if (stops.length || pushing) {
        text(modeName() + " ROUTE", height - 55, "bold 15px Arial", "rgba(255,255,255,.95)");
        text(TOGGLE_VIEW_KEY.toUpperCase() + " = next camera  •  1-8 = pick camera  •  +/- = speed  •  N = stops/nonstop  •  , . = wait  •  Esc = stop", height - 34,
            "12px Arial", "rgba(255,255,255,.8)");

    }

    if (collisionWarn) {
        text("⚠ POSSIBLE COLLISION — SOMETHING IS IN THE WAY (RED)", 100, "bold 18px Arial", "#ff6b6b");
    }

    // North indicator.

    ctx.textAlign = "center";
    ctx.font = "bold 16px Arial";
    ctx.fillStyle = "rgba(255,255,255,.9)";
    ctx.strokeText("N", width - 35, 35);
    ctx.fillText("N", width - 35, 35);
    ctx.beginPath();
    ctx.moveTo(width - 35, 42);
    ctx.lineTo(width - 35, 62);
    ctx.strokeStyle = "rgba(255,255,255,.8)";
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.restore();
}

// ============================================================
// MOUSE / STOP EDITING
// ============================================================

// Shared by hover + click. Sets the hover preview; true when it is reachable.
function planFromPoint(point) {

    if (!point || !startPosition) return false;

    const base = stops.length ? stops[stops.length - 1] : startPosition;
    const where = stops.length ? "THE LAST STOP" : "THE AIRCRAFT";

    if (distance(base, point) > MAX_PLANNER_DISTANCE) {
        preview = null;
        rebuildRoute();
        notify("TOO FAR — MAX " + MAX_PLANNER_DISTANCE + " m FROM " + where);
        return false;
    }

    preview = {
        lat: point.lat,
        lon: point.lon,
        heading: straightMode ? lineHeading(base, point) : finalHeading
    };

    if (!rebuildRoute()) {
        notify("CAN'T REACH THERE — MOVE CURSOR " + sideWord() + " " + where);
        return false;

    }

    return true;
}

function plannerMouseMove(event) {
    if (!selecting) return;


    const point = getGroundPoint(event.clientX, event.clientY);
    if (!point) return;

    if (planFromPoint(point)) {
        notify("STOP " + (stops.length + 1) + " PREVIEW — CLICK TO ADD");
        updateDistanceUI(routeTotalLength);
        updateHeadingUI();
    }
}

// Click = confirm the stop under the cursor and keep planning.
function plannerClick(event) {
    if (!selecting) return;

    const point = getGroundPoint(event.clientX, event.clientY);

    if (!point) {
        notify("GROUND NOT FOUND — TRY AGAIN");
        return;

    }

    if (!planFromPoint(point)) return;

    stops.push({ lat: preview.lat, lon: preview.lon, heading: preview.heading });
    if (straightMode) finalHeading = preview.heading;
    preview = null;
    rebuildRoute();

    notify("STOP " + stops.length + " ADDED — CLICK FOR ANOTHER, OR PRESS READY");
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
    updatePanel();
}

function undoStop() {
    if (!selecting || !stops.length) return;

    stops.pop();
    preview = null;

    finalHeading = stops.length ? stops[stops.length - 1].heading : startHeading;


    rebuildRoute();
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
    updatePanel();

    notify(stops.length ? stops.length + " STOP(S) LEFT" : "ALL STOPS REMOVED — CLICK " + sideWord() + " THE AIRCRAFT");
}


function clearStops() {
    if (!selecting) return;

    stops = [];
    preview = null;
    finalHeading = startHeading;

    rebuildRoute();
    updateDistanceUI(0);
    updateHeadingUI();
    updatePanel();

    notify("ALL STOPS REMOVED — CLICK " + sideWord() + " THE AIRCRAFT");
}

// The READY button: lock the plan in and start moving.
function confirmReady() {

    if (!selecting) return;

    if (!stops.length) {
        notify("ADD AT LEAST ONE STOP FIRST");
        return;
    }

    selecting = false;
    preview = null;
    rebuildRoute();

    if (plannerCanvas) plannerCanvas.style.cursor = "default";

    notify("READY — STARTING " + modeName());
    updateDistanceUI(routeTotalLength);
    updatePanel();

    setTimeout(beginMovement, 300);
}

// ============================================================
// START PLANNING MODE
// ============================================================


// forward = false: push back (Y).  forward = true: pull forward (T).
function startPushbackMode(forward) {
    if (!ready) {
        notify("GeoFS IS STILL LOADING...");
        return;
    }

    if (inMotion()) { stopPushback(); return; }
    if (selecting) { cancelSelection(); return; }


    enterPlanning(!!forward);
}

// Sets up the top-down planner from the aircraft's current position.
function enterPlanning(forward) {
    const current = getPosition();
    if (!current) {
        notify("AIRCRAFT POSITION NOT FOUND");
        return;
    }

    closeSaved();

    if (finishTimer) { clearTimeout(finishTimer); finishTimer = null; }

    removeTug();

    towForward = forward;
    clearCollisionCache();
    collisionWarn = false;

    startPosition = current;
    startHeading = getAircraftHeading();
    finalHeading = startHeading;
    resetYawControl();

    stops = [];
    preview = null;
    stopEnds = [];
    routePoints = [];
    routeLengths = [];
    routeTotalLength = 0;

    selecting = true;

    if (!oldCamera) saveCamera();

    cameraMode = "top";
    cameraHeight = CAMERA_HEIGHT_DEFAULT;

    overheadActive = true;
    orbitActive = false;
    mountActive = false;
    overlayActive = true;
    applyOverheadCamera();

    plannerCanvas.style.cursor = "crosshair";
    plannerCanvas.style.pointerEvents = "auto";
    showPlanner();

    notify("CLICK " + sideWord() + " THE AIRCRAFT TO ADD A STOP  —  " + planeLabel());

    updateHeadingUI();
    updatePanel();
}

// ============================================================
// MOVEMENT
// ============================================================

function beginMovement() {
    const a = aircraft();

    if (!a || !a.rigidBody || typeof a.rigidBody.setLinearVelocity !== "function") {
        notify("ERROR: AIRCRAFT PHYSICS NOT FOUND");

        console.error("[Y Pushback] rigidBody.setLinearVelocity unavailable.");
        return;
    }

    if (!stops.length || routePoints.length < 2) {
        notify("NO VALID ROUTE");
        return;
    }

    pushing = true;
    addTug();
    resetCameraSmoothing();
    if (tugPhase === "approach") lockAircraft();
    else releaseBrakes();
    smoothVel = { x: 0, y: 0 };
    smoothTarget = null;
    smoothYawRate = 0;
    currentSpeed = 0;
    measuredSpeed = 0;
    lastMoveSample = null;
    stallFrames = 0;
    stallWarned = false;
    yawHoldUntil = 0;
    frameErrors = 0;
    lastFrameT = 0;
    routeProgress = 0;

    stopIndex = 0;
    pauseUntil = 0;

    // Chase camera while moving; buttons / V / 1-8 switch angle.
    releaseToFreeCamera();
    notify(modeName() + " ACTIVE — " + stops.length + (stops.length === 1 ? " STOP" : " STOPS") +
        (nonstopMode ? " (NONSTOP)" : ""));
    updatePanel();
}

// Fastest the aircraft may turn (rad/s): the nose gear is dragged sideways by (turn rate x distance to the nose gear),
// so a long aircraft has to turn more slowly than a short one.
function maxYawRate() {
    const wheelbase = tugActive ? clamp(tugNoseOffset + planeLength() * 0.1, 12, planeLength() * 0.7) : Math.max(12, planeLength() * 0.44);
    return clamp(NOSE_SCRUB_SPEED_MS / wheelbase, 0.02, MAX_YAW_RATE);
}

// Speed limit for the bends ahead on the route, so the aircraft slows down for tight turns
// (turn rate = speed / radius must stay below the allowed turn rate).
function curveSpeedLimit(from, window) {
    let limit = Infinity;
    const w = maxYawRate();


    for (let d = 0; d <= window; d += 3) {
        const t0 = getRouteTangent(Math.min(routeTotalLength, from + d));
        const t1 = getRouteTangent(Math.min(routeTotalLength, from + d + 4));
        const ang = Math.acos(clamp(t0.x * t1.x + t0.y * t1.y, -1, 1));   // direction change over 4 m
        const k = ang / 4;                                                  // curvature (1 / radius)

        if (k > 0.004) limit = Math.min(limit, w / k);
    }

    return limit;
}

// Runs from the render loop, so it must never throw.
function updatePushback() {
    try {

        updatePushbackInner();
        frameErrors = 0;
    } catch (e) {
        console.error("[Y Pushback] frame error:", e);

        if (++frameErrors > 30) {
            stopPushback();
            notify("STOPPED — SCRIPT ERROR (see console)");
            setTimeout(hideUI, 5000);
        }
    }
}

function updatePushbackInner() {
    if (!pushing || !stops.length || !routePoints.length) return;

    // Tug is still driving in / hooking up: the aircraft waits (see updateTugSequence).
    if (tugPhase !== "none" && tugPhase !== "push") return;

    releaseBrakes();

    const a = aircraft();
    if (!a || !a.rigidBody) { stopPushback(); return; }

    const current = getPosition();
    if (!current) return;

    const nowT = performance.now();
    const dt = clamp((nowT - (lastFrameT || nowT)) / 1000, 0.001, 0.1);
    lastFrameT = nowT;

    updateTugSteer(dt);

    // Measured ground speed.

    if (lastMoveSample) {
        const mdt = (nowT - lastMoveSample.t) / 1000;
        if (mdt > 0.001) {

            measuredSpeed = lerp(measuredSpeed, distance(lastMoveSample.p, current) / mdt, 0.1);
        }
    }
    lastMoveSample = { p: current, t: nowT };

    const last = stops.length - 1;
    const finalStop = stops[last];

    const localCurrent = geoToLocal(startPosition, current);
    const routeDistance = findNearestRouteDistance(localCurrent);
    routeProgress = Math.max(routeProgress, routeDistance);

    if (nowT - uiLastT > 250) {
        uiLastT = nowT;
        updateDistanceUI(Math.max(0, routeTotalLength - routeProgress));
        updateHeadingUI();
    }

    // Waiting at an intermediate stop.
    if (nowT < pauseUntil) {
        driveVelocity(0, 0, dt);
        currentSpeed = 0;
        stallFrames = 0;
        applyYaw(stops[Math.max(0, stopIndex - 1)].heading, dt);
        return;
    }

    // Reached the stop we are heading to?
    let remToStop = stopEnds[stopIndex] - routeProgress;

    if (
        remToStop <= STOP_DISTANCE ||
        (stopIndex === last && distance(current, finalStop) <= STOP_DISTANCE)
    ) {
        if (stopIndex >= last) { finishPushback(); return; }

        stopIndex++;

        if (nonstopMode) {
            // Nonstop: drive straight through, no pause.
            notify("PASSING STOP " + stopIndex + " — NONSTOP");
            remToStop = stopEnds[stopIndex] - routeProgress;
        } else if (waitSeconds > 0) {
            pauseUntil = nowT + waitSeconds * 1000;
            notify("STOP " + stopIndex + " REACHED — WAITING " + waitSeconds + " s");
            driveVelocity(0, 0, dt);

            currentSpeed = 0;
            return;
        } else {
            // Stops mode with 0 s wait: no pause, carry on.
            notify("STOP " + stopIndex + " REACHED");
            remToStop = stopEnds[stopIndex] - routeProgress;
        }
    }

    // "Is it actually moving?" check.
    if (currentSpeed > 0.8 && measuredSpeed < 0.1) stallFrames++;
    else stallFrames = 0;

    if (stallFrames > 150) {
        // Stuck (usually dragging the nose wheel sideways in a turn): ease off the turn and roll straight for a moment.
        stallFrames = 0;
        stallWarned = true;
        yawHoldUntil = nowT + 3000;
        releaseBrakes();
        notify("AIRCRAFT STUCK — EASING OFF THE TURN, THEN CONTINUING");

        let pb = "?";
        try { pb = String(window.controls && controls.parkingBrake) + " / " + String(geofs.animation.values.parkingBrake); } catch (e) {}
        console.warn("[Y Pushback] Commanded", currentSpeed.toFixed(2), "m/s but measured", measuredSpeed.toFixed(2),
            "| heading", getAircraftHeading().toFixed(0), "| parking brake (controls / animation):", pb,
            "| allowed turn rate", degrees(maxYawRate()).toFixed(1), "deg/s");
    }

    const tangent = getRouteTangent(routeProgress);

    if (Math.abs(tangent.x) < 0.001 && Math.abs(tangent.y) < 0.001) {
        finishPushback();
        return;
    }

    // Smooth braking: speed follows v = sqrt(2 * a * distance) so the aircraft
    // eases to a gentle stop at every stop, whatever the chosen speed.
    // In nonstop mode only the LAST stop is braked for.
    let desiredSpeed = speedSetting;
    const brakeDist = (nonstopMode && stopIndex < last) ? (routeTotalLength - routeProgress) : remToStop;
    const brakeSpeed = Math.sqrt(2 * BRAKE_DECEL * Math.max(0, brakeDist - STOP_DISTANCE));


    desiredSpeed = Math.min(desiredSpeed, Math.max(CREEP_SPEED, brakeSpeed));

    // Slow down for tight bends (starts early enough to brake gently).
    const curveLimit = curveSpeedLimit(routeProgress, currentSpeed * currentSpeed / (2 * DECELERATION) + 8);
    desiredSpeed = Math.min(desiredSpeed, Math.max(CREEP_SPEED, curveLimit));

    desiredSpeed = clamp(desiredSpeed, Math.min(CREEP_SPEED, speedSetting), SPEED_MAX);


    if (currentSpeed < desiredSpeed) {
        currentSpeed = Math.min(desiredSpeed, currentSpeed + ACCELERATION * dt);
    } else {
        currentSpeed = Math.max(desiredSpeed, currentSpeed - DECELERATION * dt);
    }

    // Pure pursuit: aim at a point a few metres ahead ON the route.
    let dirX = tangent.x;
    let dirY = tangent.y;

    const aim = getRoutePointAtDistance(
        Math.min(routeTotalLength, routeProgress + Math.max(PURSUIT_LOOKAHEAD_M, currentSpeed * PURSUIT_SPEED_FACTOR))
    );

    if (aim) {
        const ax = aim.x - localCurrent.x;
        const ay = aim.y - localCurrent.y;
        const al = Math.hypot(ax, ay);

        if (al > 0.5) {
            dirX = ax / al;
            dirY = ay / al;
        }
    }

    let vx = dirX * currentSpeed;
    let vy = dirY * currentSpeed;

    // Keep the motion generally in the travel direction (backward for pushback,
    // forward for pull) relative to the nose.
    const tr = travelDir(getAircraftHeading());

    const rearX = tr.x;
    const rearY = tr.y;

    if (vx * rearX + vy * rearY < -0.2) {
        vx = lerp(vx, rearX * currentSpeed, 0.65);
        vy = lerp(vy, rearY * currentSpeed, 0.65);
    }

    // Move mostly along the fuselage, like a real pushback: the wheels roll instead of scrubbing sideways.
    if (BODY_AXIS_BLEND > 0) {
        vx = lerp(vx, rearX * currentSpeed, BODY_AXIS_BLEND);
        vy = lerp(vy, rearY * currentSpeed, BODY_AXIS_BLEND);
    }

    if (!isFinite(vx) || !isFinite(vy)) return;

    driveVelocity(vx, vy, dt);


    // The nose points along (pull) or opposite to (push) the direction of
    // travel; the last metres before a stop use the heading chosen for that stop
    // (not at intermediate stops in nonstop mode, so the nose never snaps).
    let desiredHeading = stops[stopIndex].heading;


    if (remToStop > 3 || (nonstopMode && stopIndex < last)) {
        const ahead = getRouteTangent(
            Math.min(routeTotalLength, routeProgress + YAW_LOOKAHEAD_M)
        );
        let bearing = degrees(Math.atan2(ahead.x, ahead.y));

        // Beside the route? Turn the nose a little back towards it (the aircraft rolls along its own fuselage,
        // so this is the only way it gets back onto the line - no sideways skidding / drifting).
        const onRoute = getRoutePointAtDistance(routeProgress);
        if (onRoute && CROSS_TRACK_GAIN > 0) {
            const sideErr = (localCurrent.x - onRoute.x) * tangent.y - (localCurrent.y - onRoute.y) * tangent.x;   // + = right of the route
            bearing -= clamp(degrees(Math.atan2(CROSS_TRACK_GAIN * sideErr, currentSpeed + 1)), -25, 25);
        }

        desiredHeading = noseHeadingForTravel(bearing);
    }

    applyYaw(desiredHeading, dt);
}

// ------------------------------------------------------------
// YAW — turns the aircraft so its nose follows the route.
// ------------------------------------------------------------

// GeoFS 3.9 and 4.0 accept yaw commands differently, so several methods are
// tried in turn. The first one that really turns the aircraft is kept.
const YAW_METHODS = ["angular velocity", "angular velocity property", "torque", "direct heading"];
let yawMethod = 0;
let yawLocked = false;
let yawNoResp = 0;
let yawGoodFrames = 0;
let yawCycles = 0;
let yawDiagDone = false;
let yawLastProbe = null;
let measuredOmega = 0;

function resetYawControl() {
    yawSign = 1;
    yawLastHeading = null;
    yawLastProbe = null;
    yawLastErr = 0;
    yawBadFrames = 0;
    yawIdleFrames = 0;


    yawNoResp = 0;
    yawGoodFrames = 0;
    measuredOmega = 0;
    yawWarned = false;
    // yawMethod / yawLocked are kept on purpose: a method that worked keeps being used.
}

// Heading from every source we know (so one stale source can't fool the check).
function headingProbes() {
    const out = [getAircraftHeading()];
    try {
        const a = aircraft();
        if (Array.isArray(a.htr) && typeof a.htr[0] === "number") {
            let h = a.htr[0];
            if (Math.abs(h) <= Math.PI * 2.5) h = h * 180 / Math.PI;
            out.push(normalizeAngle(h));

        }
    } catch (e) {}
    return out;
}

// Prints what this GeoFS build offers, so unknown builds can be diagnosed.
function dumpYawDiag() {
    if (yawDiagDone) return;
    yawDiagDone = true;

    try {
        const a = aircraft();
        const rb = a.rigidBody;
        const names = [];
        let p = Object.getPrototypeOf(rb);
        while (p && p !== Object.prototype) {
            Array.prototype.push.apply(names, Object.getOwnPropertyNames(p));
            p = Object.getPrototypeOf(p);
        }
        console.log("[Y Pushback] DIAG GeoFS version:", geofs.version);
        console.log("[Y Pushback] DIAG rigidBody properties:", Object.keys(rb).join(", "));
        console.log("[Y Pushback] DIAG rigidBody methods:", names.join(", "));
        console.log("[Y Pushback] DIAG aircraft properties:", Object.keys(a).join(", "));
        console.log("[Y Pushback] DIAG htr:", JSON.stringify(a.htr),
            "heading360:", geofs.animation && geofs.animation.values && geofs.animation.values.heading360);
    } catch (e) {
        console.warn("[Y Pushback] DIAG failed:", e);
    }
}
window.ypbDiag = function () { yawDiagDone = false; dumpYawDiag(); };

function advanceYawMethod(reason) {

    dumpYawDiag();


    yawMethod = (yawMethod + 1) % YAW_METHODS.length;
    if (yawMethod === 0) yawCycles++;

    yawNoResp = 0;
    yawBadFrames = 0;
    yawGoodFrames = 0;
    yawLastProbe = null;

    console.log("[Y Pushback] Yaw: " + reason + " -> trying method \"" + YAW_METHODS[yawMethod] + "\"");
}

// rate = rad/s as sent to the aircraft (already multiplied by yawSign).
function setYawRate(rate, dt) {
    if (!isFinite(rate)) rate = 0;

    const a = aircraft();

    if (!a || !a.rigidBody) return false;

    const rb = a.rigidBody;

    // Always make sure a "stop" really stops the spinning.
    if (rate === 0) {
        try { if (typeof rb.setAngularVelocity === "function") rb.setAngularVelocity([0, 0, 0]); } catch (e) {}
    }

    try {
        switch (yawMethod) {
            case 0:
                if (typeof rb.setAngularVelocity !== "function") return false;
                rb.setAngularVelocity([0, 0, rate]);
                return true;

            case 1: {
                let ok = false;
                ["angularVelocity", "v_angularVelocity", "rotationSpeed"].forEach(function (k) {
                    const v = rb[k];
                    if (Array.isArray(v) && v.length >= 3) {
                        v[0] = 0; v[1] = 0; v[2] = rate;
                        ok = true;
                    } else if (v && typeof v === "object" && typeof v.z === "number") {
                        v.x = 0; v.y = 0; v.z = rate;
                        ok = true;
                    }
                });
                return ok;
            }


            case 2: {

                const fn = rb.applyTorque || rb.applyTorqueLocal;
                if (typeof fn !== "function") return false;

                const mass = Number(rb.mass) || 60000;
                const inertia = mass * planeLength() * planeLength() / 12;

                let torque = (rate - measuredOmega) * inertia * 2;
                const lim = inertia * 0.4;
                torque = clamp(torque, -lim, lim);
                if (Math.abs(measuredOmega) > 0.5) torque = 0;   // safety: never spin up

                fn.call(rb, [0, 0, torque]);
                return true;
            }

            case 3: {
                // Last resort: write the heading ourselves.
                if (!Array.isArray(a.htr) || typeof a.htr[0] !== "number" || !dt) return false;


                const cur = getAircraftHeading();
                const hv = a.htr[0];
                const isRad = Math.abs(normalizeAngle(degrees(hv)) - cur) < Math.abs(normalizeAngle(hv) - cur);
                const next = normalizeAngle(cur + degrees(rate * yawSign) * dt);

                a.htr[0] = isRad ? radians(next) : next;
                return true;
            }
        }
    } catch (e) {
        console.error("[Y Pushback] yaw method \"" + YAW_METHODS[yawMethod] + "\" failed:", e);
    }

    return false;
}

function applyYaw(desiredHeading, dt) {
    const h = getAircraftHeading();
    dt = dt > 0 ? dt : 0.016;

    // Blend the wanted heading so the nose never snaps to a new direction.
    if (smoothTarget === null) smoothTarget = h;
    smoothTarget = normalizeAngle(
        smoothTarget + angleDifference(desiredHeading, smoothTarget) * (1 - Math.exp(-dt / YAW_TARGET_SMOOTH_S))
    );

    const err = angleDifference(smoothTarget, h);


    // ---- Did the last command make the aircraft turn? ----
    const probes = headingProbes();


    if (yawLastProbe && Math.abs(yawLastErr) > 4) {
        let dh = 0;

        for (let i = 0; i < probes.length && i < yawLastProbe.length; i++) {
            const d = angleDifference(probes[i], yawLastProbe[i]);
            if (Math.abs(d) > 0.01) { dh = d; break; }
        }

        if (dh !== 0) {
            yawNoResp = 0;
            measuredOmega = yawSign * radians(dh) / dt;

            if (Math.sign(dh) !== Math.sign(yawLastErr)) {
                yawBadFrames++;
                yawGoodFrames = 0;
            } else {
                yawBadFrames = Math.max(0, yawBadFrames - 1);
                if (++yawGoodFrames >= 30 && !yawLocked) {

                    yawLocked = true;
                    console.log("[Y Pushback] Yaw method \"" + YAW_METHODS[yawMethod] + "\" works — keeping it.");
                }
            }

            if (yawBadFrames >= 12) {
                yawSign = -yawSign;
                yawBadFrames = 0;
                console.log("[Y Pushback] Yaw direction flipped.");
            }
        } else if (!yawLocked && ++yawNoResp > 45) {
            advanceYawMethod("no response");

            if (yawCycles >= 2 && !yawWarned) {
                yawWarned = true;
                notify("ACTIVE — AIRCRAFT WON'T ROTATE ON THIS GeoFS BUILD (see console)");
                console.warn("[Y Pushback] No yaw method turned the aircraft. Run ypbDiag() in the console and send the output.");
            }
        }
    }

    yawLastHeading = h;
    yawLastProbe = probes;
    yawLastErr = err;

    const yawCap = maxYawRate();

    let rate = clamp(radians(err) * YAW_GAIN, -yawCap, yawCap);

    // The turning rate itself changes gradually (no sudden twitch of the nose).
    const maxStep = MAX_YAW_ACCEL * dt;
    rate = clamp(rate, smoothYawRate - maxStep, smoothYawRate + maxStep);

    smoothYawRate = rate;

    // Recovery: after getting stuck, stop turning for a moment and just roll straight.
    if (performance.now() < yawHoldUntil) rate = 0;

    // Method unavailable on this build: skip straight to the next one.
    if (!setYawRate(rate * yawSign, dt) && !yawLocked) {
        advanceYawMethod("method not available");
    }
}

// Sends a velocity to the aircraft, blended over VELOCITY_SMOOTH_S so speed and
// direction never jump from one frame to the next.
function driveVelocity(tx, ty, dt) {
    const k = 1 - Math.exp(-dt / VELOCITY_SMOOTH_S);
    smoothVel.x += (tx - smoothVel.x) * k;
    smoothVel.y += (ty - smoothVel.y) * k;
    setVelocity(smoothVel.x, smoothVel.y);
}

function setVelocity(x, y) {
    const a = aircraft();
    if (!a || !a.rigidBody) return;


    try {
        a.rigidBody.setLinearVelocity([x, y, 0]);
    } catch (e) {
        console.error("[Y Pushback] setLinearVelocity failed:", e);
    }
}

// ============================================================
// FINISH / STOP / CANCEL
// ============================================================

// While moving: switch from the planner to the chase camera.
function releaseToFreeCamera() {
    if (plannerCanvas) {
        plannerCanvas.style.pointerEvents = "none";
        plannerCanvas.style.cursor = "default";
    }
    document.body.style.cursor = "default";


    setCameraMode("chase");
}

function leaveTopView() {
    removeTug();
    overlayActive = false;
    hidePlanner();
    restoreCamera();
    document.body.style.cursor = "default";

    hideUI();
    updatePanel();
}

function finishPushback() {
    setVelocity(0, 0);
    setYawRate(0);
    if (AUTO_PARKING_BRAKE) setParkingBrake();

    pushing = false;
    currentSpeed = 0;
    lastFrameT = 0;

    notify(modeName() + " COMPLETE" + (AUTO_PARKING_BRAKE ? " — PARKING BRAKE SET" : ""));
    updateDistanceUI(0);

    if (tugActive && tugPhase === "push" && TUG_SEQUENCE) {
        beginTugDisconnect();
    } else {
        finishTimer = setTimeout(function () {
            finishTimer = null;

            leaveTopView();
        }, 1000);
    }

    stops = [];
    preview = null;
    stopEnds = [];
    routePoints = [];

    updatePanel();
}

function stopPushback() {
    setVelocity(0, 0);
    setYawRate(0);
    if (AUTO_PARKING_BRAKE) setParkingBrake();

    pushing = false;

    currentSpeed = 0;
    lastFrameT = 0;

    stops = [];
    preview = null;
    stopEnds = [];
    routePoints = [];

    leaveTopView();
    console.log("[Y Pushback] Stopped.");

}

function cancelSelection() {
    selecting = false;

    stops = [];
    preview = null;
    stopEnds = [];
    routePoints = [];
    routeLengths = [];
    routeTotalLength = 0;

    if (plannerCanvas) plannerCanvas.style.cursor = "crosshair";

    leaveTopView();
    console.log("[Y Pushback] Selection cancelled.");
}

// ============================================================
// KEYS
// ============================================================


function typingInField() {
    const el = document.activeElement;
    const tag = el && el.tagName;

    return (
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        (el && el.isContentEditable)
    );
}

// Y = push back, T = pull forward (pressing again cancels / stops).
document.addEventListener(
    "keydown",
    function (event) {

        const k = event.key.toLowerCase();
        if (k !== "y" && k !== "t") return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;
        if (typingInField()) return;

        event.preventDefault();
        startPushbackMode(k === "t");
    },
    true
);


// Speed: + / = faster, - / _ slower (while planning or moving).
document.addEventListener(
    "keydown",
    function (event) {
        if (!(selecting || pushing) || typingInField()) return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;

        if (event.key === "+" || event.key === "=") {
            event.preventDefault();
            event.stopPropagation();
            changeSpeed(SPEED_STEP);
        } else if (event.key === "-" || event.key === "_") {
            event.preventDefault();
            event.stopPropagation();
            changeSpeed(-SPEED_STEP);
        }
    },
    true
);

// N = toggle Stops / Nonstop, "," = shorter wait, "." = longer wait (while planning or moving).
document.addEventListener(
    "keydown",
    function (event) {
        if (!(selecting || pushing) || typingInField()) return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;

        if (event.key.toLowerCase() === "n") {
            event.preventDefault();
            event.stopPropagation();
            toggleNonstop();
        } else if (event.key === ",") {
            event.preventDefault();
            event.stopPropagation();
            changeWait(-WAIT_STEP);
        } else if (event.key === ".") {
            event.preventDefault();
            event.stopPropagation();

            changeWait(WAIT_STEP);
        }
    },
    true
);

// Zoom the top view: ] = closer, [ = further away (planning, or top camera while moving).
document.addEventListener(
    "keydown",

    function (event) {
        if (!(selecting || (inMotion() && overheadActive)) || typingInField()) return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;

        if (event.key === "]") {
            event.preventDefault();
            event.stopPropagation();
            zoomView(1 / ZOOM_STEP);
        } else if (event.key === "[") {
            event.preventDefault();
            event.stopPropagation();
            zoomView(ZOOM_STEP);
        }
    },
    true
);

// Camera: V = next angle, Shift+V = previous, 1-8 = pick an angle.
document.addEventListener(
    "keydown",
    function (event) {
        if (!inMotion() || typingInField()) return;
        if (event.ctrlKey || event.metaKey || event.altKey) return;

        const k = event.key.toLowerCase();


        if (k === TOGGLE_VIEW_KEY) {
            event.preventDefault();
            event.stopPropagation();
            cycleCamera(event.shiftKey ? -1 : 1);
            return;
        }

        for (let i = 0; i < CAMERA_ORDER.length; i++) {
            if (CAMERA_MODES[CAMERA_ORDER[i]].key === event.key) {
                event.preventDefault();
                event.stopPropagation();
                setCameraMode(CAMERA_ORDER[i]);
                return;

            }
        }
    },
    true
);

// Planning keys: R = reset heading, Z / Backspace = undo, Enter = ready, S = save plan.
document.addEventListener(
    "keydown",
    function (event) {
        if (!selecting || typingInField()) return;

        if (event.ctrlKey || event.metaKey || event.altKey) return;

        const k = event.key.toLowerCase();

        if (k === "r") {
            event.preventDefault();
            event.stopPropagation();
            rotateFinalHeading(angleDifference(startHeading, finalHeading));
        } else if (k === "z" || event.key === "Backspace") {
            event.preventDefault();
            event.stopPropagation();
            undoStop();
        } else if (k === "l") {
            event.preventDefault();
            event.stopPropagation();
            toggleStraight();
        } else if (k === "s") {
            event.preventDefault();
            event.stopPropagation();
            savePlan();
        } else if (event.key === "Enter") {
            event.preventDefault();
            event.stopPropagation();
            confirmReady();
        }

    },
    true
);

document.addEventListener(
    "keydown",
    function (event) {
        if (event.key !== "Escape") return;

        if (savedOpen()) closeSaved();
        else if (selecting) cancelSelection();
        else if (inMotion()) stopPushback();

    },
    true
);

// ============================================================
// PUSHBACK TUG  (3D tug model attached to the aircraft's nose gear)
// ============================================================
//
// The tug models and the per-aircraft nose-gear positions come from the
// GeoFS-Pushback project by TotallyRealElonMusk (loaded from GitHub).

const SHOW_TUG = true;               // false = no tug at all


// Which way the tug faces relative to the aircraft's nose.
//   0   = same orientation as in the original GeoFS-Pushback script
//         (tug facing away from the plane)
//   180 = turned the other way round
// If the tug looks backwards while it is hooked up, flip this between 0 and 180.
// The driving in (backs in, hook-up end first) and driving off (free end first) follow
// automatically, whichever value you pick.
// If it swings the wrong way in curves, set TUG_STEER_FLIP below to true.
const TUG_YAW_DEG = 0;

// Aircraft that are not in the GeoFS-Pushback table: use a rough estimate
// (tug about 30% of the aircraft length ahead of the reference point).
const TUG_FALLBACK_ESTIMATE = true;

// The tug steers: it swings round its hitch on the nose gear, so in a curve
// it points where the nose wheel is really going (like a real pushback).
const TUG_STEER = true;
const TUG_STEER_FLIP = false;        // tug swings the WRONG way in curves? set true
const TUG_MAX_STEER_DEG = 65;        // most the tug may turn relative to the aircraft
const TUG_STEER_SMOOTH_S = 0.35;     // seconds: how softly the tug swings (higher = lazier)
const TUG_CLEAR_RADIUS_M = 8;        // the collision check ignores this area around the tug (it is not an obstacle)

// Connect / disconnect routine:
//   1. the tug drives in from the gate and hooks up, the aircraft waits (brake on)
//   2. the push / pull
//   3. aircraft is locked (brake on) while the tug stays hooked up for a few seconds
//   4. the tug unhooks and drives back to where it started (the gate)

const TUG_SEQUENCE = true;           // false = the tug just appears / disappears with the push
const TUG_DRIVE_SPEED = 5;           // m/s the tug drives in and out
const TUG_CONNECT_WAIT_S = 3;        // seconds the tug sits hooked up before the push starts
const TUG_DISCONNECT_WAIT_S = 5;     // seconds the tug stays hooked up (aircraft locked) after the push ends
const TUG_HOME_SIDE_M = 16;          // the tug's parking spot: this far to the right of the nose line (keep >= 6) ...
const TUG_TURN_CLEAR_M = 11;         // ... the tug turns round this far ahead of the nose, then backs straight onto the nose gear
const TUG_HOME_LEADIN_M = 22;        // ... and is parked this much further ahead of that turn, facing the aircraft
const TUG_LEAVE_STRAIGHT_M = 10;     // driving off: straight ahead of the nose gear first ...

const TUG_LEAVE_TURN_M = 7;          // ... then a 90 degree turn away to the right with this radius ...
const TUG_LEAVE_OUT_M = 20;          // ... then straight on this far, and the tug is gone
const TUG_GROUND_OFFSET_M = 0;       // tug sits too high (+) / too low (-) on the ground? adjust (or use the Tug buttons)
const TUG_PITCH_COMPENSATION = true; // keeps the tug on the ground when the aircraft pitches while the tug is away from the nose gear
const TUG_STORE_KEY = "ypb_tug_tune_v1";
const TUG_STEER_KEY = "ypb_tug_steer_opposite_v4";
// While pushing in a curve the tug swings the OPPOSITE way to what it did before (like a real tug: the nose gear
// goes one way while the tail swings the other). Toggle it any time with the "Steer" button.
const TUG_STEER_OPPOSITE = false;         // pushing back (tail first)
const TUG_STEER_OPPOSITE_PULL = false;    // pulling forward: the tug simply follows the way the aircraft goes
// Per-aircraft tug position (metres from the aircraft reference point). Matched against the aircraft name.
// forward = where the nose gear / hitch is, up = height of the tug's base (negative = below the reference point).
// Example:  "767-400": { forward: 26.9 }
const TUG_OVERRIDES = {};
const TUG_RETRACE_PUSH = true;       // after a pushback the tug drives back the SAME WAY the push went (smoothed), then on to its base
const TUG_RETURN_SPEED = 6;          // m/s the tug drives back to base
const TUG_RETURN_TO_BASE = true;     // after unhooking the tug drives back to where it started (false = short exit only)
const TUG_RETURN_MAX_M = 250;        // ... but is removed after this much driving (keeps it close enough to stay level on the ground)
const TUG_REVERSE_SPEED = 1.8;       // m/s while backing onto the nose gear
const TUG_TURN_PAUSE_S = 0.8;        // short pause between the turn and backing up
const TUG_OFFSET_IN_TUG_FRAME = false; // tug slides in the wrong direction while driving? try true
const TUG_FREE_AFTER_M = 10;         // aircraft is released once the tug has driven this far away (brake stays on)

const TUG_DATA_BASE = "https://raw.githubusercontent.com/TotallyRealElonMusk/GeoFS-Pushback/main/pushback%20data/";
const TUG_MODEL_HOST = "https://raw.githubusercontent.com/";

let tugInfo = null;      // aircraft id -> { pos: [right, forward, up], model: "com" | "mil" | "carrier" }
let tugModels = null;    // model key   -> path of the .glb file
let tugActive = false;
let tugSteerDeg = 0;         // current tug angle relative to the aircraft (deg, + = clockwise seen from above)
let tugOmega = 0;            // smoothed turning rate of the aircraft (rad/s, + = nose turning right)
let tugLastHeading = null;
let tugSourceText = "";
let tugSteerInvert = true;  // swing the tug the opposite way in curves
let tugBaseForward = 12;     // nose gear position before tuning
let tugCurX = 0;             // current tug offset to the right of the hitch
let tugRight0 = 0;           // sideways position of the hitch from the aircraft reference point
let tugGroundDelta = 0;      // smoothed ground height difference between the tug and the hitch
let tugCurY = 0;             // current tug offset ahead of the hitch (for pitch compensation)
let tugGearHist = [];        // recent positions of the nose gear (for its real direction of travel)
let tugNoseOffset = 12;      // metres from the aircraft reference point to the nose gear / hitch
let tugSteerSign = -1;       // sign of the "rotate Z" animation that turns something clockwise

let tugPhase = "none";       // none | approach | connect | push | hold | leave
let tugPhaseT = 0;           // seconds spent in this phase
let tugSeqLast = 0;
let tugHome = null;          // {lat, lon}: where the tug is parked at the gate
let tugPath = null;          // current driving path {pts, cum, len, dur}
let tugPath2 = null;         // the backing-up path (approach, second leg)
let tugLeg = 0;              // approach: 0 = driving in + turning, 1 = short pause, 2 = backing up


let tugAfter = null;         // runs when the tug has left
let tugTrail = [];           // where the hitch has been during the push (geo points), used to drive back the same way
let tugLeaveYaw = 0;

function loadTugData() {
    if (!SHOW_TUG) return;

    fetch(TUG_DATA_BASE + "pushback.json")
        .then(function (r) { return r.json(); })
        .then(function (d) { tugInfo = d; })
        .catch(function (e) { console.warn("[Y Pushback] Tug positions could not be loaded:", e); });

    fetch(TUG_DATA_BASE + "pushbackModel.json")
        .then(function (r) { return r.json(); })
        .then(function (d) { tugModels = d; })
        .catch(function (e) { console.warn("[Y Pushback] Tug models could not be loaded:", e); });
}

// Where the tug sits and which model it uses for the aircraft being flown.
// ---- Finding the nose gear (where the tug hooks on) ----

function tripleOf(v) {
    if (validTriple(v)) return v;
    if (v && typeof v === "object") {
        const keys = ["origin", "position", "point", "location", "pos"];
        for (let i = 0; i < keys.length; i++) {
            if (validTriple(v[keys[i]])) return v[keys[i]];
        }
    }
    return null;
}

// Looks through the aircraft definition for the nose gear: [right, forward, up] from the aircraft reference point.
function detectNoseGear() {
    const L = planeLength();
    const found = [];

    function add(src, name, v, isNose) {
        const t = tripleOf(v);
        if (!t) return;
        if (Math.abs(t[0]) > 1.5) return;                  // on the centre line only
        if (!(t[1] > 2 && t[1] < L * 0.95)) return;        // sensible position ahead of the reference point
        found.push({ src: src, name: name || "", right: t[0], forward: t[1], up: t[2], nose: !!isNose });
    }

    try {
        const a = aircraft();
        const def = a.definition || {};
        const nosey = /nose|front|nlg|nwheel/i;


        [["suspensions", def.suspensions], ["suspensions", a.suspensions], ["wheels", def.wheels]].forEach(function (pair) {
            const list = pair[1];
            if (!Array.isArray(list)) return;
            list.forEach(function (w) {
                const nm = String((w && w.name) || "");
                add(pair[0], nm, w, nosey.test(nm));
            });
        });

        if (Array.isArray(def.collisionPoints)) {
            def.collisionPoints.forEach(function (c) { add("collisionPoints", "", c, false); });
        }

        const parts = (a.setup && a.setup.parts) || def.parts || [];
        parts.forEach(function (pt) {
            if (!pt || pt.parent) return;
            const nm = String(pt.name || "");
            if (nosey.test(nm) && /wheel|gear|strut|nlg/i.test(nm)) add("part", nm, pt.position, true);
        });
    } catch (e) {}

    if (!found.length) return null;

    // Preferred: something called "nose / front"; otherwise the most forward point on the centre line.
    const named = found.filter(function (f) { return f.nose; });
    let pool = named;

    if (!pool.length) {
        const minUp = Math.min.apply(null, found.map(function (f) { return f.up; }));
        pool = found.filter(function (f) { return f.up <= minUp + 1.0; });   // the gear is the lowest thing on the centre line
    }

    pool.sort(function (x, y) { return y.forward - x.forward; });
    const best = pool[0];
    console.log("[Y Pushback] Nose gear candidates:", JSON.stringify(found), "-> using", best.src, best.name, best.forward.toFixed(1) + " m");
    return best;
}

// Rough nose gear position from the cockpit camera position (same frame as the aircraft model):
// the nose gear sits roughly 5% of the aircraft length behind the cockpit eye. Used to reject bad data.
function noseGearEstimate() {
    try {
        const c = cockpitPosition(null);
        if (c && c.source === "aircraft definition") return c.forward - planeLength() * 0.055;
    } catch (e) {}
    return null;
}

// Height of the aircraft reference point above the ground while parked (positive metres), or null.

function referenceHeightAboveGround() {
    // 1) GeoFS's own altitude and ground elevation (same ground GeoFS draws and uses for the wheels)
    try {
        const v = geofs.animation.values;
        if (typeof v.altitude === "number" && typeof v.groundElevationFeet === "number") {
            const h = (v.altitude - v.groundElevationFeet) * 0.3048;
            if (h > 0.8 && h < 12) return { v: h, src: "GeoFS altitude minus ground" };
        }
    } catch (e) {}

    // 2) the height the aircraft definition says it sits at on its wheels
    try {
        const sa = aircraft().definition.startAltitude;
        if (typeof sa === "number" && sa > 0.8 && sa < 12) return { v: sa, src: "startAltitude" };
    } catch (e) {}

    // 3) the terrain under the aircraft
    try {
        const p = getPosition();
        const C = window.Cesium;
        const ground = geofs.api.viewer.scene.globe.getHeight(C.Cartographic.fromDegrees(p.lon, p.lat));
        if (typeof ground === "number" && isFinite(ground)) {
            const h = p.alt - ground;
            if (h > 0.8 && h < 12) return { v: h, src: "terrain" };
        }
    } catch (e) {}

    return null;
}

function tugOverrideFor() {
    const name = aircraftName();
    if (!name) return null;

    for (const key in TUG_OVERRIDES) {
        if (name.indexOf(key.toLowerCase()) !== -1) return TUG_OVERRIDES[key];
    }
    return null;
}

// Where the tug sits and which model it uses for the aircraft being flown.
function tugPlacement() {
    if (!tugModels) return null;

    const a = aircraft();
    const entry = tugInfo && tugInfo[a.id];
    const modelPath = (entry && tugModels[entry.model]) || tugModels.com;
    if (!modelPath) return null;

    let right = 0;

    let forward = null;
    let up = null;
    const sources = [];

    // Order: 1) per-aircraft override, 2) nose gear found in the aircraft definition, 3) the GeoFS-Pushback table,
    // 4) estimate from the cockpit position, 5) plain guess. Values that are far from the cockpit-based estimate are rejected.
    const E = noseGearEstimate();
    const report = { aircraft: aircraftKey(), id: a.id, length: planeLength(), model: entry ? entry.model : "com (default)", table: entry ? entry.pos : null, cockpitEstimate: E, detected: null, override: tugOverrideFor() };
    const tol = Math.max(5, planeLength() * 0.1);
    function plausible(v) { return E === null || Math.abs(v - E) <= tol; }

    const ov = tugOverrideFor();
    if (ov && Number.isFinite(ov.forward)) { forward = ov.forward; sources.push("override"); }
    if (ov && Number.isFinite(ov.up)) up = ov.up;

    if (forward === null) {
        const g = detectNoseGear();
        if (g) report.detected = { from: g.src, name: g.name, forward: g.forward, up: g.up };
        if (g && plausible(g.forward)) { forward = g.forward; sources.push("nose gear in aircraft definition (" + g.src + ")"); }
        else if (g) console.log("[Y Pushback] Rejected nose gear from definition (" + g.forward.toFixed(1) + " m): too far from the estimate " + (E === null ? "-" : E.toFixed(1)) + " m");
    }

    if (forward === null && entry && tugModels[entry.model]) {
        const tv = Number(entry.pos[1]) || 0;
        if (plausible(tv)) {
            forward = tv;
            right = Number(entry.pos[0]) || 0;
            if (up === null && Number.isFinite(Number(entry.pos[2]))) up = Number(entry.pos[2]);
            sources.push("table");
        } else {
            console.log("[Y Pushback] Rejected tug table position (" + tv.toFixed(1) + " m): too far from the estimate " + E.toFixed(1) + " m");
        }
    }

    if (forward === null && E !== null) { forward = E; sources.push("estimate from cockpit position"); }

    if (forward === null) {
        if (!TUG_FALLBACK_ESTIMATE) return null;
        forward = planeLength() * 0.4;
        sources.push("rough guess");
    }

    // Height: put the base of the tug on the ground.
    let upSrc = "table / override";
    if (up === null || !ov || !Number.isFinite(ov.up)) {
        const h = referenceHeightAboveGround();
        if (h) { up = -h.v; upSrc = h.src + " height " + h.v.toFixed(1) + " m"; }
    }
    if (up === null) { up = -3.5; upSrc = "estimate"; }
    up += TUG_GROUND_OFFSET_M;


    report.chosen = { right: right, forward: forward, up: up, from: sources.join(" + "), height: upSrc };
    try { window.ypbTugLast = report; } catch (e) {}
    console.log("[Y Pushback] Tug report: " + JSON.stringify(report));

    return { pos: [right, forward, up], path: modelPath, source: sources.join(" + ") + "; height from " + upSrc };
}

// ---- Tug tuning (saved per aircraft, adjusted with the Tug buttons) ----
let tugTune = { forward: 0, up: 0 };

// The steering preference is stored separately for pushing back and for pulling forward.
function steerKey() { return (towForward ? TUG_STEER_KEY + "_pull" : TUG_STEER_KEY) + "_" + aircraftKey(); }   // saved per aircraft
function steerDefault() { return towForward ? TUG_STEER_OPPOSITE_PULL : TUG_STEER_OPPOSITE; }

function loadTugTune() {
    tugTune = { forward: 0, up: 0 };
    try {
        const sv = localStorage.getItem(steerKey());
        tugSteerInvert = sv === null ? steerDefault() : sv === "1";
    } catch (e) { tugSteerInvert = steerDefault(); }
    try {
        const all = JSON.parse(localStorage.getItem(TUG_STORE_KEY)) || {};
        const t = all[aircraftKey()];
        if (t) tugTune = { forward: Number(t.forward) || 0, up: Number(t.up) || 0 };
    } catch (e) {}
}

function saveTugTune() {
    try {
        const all = JSON.parse(localStorage.getItem(TUG_STORE_KEY)) || {};
        all[aircraftKey()] = tugTune;
        localStorage.setItem(TUG_STORE_KEY, JSON.stringify(all));
    } catch (e) {}
}

function nudgeTug(key, delta) {
    if (!tugActive) return;
    tugTune[key] = Math.round((tugTune[key] + delta) * 100) / 100;
    saveTugTune();
    tugNoseOffset = tugBaseForward + tugTune.forward;
    notify("TUG " + (key === "forward" ? "FORWARD" : "HEIGHT") + " " + (tugTune[key] >= 0 ? "+" : "") + tugTune[key].toFixed(2) + " m (SAVED FOR THIS AIRCRAFT)");
}

// Copies the tug placement details of the current aircraft (to send when a plane's tug looks wrong).
function copyTugReport() {
    const r = window.ypbTugLast;
    const text = r ? JSON.stringify(Object.assign({}, r, { tune: tugTune, steerFlipped: tugSteerInvert })) : "no tug report yet";

    function fallback() { try { window.prompt("Copy this tug report:", text); } catch (e) {} }


    try {
        navigator.clipboard.writeText(text).then(function () {
            notify("TUG REPORT COPIED — PASTE IT WHEN YOU TELL ME WHAT LOOKS WRONG");
        }).catch(fallback);
    } catch (e) { fallback(); }
}
window.ypbTugReport = function () { console.log(JSON.stringify(window.ypbTugLast)); return window.ypbTugLast; };

function toggleTugSteer() {
    tugSteerInvert = !tugSteerInvert;
    try { localStorage.setItem(steerKey(), tugSteerInvert ? "1" : "0"); } catch (e) {}
    updatePanel();
    notify("TUG STEERING (" + modeName() + "): " + (tugSteerInvert ? "NORMAL" : "OPPOSITE") + " IN CURVES");
}

function resetTugTune() {
    tugTune = { forward: 0, up: 0 };
    saveTugTune();
    if (tugActive) tugNoseOffset = tugBaseForward;
    notify("TUG POSITION RESET");
}

// Which sign of a "rotate Z" animation turns a part CLOCKWISE (seen from above)?
// Read from the aircraft's own nose-wheel steering animation when it can be
// found, otherwise assume the normal right-handed convention (-1).
function detectTugSteerSign() {
    let sign = 1;      // normal case: a positive turn angle turns the tug clockwise
    let source = "default";

    try {
        const parts = aircraft().setup.parts || [];

        outer:
        for (let i = 0; i < parts.length; i++) {
            const part = parts[i];
            if (!part || !part.animations) continue;

            if (!/nose|front|steer|nlg|nwheel/i.test(String(part.name || ""))) continue;

            for (let j = 0; j < part.animations.length; j++) {
                const an = part.animations[j];
                if (an && an.type === "rotate" && String(an.axis).toUpperCase() === "Z" &&
                    (an.value === "yaw" || an.value === "steering") &&
                    typeof an.ratio === "number" && an.ratio !== 0) {
                    // yaw > 0 = steer right = clockwise
                    sign = Math.sign(an.ratio);
                    source = 'nose wheel part "' + part.name + '"';
                    break outer;
                }

            }
        }
    } catch (e) {}

    if (TUG_STEER_FLIP) sign = -sign;
    console.log("[Y Pushback] Tug steering direction " + (sign > 0 ? "+" : "-") + " (" + source +
        (TUG_STEER_FLIP ? ", flipped" : "") + ")");
    return sign;
}


// Runs every frame while pushing. The tug lines up with the direction the
// nose gear is really moving: aircraft velocity plus the swing of the nose
// caused by the aircraft turning.
function updateTugSteer(dt) {
    if (!tugActive || !TUG_STEER) return;

    const h = getAircraftHeading();

    if (tugLastHeading === null) tugGearHist = [];

    if (tugLastHeading !== null && dt > 0) {
        const w = radians(angleDifference(h, tugLastHeading)) / dt;
        tugOmega += (w - tugOmega) * (1 - Math.exp(-dt / 0.25));
    }
    tugLastHeading = h;

    // Remember where the hitch (nose gear) has been, so the tug can drive back the same way.
    const pp = getPosition();
    if (pp) {
        const hh = radians(h);
        const hitch = localToGeo(pp, { x: Math.sin(hh) * tugNoseOffset, y: Math.cos(hh) * tugNoseOffset });
        const lastPt = tugTrail[tugTrail.length - 1];
        if (!lastPt || distance(lastPt, hitch) >= 1.5) tugTrail.push(hitch);

        // Where the nose gear really is, over the last moments (its true direction of travel).
        if (startPosition) {
            const gl = geoToLocal(startPosition, hitch);
            const tn = performance.now();
            tugGearHist.push({ t: tn, x: gl.x, y: gl.y });
            while (tugGearHist.length > 2 && tn - tugGearHist[0].t > 700) tugGearHist.shift();
        }
    }

    const hr = radians(h);
    let vf = smoothVel.x * Math.sin(hr) + smoothVel.y * Math.cos(hr);   // along the nose (+ = forward)
    let vr = smoothVel.x * Math.cos(hr) - smoothVel.y * Math.sin(hr);   // to the right of the nose
    let vNoseRight = vr + tugOmega * tugNoseOffset;                      // nose gear moves sideways when the nose swings (estimate)

    // Better: use how the nose gear is REALLY moving (works the same for every aircraft, whatever its size or

    // wherever its reference point is). The tug simply points the way the nose gear is going.
    if (tugGearHist.length >= 3) {
        const a0 = tugGearHist[0];
        const a1 = tugGearHist[tugGearHist.length - 1];
        const span = (a1.t - a0.t) / 1000;

        if (span >= 0.3) {
            const gx = (a1.x - a0.x) / span;
            const gy = (a1.y - a0.y) / span;
            vf = gx * Math.sin(hr) + gy * Math.cos(hr);
            vNoseRight = gx * Math.cos(hr) - gy * Math.sin(hr);
        }
    }


    let target = tugSteerDeg;

    // Too slow (or waiting at a stop): the direction is unreliable, keep the last angle.
    if (Math.hypot(vf, vNoseRight) > 0.2) {
        const s = vf < 0 ? -1 : 1;
        target = clamp(degrees(Math.atan2(vNoseRight * s, Math.abs(vf))), -TUG_MAX_STEER_DEG, TUG_MAX_STEER_DEG);
    }

    tugSteerDeg += (target - tugSteerDeg) * (1 - Math.exp(-dt / TUG_STEER_SMOOTH_S));

    try { geofs.animation.values.ypbTugYaw = tugSteerDeg * tugSteerSign * (tugSteerInvert ? -1 : 1); } catch (e) {}
    tugCurX = 0;
    tugCurY = 0;
    updateTugHeight();
}

// ---- Connect / disconnect routine -------------------------------------

function smoothstep01(t) { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); }

// Position of a geo point in the aircraft's own frame, relative to the hitch.
// x = to the right of the nose, y = ahead of the hitch (metres).
function geoToHitchFrame(geo) {
    const p = getPosition();

    if (!p) return { x: 0, y: 0 };

    const l = geoToLocal(p, geo);
    const h = radians(getAircraftHeading());

    return {
        x: l.x * Math.cos(h) - l.y * Math.sin(h),
        y: l.x * Math.sin(h) + l.y * Math.cos(h) - tugNoseOffset
    };
}


// Distance fraction after a fraction u of the drive time: gentle start, steady speed, gentle stop.
function tugEase(u) {
    const f = 0.15;
    u = clamp(u, 0, 1);
    if (u < f) return u * u / (2 * f * (1 - f));
    if (u > 1 - f) return 1 - (1 - u) * (1 - u) / (2 * f * (1 - f));
    return (u - f / 2) / (1 - f);
}

function makeTugPath(pts) {
    const cum = [0];
    for (let i = 1; i < pts.length; i++) {
        cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
    }
    const len = cum[cum.length - 1];
    return { pts: pts, cum: cum, len: len, dur: Math.max(1.5, len / (TUG_DRIVE_SPEED * 0.85)) };
}


// After a pushback: the way the nose gear went during the push, backwards, smoothed, and on to the base.
// Returns null when there is no usable trail or the way back would cut through the aircraft.
function buildTugRetracePath() {
    if (towForward || tugTrail.length < 4) return null;

    const raw = [{ x: 0, y: 0 }];
    for (let i = tugTrail.length - 1; i >= 0; i--) {
        const q = geoToHitchFrame(tugTrail[i]);
        const last = raw[raw.length - 1];
        if (Math.hypot(q.x - last.x, q.y - last.y) >= 1.5) raw.push(q);
    }

    if (tugHome) {
        const h = geoToHitchFrame(tugHome);
        const last = raw[raw.length - 1];
        if (Math.hypot(h.x - last.x, h.y - last.y) > 1) raw.push(h);
    }

    if (raw.length < 6) return null;

    // Smooth the wobbles of the recorded trail (two passes), keeping both ends.
    let pts = raw;
    for (let pass = 0; pass < 2; pass++) {
        const prev = pts;
        pts = prev.map(function (pt, i) {
            if (i === 0 || i === prev.length - 1) return pt;
            let x = 0, y = 0, n = 0;
            for (let k = -3; k <= 3; k++) {
                const j = i + k;
                if (j < 0 || j >= prev.length) continue;

                x += prev[j].x; y += prev[j].y; n++;
            }
            return { x: x / n, y: y / n };
        });
    }

    // Stop after TUG_RETURN_MAX_M, and make sure the way back does not cut through the aircraft.
    const L = planeLength();
    const half = L * planeSpanRatio() / 2;
    const yMin = -(L * 0.88);
    const yMax = L * 0.12;
    const out = [pts[0]];
    let len = 0;

    for (let i = 1; i < pts.length; i++) {
        len += Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
        if (len > 12 && Math.abs(pts[i].x) < half && pts[i].y > yMin && pts[i].y < yMax) return null;
        out.push(pts[i]);
        if (len >= TUG_RETURN_MAX_M) break;
    }

    return out.length > 5 ? out : null;
}

// Path from the nose gear back to the tug's base (the spot it started from), in the hitch frame:
// out ahead of the nose first, then smoothly to the base. If the base is behind the aircraft the tug
// goes round the side, clear of the wings. Returns null when the base is too close / inside the aircraft.
function buildTugReturnPath(home) {
    const L = planeLength();
    const half = L * planeSpanRatio() / 2 + 6;
    const noseAhead = L * 0.12;
    const yMin = -(L - noseAhead) - 4;
    const yMax = noseAhead + 3;
    const S = TUG_LEAVE_STRAIGHT_M;

    function inside(x, y) { return Math.abs(x) < half && y > yMin && y < yMax; }

    if (Math.hypot(home.x, home.y) < 15 || inside(home.x, home.y)) return null;

    const A = { x: 0, y: Math.max(S, yMax + 2) };      // out past the nose first
    let blocked = false;
    const n = Math.max(2, Math.ceil(Math.hypot(home.x - A.x, home.y - A.y) / 2));
    for (let i = 0; i <= n; i++) {
        if (inside(A.x + (home.x - A.x) * i / n, A.y + (home.y - A.y) * i / n)) { blocked = true; break; }
    }

    const way = [{ x: 0, y: 0 }, A];

    if (blocked) {
        const side = home.x !== 0 ? Math.sign(home.x) : (TUG_HOME_SIDE_M >= 0 ? 1 : -1);

        way.push({ x: side * half, y: A.y + 4 });
        way.push({ x: side * half, y: Math.min(home.y, yMin - 8) });
    }

    way.push(home);

    // Smooth curve through the waypoints (Catmull-Rom).
    const pts = [];
    for (let i = 0; i < way.length - 1; i++) {
        const p0 = way[Math.max(0, i - 1)], p1 = way[i], p2 = way[i + 1], p3 = way[Math.min(way.length - 1, i + 2)];
        for (let k = (i === 0 ? 0 : 1); k <= 14; k++) {
            const t = k / 14, t2 = t * t, t3 = t2 * t;
            pts.push({
                x: 0.5 * ((2 * p1.x) + (-p0.x + p2.x) * t + (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * t2 + (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * t3),
                y: 0.5 * ((2 * p1.y) + (-p0.y + p2.y) * t + (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * t2 + (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * t3)
            });
        }
    }

    // Stop after TUG_RETURN_MAX_M of driving.
    const out = [pts[0]];
    let len = 0;
    for (let i = 1; i < pts.length; i++) {
        len += Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
        out.push(pts[i]);
        if (len >= TUG_RETURN_MAX_M) break;
    }

    return out.length > 3 ? out : null;
}

// Point and heading (deg clockwise from the aircraft's nose) at distance d along the path.
function tugPathAt(path, d) {
    d = clamp(d, 0, path.len);

    for (let i = 1; i < path.pts.length; i++) {
        if (d <= path.cum[i] || i === path.pts.length - 1) {
            const a = path.pts[i - 1];
            const b = path.pts[i];
            const seg = Math.max(1e-6, path.cum[i] - path.cum[i - 1]);
            const u = clamp((d - path.cum[i - 1]) / seg, 0, 1);

            return {
                x: lerp(a.x, b.x, u),
                y: lerp(a.y, b.y, u),
                bearing: degrees(Math.atan2(b.x - a.x, b.y - a.y))
            };
        }
    }


    return { x: 0, y: 0, bearing: 0 };

}

// Applies the tug's position (relative to the hitch) and heading to the model.
function setTugVisual(x, y, yawCwDeg) {
    let tx = x;
    let ty = y;

    if (TUG_OFFSET_IN_TUG_FRAME) {
        const a = radians(yawCwDeg);
        tx = x * Math.cos(a) - y * Math.sin(a);
        ty = x * Math.sin(a) + y * Math.cos(a);
    }

    tugCurX = tx;
    tugCurY = ty;

    try {
        geofs.animation.values.ypbTugX = tx;
        geofs.animation.values.ypbTugY = ty + tugTune.forward;
        geofs.animation.values.ypbTugYaw = yawCwDeg * tugSteerSign;
        updateTugHeight();
    } catch (e) {}
}

// Ground (terrain) height at a point, or null while the ground there is not loaded yet.
function terrainHeightAt(lat, lon) {
    try {
        const h = geofs.api.viewer.scene.globe.getHeight(window.Cesium.Cartographic.fromDegrees(lon, lat));
        return (typeof h === "number" && isFinite(h)) ? h : null;
    } catch (e) {
        return null;
    }
}

// Keeps the tug ON THE GROUND wherever it drives. The tug is fixed to the aircraft, so away from the nose gear it
// rises / sinks when the aircraft pitches or rolls and when the ground is not perfectly level. This works out the
// height needed from: the saved height tuning, the aircraft's pitch and roll, and the actual ground under the tug.
function updateTugHeight() {
    if (!tugActive) return;

    let z = tugTune.up;

    if (TUG_PITCH_COMPENSATION) {
        try {
            if (Math.abs(tugCurX) + Math.abs(tugCurY) > 0.3) {
                const v = geofs.animation.values;
                const th = radians(clamp(Number(v.atilt) || 0, -20, 20));      // pitch, nose up = +
                const ph = radians(clamp(Number(v.aroll) || 0, -20, 20));      // roll, right wing down = +


                // Ground height under the tug compared with under the nose gear.
                const p = getPosition();
                const h = radians(getAircraftHeading());
                const X0 = tugRight0;
                const Y0 = tugBaseForward + tugTune.forward;

                function at(X, Y) {
                    return localToGeo(p, { x: X * Math.cos(h) + Y * Math.sin(h), y: -X * Math.sin(h) + Y * Math.cos(h) });
                }

                const gh = at(X0, Y0);
                const gt = at(X0 + tugCurX, Y0 + tugCurY);
                const a = terrainHeightAt(gh.lat, gh.lon);
                const b = terrainHeightAt(gt.lat, gt.lon);
                const dg = (a !== null && b !== null) ? clamp(b - a, -3, 3) : tugGroundDelta;

                tugGroundDelta += (dg - tugGroundDelta) * 0.25;

                // Height of a point that is (tugCurX, tugCurY) away from the hitch, in the tilted aircraft frame.
                z += (tugGroundDelta - tugCurY * Math.sin(th) + tugCurX * Math.sin(ph) * Math.cos(th)) / (Math.cos(th) * Math.cos(ph));
            } else {
                tugGroundDelta *= 0.8;
            }
        } catch (e) {}
    }

    try { geofs.animation.values.ypbTugZ = z; } catch (e) {}
}

// Aircraft cannot move while the tug is hooking up / unhooking.
function lockAircraft() {
    setVelocity(0, 0);
    setYawRate(0);
    setParkingBrake();
}

// The tug starts parked ahead of the nose at the gate, then drives to the nose gear.
function startTugApproach() {
    tugPhase = "none";

    tugPath = null;
    tugPath2 = null;
    tugLeg = 0;
    if (!TUG_SEQUENCE || !startPosition) return;

    // Hitch frame: x = right of the nose gear, y = ahead of it (metres).
    const noseAhead = planeLength() * 0.12;   // nose gear -> nose tip (about 12% of the length on airliners)
    const turnY = noseAhead + TUG_TURN_CLEAR_M;                         // where the turn ends / backing starts
    const homeY = turnY + TUG_HOME_LEADIN_M;

    const homeX = TUG_HOME_SIDE_M;

    const h = radians(startHeading);
    const fwd = tugNoseOffset + homeY;
    const right = homeX;

    tugHome = localToGeo(startPosition, {
        x: fwd * Math.sin(h) + right * Math.cos(h),
        y: fwd * Math.cos(h) - right * Math.sin(h)
    });

    // Leg A (nose first, FACING THE AIRCRAFT): drive towards the aircraft alongside the nose,
    // then swing round in a half circle until the tug faces away, in line with the nose gear.
    const side = homeX >= 0 ? 1 : -1;
    const R = Math.max(2.5, Math.abs(homeX) / 2);
    const ax = Math.abs(homeX);
    const legA = [];

    const lead = Math.max(0, homeY - turnY);
    const nLead = Math.max(2, Math.ceil(lead / 2));
    for (let i = 0; i <= nLead; i++) legA.push({ x: side * ax, y: homeY - lead * i / nLead });

    const cx = ax - R;
    for (let i = 1; i <= 40; i++) {
        const phi = -Math.PI * i / 40;
        legA.push({ x: side * (cx + R * Math.cos(phi)), y: turnY + R * Math.sin(phi) });
    }

    // Leg B (BACKING UP): straight onto the nose gear, hook-up end first.
    const legB = [];
    const nB = Math.max(2, Math.ceil(turnY / 2));
    for (let i = 0; i <= nB; i++) legB.push({ x: 0, y: turnY - turnY * i / nB });

    tugPath = makeTugPath(legA);
    tugPath2 = makeTugPath(legB);
    tugPath2.dur = Math.max(1.5, tugPath2.len / (TUG_REVERSE_SPEED * 0.85));
    if (tugPath.len < 1 || tugPath2.len < 1) { tugPath = null; tugPath2 = null; return; }

    tugPhase = "approach";
    tugLeg = 0;
    tugPhaseT = 0;
    tugSeqLast = 0;

    const first = tugPathAt(tugPath, 0);
    setTugVisual(first.x, first.y, normalizeAngle(first.bearing));
    lockAircraft();
    notify("TUG APPROACHING — " + tugSourceText);
}

// Pushing is over: the tug stays hooked up for a moment (aircraft locked), then leaves.

function beginTugDisconnect() {
    tugPhase = "hold";
    tugPhaseT = 0;
    tugSeqLast = 0;
    tugAfter = function () { leaveTopView(); };
    lockAircraft();
    notify(modeName() + " COMPLETE — TUG DISCONNECTING");
}

function finishTugRoutine() {
    const after = tugAfter;
    removeTug();
    notify("TUG GONE — PARKING BRAKE SET");
    if (after) after();
}

// Runs every frame (also after the push has ended).
function updateTugSequence() {
    if (!tugActive || tugPhase === "none" || tugPhase === "push") return;

    try {

        const now = performance.now();
        const dt = clamp((now - (tugSeqLast || now)) / 1000, 0.001, 0.1);
        tugSeqLast = now;
        tugPhaseT += dt;

        if (tugPhase !== "leave") lockAircraft();

        if (tugPhase === "approach") {
            if (tugLeg === 0) {
                // Driving forward (nose first, facing the aircraft), then turning round.
                const u = tugPhaseT / tugPath.dur;
                const pt = tugPathAt(tugPath, tugEase(u) * tugPath.len);
                setTugVisual(pt.x, pt.y, normalizeAngle(pt.bearing));

                if (u >= 1) { tugLeg = 1; tugPhaseT = 0; }
            } else if (tugLeg === 1) {
                // Stopped for a moment, now facing away from the aircraft.
                const e = tugPath.pts[tugPath.pts.length - 1];
                setTugVisual(e.x, e.y, 0);

                if (tugPhaseT >= TUG_TURN_PAUSE_S) { tugLeg = 2; tugPhaseT = 0; notify("TUG BACKING UP TO THE NOSE GEAR"); }
            } else {
                // Backing up, hook-up end first, straight onto the nose gear.
                const u = tugPhaseT / tugPath2.dur;
                const pt = tugPathAt(tugPath2, tugEase(u) * tugPath2.len);
                setTugVisual(pt.x, pt.y, normalizeAngle(pt.bearing + 180));

                if (u >= 1) {

                    tugPhase = "connect";
                    tugPhaseT = 0;
                    tugSteerDeg = 0;
                    setTugVisual(0, 0, 0);
                    notify("TUG CONNECTING…");
                }
            }
        } else if (tugPhase === "connect") {
            if (tugPhaseT >= TUG_CONNECT_WAIT_S) {
                tugPhase = "push";
                tugPhaseT = 0;
                tugLastHeading = null;
                tugTrail = [];
                releaseBrakes();
                lastFrameT = 0;
                notify("TUG CONNECTED — " + modeName() + " ACTIVE — STEER: " + (tugSteerInvert ? "NORMAL" : "OPPOSITE"));
            }
        } else if (tugPhase === "hold") {
            if (tugPhaseT >= TUG_DISCONNECT_WAIT_S) {
                // Drive off like a real tug, free end first (never backwards).
                const homeH = (TUG_RETURN_TO_BASE && tugHome) ? geoToHitchFrame(tugHome) : null;
                let pts = (TUG_RETURN_TO_BASE && TUG_RETRACE_PUSH) ? buildTugRetracePath() : null;   // same way as the push
                if (!pts && homeH) pts = buildTugReturnPath(homeH);     // otherwise round the aircraft to the base
                const quick = !pts;                                      // otherwise a short exit
                if (quick) pts = [];
                const sd = TUG_HOME_SIDE_M >= 0 ? 1 : -1;
                const S = TUG_LEAVE_STRAIGHT_M;

                if (quick) {
                const nS = Math.max(2, Math.ceil(S / 2));
                for (let i = 0; i <= nS; i++) pts.push({ x: 0, y: S * i / nS });

                if (towForward) {
                    // Pull forward: carry on ahead, swing round in a half circle and head back, away from the wings.
                    const R = TUG_LEAVE_TURN_M;
                    const Sf = S + 4;
                    pts.push({ x: 0, y: Sf });
                    for (let i = 1; i <= 36; i++) {
                        const th = Math.PI * i / 36;                       // 0 .. 180 degrees
                        pts.push({ x: sd * R * (1 - Math.cos(th)), y: Sf + R * Math.sin(th) });
                    }
                    const bx = sd * 2 * R, by = Sf;
                    const ang = radians(140);                              // heading back and outwards
                    const nB = Math.max(2, Math.ceil(TUG_LEAVE_OUT_M / 2));
                    for (let i = 1; i <= nB; i++) {
                        const d = TUG_LEAVE_OUT_M * i / nB;
                        pts.push({ x: bx + sd * Math.sin(ang) * d, y: by + Math.cos(ang) * d });
                    }
                } else {
                    // Pushback: forward, a 90 degree turn away to the side, then out.

                    const R = TUG_LEAVE_TURN_M;
                    for (let i = 1; i <= 24; i++) {
                        const ang = (Math.PI / 2) * i / 24;                // 0 .. 90 degrees
                        pts.push({ x: sd * R * (1 - Math.cos(ang)), y: S + R * Math.sin(ang) });
                    }
                    const ex = sd * R, ey = S + R;
                    const nO = Math.max(2, Math.ceil(TUG_LEAVE_OUT_M / 2));
                    for (let i = 1; i <= nO; i++) pts.push({ x: ex + sd * TUG_LEAVE_OUT_M * i / nO, y: ey });
                }
                }

                tugPath = makeTugPath(pts);
                if (!quick) tugPath.dur = Math.max(2, tugPath.len / (TUG_RETURN_SPEED * 0.85));
                tugLeaveYaw = tugSteerDeg;
                tugPhase = "leave";
                tugPhaseT = 0;
                notify(quick ? "TUG LEAVING" : "TUG RETURNING TO BASE");
            }
        } else if (tugPhase === "leave") {
            const u = tugPhaseT / tugPath.dur;
            const dist = tugEase(u) * tugPath.len;
            const pt = tugPathAt(tugPath, dist);

            // Aircraft stays locked until the tug is clear of it (the parking brake stays on).
            if (dist < TUG_FREE_AFTER_M) lockAircraft();

            // Point the cab where the path goes a few metres further on, turning no faster than 90 deg/s.
            const ahead = tugPathAt(tugPath, Math.min(tugPath.len, dist + 4));
            const bearing = Math.hypot(ahead.x - pt.x, ahead.y - pt.y) > 0.2

                ? degrees(Math.atan2(ahead.x - pt.x, ahead.y - pt.y))
                : pt.bearing;
            const want = normalizeAngle(bearing);   // drives off with the end that was NOT hooked to the aircraft leading
            tugLeaveYaw = normalizeAngle(tugLeaveYaw + clamp(angleDifference(want, tugLeaveYaw), -120 * dt, 120 * dt));

            setTugVisual(pt.x, pt.y, tugLeaveYaw);

            if (u >= 1) finishTugRoutine();
        }
    } catch (e) {
        console.warn("[Y Pushback] Tug routine error — skipping it:", e);
        finishTugRoutine();
    }
}

function addTug() {
    removeTug();
    if (!SHOW_TUG) return;

    try {

        const place = tugPlacement();

        if (!place) {
            console.log("[Y Pushback] No tug for aircraft id " + aircraft().id +
                (tugModels ? "" : " (tug data not loaded yet)"));
            return;
        }

        tugSteerDeg = 0;
        tugOmega = 0;
        tugLastHeading = null;
        loadTugTune();
        tugSourceText = "HITCH " + Number(place.pos[1]).toFixed(1) + " m AHEAD OF REFERENCE (" + place.source.split(";")[0] + ")";
        tugBaseForward = Number(place.pos[1]) || 0;
        tugNoseOffset = tugBaseForward + tugTune.forward;
        tugSteerSign = detectTugSteerSign();
        tugCurX = 0;
        tugCurY = 0;
        tugRight0 = Number(place.pos[0]) || 0;
        tugGroundDelta = 0;

        geofs.animation.values.ypbTugYaw = 0;
        geofs.animation.values.ypbTugX = 0;
        geofs.animation.values.ypbTugY = tugTune.forward;
        geofs.animation.values.ypbTugZ = tugTune.up;

        const part = {
            name: "pushbackTruck",
            model: place.path,
            position: place.pos,
            rotation: [0, 0, TUG_YAW_DEG],
            animations: [
                { type: "translate", value: "ypbTugX", axis: "X", ratio: 1 },  // driving in / out (metres, aircraft frame)
                { type: "translate", value: "ypbTugY", axis: "Y", ratio: 1 },
                { type: "translate", value: "ypbTugZ", axis: "Z", ratio: 1 },   // height tuning / pitch compensation
                { type: "rotate", value: "ypbTugYaw", axis: "Z", ratio: 1 },   // steering (degrees)
                { type: "show", value: "ypbTug" },
                { type: "rotate", value: "atilt", axis: "X", ratio: -1 }   // keeps the tug level when the nose dips
            ]

        };

        geofs.animation.values.ypbTug = 1;
        aircraft().addParts([part], TUG_MODEL_HOST, 1, "Zup");
        tugActive = true;
        startTugApproach();

        console.log("[Y Pushback] Tug added (aircraft id " + aircraft().id + ", right/forward/up = " +
            place.pos.map(function (v) { return Number(v).toFixed(1); }).join(" / ") + ", from " + place.source + ")");
    } catch (e) {

        console.warn("[Y Pushback] Could not add the tug:", e);
    }
}

function removeTug() {
    tugPhase = "none";
    tugPath = null;
    tugAfter = null;
    tugTrail = [];

    if (!tugActive) return;
    tugActive = false;

    try { geofs.animation.values.ypbTug = 0; } catch (e) {}
    try { geofs.animation.values.ypbTugYaw = 0; } catch (e) {}
    try { geofs.animation.values.ypbTugX = 0; geofs.animation.values.ypbTugY = 0; geofs.animation.values.ypbTugZ = 0; } catch (e) {}

    try {
        aircraft().parts.pushbackTruck.object3d.destroy();
    } catch (e) {}
}


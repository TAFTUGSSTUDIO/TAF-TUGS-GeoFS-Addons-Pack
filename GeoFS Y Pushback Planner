function createUI() {
    if (document.getElementById("y-pushback-ui")) return;

    const ui = document.createElement("div");
    ui.id = "y-pushback-ui";

    ui.style.cssText = `

        position:fixed;
        top:50px;
        left:50%;
        transform:translateX(-50%) scale(${UI_SCALE});
        transform-origin:top center;
        z-index:999999;
        background:rgba(8,10,12,.94);

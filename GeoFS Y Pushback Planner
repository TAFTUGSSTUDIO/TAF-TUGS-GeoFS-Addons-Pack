        const b = e.target.closest("button");
        if (!b) return;
        if (b.dataset.act === "push") startPushbackMode(false);
        else if (b.dataset.act === "pull") startPushbackMode(true);
        else if (b.dataset.act === "saved") openSaved();
        b.blur();
    });
    document.body.appendChild(l);

    updatePanel();
}

function setRow(id, on) {
    const el = document.getElementById(id);
    if (el) el.style.display = on ? "flex" : "none";
}

function updatePanel() {
    const p = document.getElementById("y-pushback-panel");
    if (!p) return;

    p.style.display = (selecting || pushing) ? "flex" : "none";

    setRow("y-pb-setup", selecting);
    setRow("y-pb-ready", selecting);
    setRow("y-pb-run", pushing);
    setRow("y-pb-speed", selecting || pushing);
    setRow("y-pb-cams", pushing);
    setRow("y-pb-tune", pushing && mountActive && tuneOpen);
    const tb = document.getElementById("y-pb-tune-btn");
    if (tb) {
        tb.style.display = (pushing && mountActive) ? "" : "none";
        tb.classList.toggle("active", tuneOpen);
    }
    setRow("y-pb-zoom", selecting || (pushing && cameraMode === "top"));

    const launcher = document.getElementById("y-pushback-launcher");
    if (launcher) launcher.style.display = (selecting || pushing) ? "none" : "flex";

    const stb = document.getElementById("y-pb-straight-btn");
    if (stb) {
        stb.textContent = "━ Straight: " + (straightMode ? "ON" : "OFF");
        stb.classList.toggle("active", straightMode);
    }

    const sv = document.getElementById("y-pb-speed-val");
    if (sv) sv.textContent = speedSetting.toFixed(1) + " m/s";

    const rb = document.getElementById("y-pb-ready-btn");
    if (rb) {
        rb.disabled = stops.length === 0;
        rb.textContent = stops.length
            ? (collisionWarn ? "⚠ COLLISION RISK — START " : "✔ READY — START ") + modeName() + " (" + stops.length + (stops.length === 1 ? " stop)" : " stops)")
            : "NOT READY — CLICK TO ADD A STOP";
        rb.style.background = (stops.length && collisionWarn) ? "#c62828" : "";
        rb.style.borderColor = (stops.length && collisionWarn) ? "#ff8a80" : "";
    }

    p.querySelectorAll("[data-cam]").forEach(function (b) {
        b.classList.toggle("active", b.dataset.cam === cameraMode);
        // Wing cameras only show up when the aircraft has a usable wingspan.
        b.style.display = (pushing && !modeAvailable(b.dataset.cam)) ? "none" : "";
    });
}


function aircraft() {
    return geofs.aircraft.instance;
}

function getPosition() {
    const a = aircraft();
    if (!a || !a.llaLocation) return null;
    return { lat: a.llaLocation[0], lon: a.llaLocation[1], alt: a.llaLocation[2] };
}


// Position used by the cameras: follows the aircraft with a tiny delay so the
// picture glides instead of jittering with every physics step.
let camSmooth = null;
let camSmoothT = 0;

function resetCameraSmoothing() { camSmooth = null; }

function getCameraPosition() {

    const p = getPosition();
    if (!p) return null;

    const now = performance.now();
    const dt = Math.min(0.1, Math.max(0.001, (now - (camSmoothT || now)) / 1000));
    camSmoothT = now;

    if (!camSmooth || CAMERA_SMOOTH_S <= 0 || !inMotion() || distance(camSmooth, p) > 30) {
        camSmooth = { lat: p.lat, lon: p.lon, alt: p.alt };
        return camSmooth;
    }


    const k = 1 - Math.exp(-dt / CAMERA_SMOOTH_S);
    camSmooth.lat += (p.lat - camSmooth.lat) * k;
    camSmooth.lon += (p.lon - camSmooth.lon) * k;
    camSmooth.alt += (p.alt - camSmooth.alt) * k;
    return camSmooth;
}

function getAircraftHeading() {
    const a = aircraft();
    if (!a) return 0;

    try {
        if (
            geofs.animation &&
            geofs.animation.values &&
            typeof geofs.animation.values.heading360 === "number"
        ) {
            return normalizeAngle(geofs.animation.values.heading360);
        }
    } catch (e) {}

    try {
        if (Array.isArray(a.htr) && typeof a.htr[0] === "number") {
            let h = a.htr[0];
            if (Math.abs(h) <= Math.PI * 2.5) h = h * 180 / Math.PI;
            return normalizeAngle(h);
        }
    } catch (e) {}


    try {
        if (typeof a.heading === "number") return normalizeAngle(a.heading);
    } catch (e) {}

    return 0;
}

// GeoFS spawns the aircraft with the parking brake set, and can re-apply it.
function releaseBrakes() {

    try {
        if (window.controls) {
            controls.parkingBrake = 0;
            controls.brakes = 0;
        }
    } catch (e) {}

    try {
        geofs.animation.values.parkingBrake = 0;
        geofs.animation.values.brakes = 0;

    } catch (e) {}
}

// Sets the parking brake (the plane stays put once the tug lets go).
function setParkingBrake() {
    try {
        if (window.controls) controls.parkingBrake = 1;
    } catch (e) {}

    try {
        geofs.animation.values.parkingBrake = 1;
    } catch (e) {}
}

// ============================================================
// MATH
// ============================================================

function radians(x) { return x * Math.PI / 180; }
function degrees(x) { return x * 180 / Math.PI; }
function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function lerp(a, b, t) { return a + (b - a) * t; }

function normalizeAngle(angle) {
    angle %= 360;
    if (angle < 0) angle += 360;
    return angle;
}

function angleDifference(a, b) {

    let d = normalizeAngle(a) - normalizeAngle(b);
    if (d > 180) d -= 360;
    if (d < -180) d += 360;
    return d;
}

function distance(a, b) {
    const R = 6371000;
    const lat1 = radians(a.lat);
    const lat2 = radians(b.lat);

    const dLat = radians(b.lat - a.lat);
    const dLon = radians(b.lon - a.lon);
    const h =
        Math.sin(dLat / 2) ** 2 +
        Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
}


// x = east, y = north (metres)
function geoToLocal(origin, point) {
    const R = 6371000;
    const meanLat = radians((origin.lat + point.lat) / 2);
    return {
        x: radians(point.lon - origin.lon) * R * Math.cos(meanLat),
        y: radians(point.lat - origin.lat) * R
    };
}

function localToGeo(origin, local) {
    const R = 6371000;
    return {
        lat: origin.lat + degrees(local.y / R),
        lon: origin.lon + degrees(local.x / (R * Math.cos(radians(origin.lat))))
    };
}

// ---- Direction of travel (push back = opposite the nose, pull forward = along the nose) ----

// Compass heading of the direction the aircraft travels when its nose points at `heading`.
function travelHeading(heading) {
    return towForward ? heading : heading + 180;
}

// Unit vector (east, north) of that travel direction.
function travelDir(heading) {
    const t = radians(travelHeading(heading));
    return { x: Math.sin(t), y: Math.cos(t) };
}


// Nose heading needed so the aircraft travels along compass bearing `bearing`.
function noseHeadingForTravel(bearing) {
    return normalizeAngle(towForward ? bearing : bearing + 180);
}

function sideWord() { return towForward ? "IN FRONT OF" : "BEHIND"; }
function modeName() { return towForward ? "PULL FORWARD" : "PUSHBACK"; }

// ============================================================
// AIRCRAFT TYPE (image + real length)
// ============================================================


// Lower-case text describing the aircraft, letters and digits only.
// "Boeing 737-800" -> "boeing737800"
function aircraftKey() {
    let parts = [];


    try {
        const a = aircraft();
        if (a.aircraftRecord) {
            parts.push(a.aircraftRecord.name, a.aircraftRecord.fullPath);
        }
        if (a.definition) parts.push(a.definition.name);
        parts.push(a.name, a.id);
    } catch (e) {}

    return parts
        .filter(function (p) { return typeof p === "string" && p; })
        .join(" ")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "");
}

function findSpec(key) {
    // The "-?" in the patterns is harmless: the key has no dashes anyway.
    for (let i = 0; i < AIRCRAFT_SPECS.length; i++) {
        if (AIRCRAFT_SPECS[i].re.test(key)) return AIRCRAFT_SPECS[i];
    }
    return null;
}

// The list entry for the aircraft being flown (null = unknown aircraft).
function planeSpec() {
    const key = aircraftKey();

    if (specCache.name !== key) {
        const spec = findSpec(key);
        specCache = { name: key, spec: spec };


        if (spec) {
            console.log("[Y Pushback] Aircraft \"" + key + "\" -> " + spec.label + " (" + spec.length + " m)");
            getTexture(spec.tex.day);
            getTexture(spec.tex.night);
        } else {
            console.log("[Y Pushback] Aircraft \"" + key + "\" is not in the list — using a plain silhouette.");
        }
    }

    return specCache.spec;
}


function planeLength() {
    const s = planeSpec();
    return s ? s.length : PLANE_LENGTH_M;
}


function planeNose() {
    const s = planeSpec();
    const n = s && s.nose !== undefined ? s.nose : PLANE_TEXTURE_NOSE_DEG;
    return ((n % 360) + 360) % 360;
}

// Wingspan divided by length (estimate unless the list row has `span` in metres).
function planeSpanRatio() {
    const s = planeSpec();
    if (s && s.span) return s.span / s.length;
    return COLLISION_SPAN_RATIO;
}

function planeLabel() {
    const s = planeSpec();
    return s ? s.label + " (" + s.length + " m)" : "UNKNOWN AIRCRAFT";
}

// ============================================================
// CAMERA
// ============================================================

function saveCamera() {}

function applyOverheadCamera() {
    const p = getCameraPosition();
    if (!p) return;

    const Cesium = window.Cesium;

    geofs.api.viewer.camera.setView({
        destination: Cesium.Cartesian3.fromDegrees(

            p.lon,
            p.lat,
            p.alt + cameraHeight
        ),
        orientation: {
            heading: 0,                // north up
            pitch: -Math.PI / 2,       // straight down
            roll: 0
        }
    });
}

// Stop driving the camera. GeoFS takes over by itself.

function restoreCamera() {
    overheadActive = false;

    orbitActive = false;
    mountActive = false;
    restoreFov();
    if (nativeCockpit) leaveNativeCockpit();
    cameraMode = "top";
    oldCamera = null;
}

function applyOrbitCamera() {
    const p = getCameraPosition();
    if (!p) return;

    const C = window.Cesium;
    const camera = geofs.api.viewer.camera;

    // "Follow" angles turn with the aircraft; free orbit stays fixed in the world
    // and (Orbit camera) slowly circles the aircraft until you drag it yourself.
    const nowO = performance.now();
    const dtO = clamp((nowO - (orbitLastT || nowO)) / 1000, 0, 0.1);
    orbitLastT = nowO;

    if (orbit.follow) {
        orbit.heading = radians(getAircraftHeading()) + orbit.offset;
    } else if (orbit.spin && !camDragging && nowO - camDragEnd > ORBIT_SPIN_RESUME_MS) {
        orbit.heading += orbit.spin * dtO;
    }

    const base = C.Cartesian3.fromDegrees(p.lon, p.lat, p.alt + 4);
    const enu = C.Transforms.eastNorthUpToFixedFrame(base);
    const target = C.Matrix4.multiplyByPoint(enu, new C.Cartesian3(orbitFocus.e, orbitFocus.n, orbitFocus.u), new C.Cartesian3());

    camera.lookAt(target, new C.HeadingPitchRange(orbit.heading, orbit.pitch, orbit.range));

    camera.lookAtTransform(C.Matrix4.IDENTITY);
}

// ---------- On-aircraft cameras ----------

function aircraftName() {
    try {
        const a = aircraft();
        const n =

            (a.aircraftRecord && a.aircraftRecord.name) ||
            (a.definition && a.definition.name) ||
            a.name || "";
        return String(n).toLowerCase();
    } catch (e) {
        return "";
    }

}

function aircraftOverride() {
    const name = aircraftName();
    if (!name) return null;

    for (const key in AIRCRAFT_CAMERA_OVERRIDES) {

        if (name.indexOf(key.toLowerCase()) !== -1) return AIRCRAFT_CAMERA_OVERRIDES[key];
    }
    return null;
}

function validTriple(v) {
    return Array.isArray(v) && v.length >= 3 && v.slice(0, 3).every(Number.isFinite);
}

// Cockpit eye position as {right, forward, up, source}.
function cockpitPosition(o) {
    if (o && validTriple(o.cockpit)) {
        return { right: o.cockpit[0], forward: o.cockpit[1], up: o.cockpit[2], source: "override" };
    }

    const len = planeLength();

    try {
        const pos = aircraft().definition.cameras.cockpit.position;
        // GeoFS definitions list positions as [right, forward, up] in metres.
        if (validTriple(pos) && Math.abs(pos[1]) <= len && Math.abs(pos[0]) <= len) {
            return { right: pos[0], forward: pos[1], up: pos[2], source: "aircraft definition" };
        }
    } catch (e) {}

    return {
        right: 0,
        forward: len * COCKPIT_FORWARD_FRACTION,
        up: COCKPIT_UP_M,
        source: "estimate"
    };
}

// ---- Live tuning of the wing / cockpit cameras (saved in this browser) ----
const TUNE_KEY = "ypb_cam_tune_v1";

let tuneOpen = false;
let mountTune = (function () {
    try { return JSON.parse(localStorage.getItem(TUNE_KEY)) || {}; } catch (e) { return {}; }
})();

// Both wing cameras share one tuning (mirrored for the right side).

function tuneKey(mode) {
    return (mode === "wing1" || mode === "wing2") ? "wing" : mode;
}

// Carry over an earlier Wing 1 tuning to the shared one.
if (!mountTune.wing && mountTune.wing1) mountTune.wing = mountTune.wing1;

function tuneFor(mode) {
    const k = tuneKey(mode);

    if (!mountTune[k]) mountTune[k] = { out: 0, forward: 0, up: 0, yaw: 0, pitch: 0 };
    return mountTune[k];
}

function saveTune() {
    try { localStorage.setItem(TUNE_KEY, JSON.stringify(mountTune)); } catch (e) {}
}

function applyTune(mode, spec, side) {
    const t = tuneFor(mode);
    spec.right += side * t.out;
    spec.forward += t.forward;
    spec.up += t.up;
    spec.yaw += side * t.yaw;
    spec.pitch += t.pitch;
    return spec;
}

function nudgeCamera(key, delta) {
    if (!mountActive) return;
    const t = tuneFor(cameraMode);
    t[key] = Math.round((t[key] + delta) * 100) / 100;
    saveTune();
}

function resetTune() {
    if (!mountActive) return;
    mountTune[tuneKey(cameraMode)] = { out: 0, forward: 0, up: 0, yaw: 0, pitch: 0 };
    saveTune();
    notify("CAMERA TUNING RESET");
}

// Shows the current numbers (also in the console) so they can be pasted
// into AIRCRAFT_CAMERA_OVERRIDES.

function showTuneValues() {
    const spec = mountSpec(cameraMode);
    if (!spec) return;

    let line;

    if (cameraMode === "cockpit") {
        line = "cockpit: [" + [spec.right, spec.forward, spec.up].map(function (v) { return v.toFixed(2); }).join(", ") + "]";
    } else {
        line = "wingCamRight: " + Math.abs(spec.right).toFixed(2) +
            ", wingCamForward: " + spec.forward.toFixed(2) +
            ", wingCamUp: " + spec.up.toFixed(2) +
            ", wingLookYaw: " + Math.abs(spec.yaw).toFixed(0) +
            "  (pitch " + spec.pitch.toFixed(0) + ")";
    }

    console.log("[Y Pushback] " + cameraMode + " camera: " + line);

    notify(cameraMode.toUpperCase() + " — " + line);
}

// Where an on-aircraft camera sits and looks. null = not available.
function mountSpec(mode) {
    const o = aircraftOverride();

    if (mode === "cockpit") {
        const c = cockpitPosition(o);
        return applyTune(mode, { right: c.right, forward: c.forward, up: c.up, yaw: 0, pitch: -2, fov: COCKPIT_FOV_DEG, source: c.source }, 1);
    }

    if (mode === "wing1" || mode === "wing2") {
        const span = o && o.wingSpan !== undefined ? o.wingSpan : WING_SPAN_M;
        if (!(span > 0)) return null;

        const side = mode === "wing1" ? -1 : 1;     // wing 1 = left, wing 2 = right

        const right = o && o.wingCamRight !== undefined ? o.wingCamRight : WING_CAM_RIGHT_M;
        const fwd   = o && o.wingCamForward !== undefined ? o.wingCamForward : WING_CAM_FORWARD_M;
        const up    = o && o.wingCamUp !== undefined ? o.wingCamUp : WING_CAM_UP_M;
        let look    = o && o.wingLookYaw !== undefined ? o.wingLookYaw : WING_LOOK_YAW_DEG;

        // Look out along the wing (same view for push and pull).
        return applyTune(mode, {
            right: side * right,
            forward: fwd,
            up: up,
            yaw: side * look,
            pitch: WING_CAM_PITCH_DEG,
            fov: WING_FOV_DEG
        }, side);
    }


    return null;
}


function modeAvailable(mode) {
    const m = CAMERA_MODES[mode];
    if (!m) return false;
    if (!m.mount) return true;
    return !!mountSpec(mode);
}

// ---- GeoFS's own cockpit camera ----
// The real cockpit view comes from the aircraft model, so we hand the camera
// to GeoFS instead of guessing a position. Falls back to the estimated
// camera (with the Tune buttons) if GeoFS doesn't expose what we need.
let nativeCockpit = false;
let prevGeofsCamMode = null;


function findCockpitModeIndex(cam) {
    const lists = [cam.modes, cam.modeNames, cam.cameraModes];

    for (let i = 0; i < lists.length; i++) {
        const l = lists[i];
        if (!Array.isArray(l)) continue;

        for (let j = 0; j < l.length; j++) {
            const x = l[j];
            const name = typeof x === "string" ? x : (x && (x.name || x.label)) || "";
            if (/cockpit/i.test(name) && !/less/i.test(name)) return j;
        }
    }

    return 1;   // GeoFS order: follow, cockpit, cockpit-less, chase, free, fixed
}

function enterNativeCockpit() {
    try {
        const cam = geofs.camera;
        if (!cam || typeof cam.set !== "function") return false;

        const idx = findCockpitModeIndex(cam);
        prevGeofsCamMode = typeof cam.currentMode === "number" ? cam.currentMode : null;

        cam.set(idx);

        if (typeof cam.currentMode === "number" && cam.currentMode !== idx) {
            // GeoFS refused: put things back and use our own camera.
            if (prevGeofsCamMode !== null) cam.set(prevGeofsCamMode);
            return false;

        }

        return true;

    } catch (e) {
        console.warn("[Y Pushback] Native cockpit camera unavailable:", e);
        return false;
    }
}

function leaveNativeCockpit() {
    nativeCockpit = false;

    try {
        if (prevGeofsCamMode !== null && geofs.camera && typeof geofs.camera.set === "function") {
            geofs.camera.set(prevGeofsCamMode);
        }
    } catch (e) {}


    prevGeofsCamMode = null;
}

function saveFov() {
    if (savedFov !== null) return;
    try {
        const f = geofs.api.viewer.camera.frustum.fov;
        if (typeof f === "number") savedFov = f;
    } catch (e) {}
}

function restoreFov() {
    if (savedFov === null) return;
    try { geofs.api.viewer.camera.frustum.fov = savedFov; } catch (e) {}
    savedFov = null;
}

function applyMountCamera() {
    const spec = mountSpec(cameraMode);
    if (!spec) return;

    const p = getCameraPosition();
    if (!p) return;

    const C = window.Cesium;
    const camera = geofs.api.viewer.camera;

    // Body offset (right / forward) -> east / north, using the aircraft heading.
    const h = radians(getAircraftHeading());
    const east = spec.right * Math.cos(h) + spec.forward * Math.sin(h);
    const north = -spec.right * Math.sin(h) + spec.forward * Math.cos(h);


    const enu = C.Transforms.eastNorthUpToFixedFrame(C.Cartesian3.fromDegrees(p.lon, p.lat, p.alt));

    const dest = C.Matrix4.multiplyByPoint(enu, new C.Cartesian3(east, north, spec.up), new C.Cartesian3());

    camera.setView({
        destination: dest,
        orientation: {
            heading: h + radians(spec.yaw) + mountLook.yaw,
            pitch: clamp(radians(spec.pitch) + mountLook.pitch, radians(-85), radians(85)),
            roll: 0
        }
    });

    try { camera.frustum.fov = radians(mountFov); } catch (e) {}
}

// Switch camera angle (only while moving).
function setCameraMode(mode) {
    if (!inMotion() || !CAMERA_MODES[mode]) return;


    if (!modeAvailable(mode)) {
        notify(CAMERA_MODES[mode].label.toUpperCase() + " CAMERA NOT AVAILABLE");
        return;
    }

    const m = CAMERA_MODES[mode];

    if (mountActive && !m.mount) restoreFov();
    if (nativeCockpit) leaveNativeCockpit();

    cameraMode = mode;
    overheadActive = false;
    orbitActive = false;
    mountActive = false;

    if (mode === "top") {
        overheadActive = true;
    } else if (m.mount && mode === "cockpit" && enterNativeCockpit()) {
        nativeCockpit = true;
        notify("COCKPIT — DRAG TO LOOK AROUND");
    } else if (m.mount) {
        const spec = mountSpec(mode);

        saveFov();
        mountLook = { yaw: 0, pitch: 0 };
        mountFov = spec.fov;
        mountActive = true;

        if (mode === "cockpit") {

            console.log("[Y Pushback] Cockpit camera position from: " + spec.source,

                "right/forward/up =", spec.right.toFixed(1), spec.forward.toFixed(1), spec.up.toFixed(1));
        }
    } else {
        orbitActive = true;

        orbit.follow = m.follow;
        orbit.offset = radians(m.offset);
        orbit.pitch = radians(m.pitch);
        orbit.range = m.range;
        orbit.spin = m.spin ? radians(m.spin) : 0;
        orbitLastT = 0;
        orbitFocus = { e: 0, n: 0, u: 0 };
        orbit.heading = radians(getAircraftHeading()) + orbit.offset;
        if (mode === "orbit") notify("ORBIT — DRAG = LOOK, RIGHT-DRAG = MOVE FOCUS, WHEEL = ZOOM, DOUBLE CLICK = RESET");
    }

    updatePanel();
}

function cycleCamera(step) {
    if (!inMotion()) return;

    let i = CAMERA_ORDER.indexOf(cameraMode);


    for (let n = 0; n < CAMERA_ORDER.length; n++) {
        i = (i + step + CAMERA_ORDER.length) % CAMERA_ORDER.length;
        if (modeAvailable(CAMERA_ORDER[i])) {
            setCameraMode(CAMERA_ORDER[i]);
            return;
        }
    }
}

// Mouse look: drag = orbit / look around, wheel = zoom. Listens on the
// GeoFS 3D canvas only, so GeoFS's own buttons and menus keep working.
function hookCameraMouse() {
    let dragging = false;
    let lx = 0, ly = 0;

    // True when the mouse is over the 3D view. GeoFS can put a transparent full-screen
    // element above the canvas, so the event target is not always the canvas itself.
    function onCanvas(event) {
        const t = event.target;
        if (!t || t === document.body || t === document.documentElement) return false;

        try {
            if (t.closest && t.closest("#y-pushback-panel, #y-pb-saved, #y-pushback-launcher, #ypb-promo, button, input, select, textarea, a, [role='button']")) return false;

            const v = geofs.api.viewer;

            if (v && t === v.canvas) return true;

            const r = t.getBoundingClientRect();
            return r.width >= window.innerWidth * 0.8 && r.height >= window.innerHeight * 0.6;
        } catch (e) {
            return false;
        }
    }

    window.addEventListener("mousedown", function (e) {
        if (!(inMotion() && (orbitActive || overheadActive || mountActive)) || !onCanvas(e)) return;
        dragging = true; camDragging = true; camDragButton = e.button; lx = e.clientX; ly = e.clientY;
    }, true);

    window.addEventListener("mouseup", function () {
        if (dragging) camDragEnd = performance.now();
        dragging = false;
        camDragging = false;
    }, true);

    window.addEventListener("mousemove", function (e) {
        if (!dragging || !(orbitActive || mountActive)) return;


        if (orbitActive && camDragButton === 2) {
            // Right-drag: move the point the camera looks at (Shift = up / down).
            const k = orbit.range * 0.0016;
            const mx = e.clientX - lx;
            const my = e.clientY - ly;
            const hd = orbit.heading;

            if (e.shiftKey) {
                orbitFocus.u = clamp(orbitFocus.u - my * k, -6, 60);
            } else {
                orbitFocus.e += -mx * k * Math.cos(hd) + my * k * Math.sin(hd);
                orbitFocus.n += mx * k * Math.sin(hd) + my * k * Math.cos(hd);
                const r = Math.hypot(orbitFocus.e, orbitFocus.n);
                if (r > 200) { orbitFocus.e *= 200 / r; orbitFocus.n *= 200 / r; }
            }
        } else if (mountActive) {
            // Look around from the wing / cockpit.
            mountLook.yaw += (e.clientX - lx) * 0.005;
            mountLook.pitch = clamp(mountLook.pitch - (e.clientY - ly) * 0.005, radians(-80), radians(80));
        } else {
            const dx = (e.clientX - lx) * 0.006;

            if (orbit.follow) orbit.offset += dx;
            else orbit.heading += dx;

            orbit.pitch = clamp(orbit.pitch - (e.clientY - ly) * 0.005, radians(-89), radians(-2));

        }

        lx = e.clientX; ly = e.clientY;
    }, true);

    // No browser menu on right-drag while the camera is moving the focus.
    window.addEventListener("contextmenu", function (e) {
        if (inMotion() && orbitActive && onCanvas(e)) e.preventDefault();
    }, true);

    // Double click = back to the default view of the current camera.
    window.addEventListener("dblclick", function (e) {
        if (!inMotion() || !onCanvas(e)) return;

        if (orbitActive) {
            const m = CAMERA_MODES[cameraMode];
            orbit.offset = radians(m.offset);
            orbit.pitch = radians(m.pitch);
            orbit.range = m.range;
            orbit.heading = radians(getAircraftHeading()) + orbit.offset;
            orbitFocus = { e: 0, n: 0, u: 0 };
        } else if (mountActive) {
            mountLook = { yaw: 0, pitch: 0 };
            const spec = mountSpec(cameraMode);
            if (spec) mountFov = spec.fov;
        } else if (overheadActive) {
            cameraHeight = CAMERA_HEIGHT_DEFAULT;
        }

        notify("CAMERA RESET");
    }, true);

    window.addEventListener("wheel", function (e) {
        if (!inMotion() || !onCanvas(e)) return;

        const f = e.deltaY > 0 ? 1.1 : 1 / 1.1;


        if (orbitActive) {
            orbit.range = clamp(orbit.range * f, ORBIT_RANGE_MIN, ORBIT_RANGE_MAX);
        } else if (mountActive) {
            mountFov = clamp(mountFov * f, 30, 110);     // wheel = zoom (field of view)
        } else if (overheadActive) {
            cameraHeight = clamp(cameraHeight * f, CAMERA_HEIGHT_MIN, CAMERA_HEIGHT_MAX);
        }
    }, { capture: true, passive: true });
}

// Each frame, right before rendering: run the physics, then
// re-apply our camera (GeoFS repositions its own every frame). The overlay

// is drawn right after the render so both use exactly the same camera.
function hookRenderLoop() {
    const scene = geofs.api.viewer.scene;

    scene.preRender.addEventListener(function () {
        if (pushing) updatePushback();
        updateTugSequence();

        if (overheadActive) {
            try { applyOverheadCamera(); } catch (e) {}
        } else if (orbitActive) {
            try { applyOrbitCamera(); } catch (e) {}
        } else if (mountActive) {
            try { applyMountCamera(); } catch (e) {}
        }

    });

    scene.postRender.addEventListener(function () {
        if (overlayActive) {
            try { drawPlanner(); } catch (e) {
                console.error("[Y Pushback] draw error", e);
            }
        }
    });
}


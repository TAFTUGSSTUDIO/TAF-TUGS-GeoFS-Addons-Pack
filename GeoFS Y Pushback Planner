    promoEl.style.display = "block";
    // next frame so the fade/slide-in transition runs
    requestAnimationFrame(function () { promoEl.classList.add("show"); });

    promoHideTimer = setTimeout(hidePromo, PROMO_VISIBLE_MS);
}

function hidePromo() {
    if (!promoEl) return;
    clearTimeout(promoHideTimer);
    promoEl.classList.remove("show");
    setTimeout(function () {
        if (promoEl && !promoEl.classList.contains("show")) promoEl.style.display = "none";
    }, 450);
}

function startPromo() {
    if (!PROMO_ENABLED) return;
    createPromo();
    setInterval(showPromo, PROMO_INTERVAL_MS);   // first pop-up after 5 min, then every 5 min
}

startPromo();


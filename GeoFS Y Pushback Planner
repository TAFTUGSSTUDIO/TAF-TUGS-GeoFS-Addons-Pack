// SPEED / STOP-MODE / WAIT CONTROL
// ============================================================

// Top-view zoom: factor < 1 = closer, factor > 1 = further away.
function zoomView(factor) {
    cameraHeight = clamp(cameraHeight * factor, CAMERA_HEIGHT_MIN, CAMERA_HEIGHT_MAX);
}

function changeSpeed(delta) {
    speedSetting = clamp(Math.round((speedSetting + delta) * 10) / 10, SPEED_MIN, SPEED_MAX);
    updatePanel();
    notify("SPEED " + speedSetting.toFixed(1) + " m/s");
}

// Stops (stop + wait at every stop) <-> Nonstop (drive through, only stop at the end).
function toggleNonstop() {
    if (!(selecting || pushing)) return;
    nonstopMode = !nonstopMode;
    updatePanel();
    notify(nonstopMode
        ? "NONSTOP — DRIVES THROUGH ALL STOPS, ONLY STOPS AT THE LAST ONE"
        : "STOPS — " + (waitSeconds > 0 ? "WAITS " + waitSeconds + " s" : "NO WAIT") + " AT EACH STOP");
}

function changeWait(delta) {
    if (!(selecting || pushing)) return;
    waitSeconds = clamp(waitSeconds + delta, WAIT_MIN, WAIT_MAX);
    updatePanel();
    notify("WAIT " + waitSeconds + " s AT EACH STOP");
}

// ============================================================
// SAVED PLANS (per airport)
// ============================================================


function loadStore() {
    try {
        const v = JSON.parse(localStorage.getItem(STORE_KEY));
        return Array.isArray(v) ? v : [];
    } catch (e) {

        return [];
    }
}

function writeStore(list) {
    try {
        localStorage.setItem(STORE_KEY, JSON.stringify(list));
        return true;
    } catch (e) {
        console.error("[Y Pushback] Could not save:", e);
        notify("COULD NOT SAVE — BROWSER STORAGE BLOCKED");
        return false;
    }
}

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
}


function savePlan() {
    if (!selecting || !stops.length) {
        notify("ADD AT LEAST ONE STOP BEFORE SAVING");
        return;
    }

    let lastAirport = "";
    try { lastAirport = localStorage.getItem(STORE_LAST_AIRPORT_KEY) || ""; } catch (e) {}

    const airport = window.prompt("Airport (e.g. ENGM):", lastAirport);
    if (airport === null) return;

    const name = window.prompt("Name for this plan (e.g. Gate 12 → taxiway A):", "Gate");
    if (name === null) return;

    const entry = {
        id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
        airport: (airport.trim() || "UNSORTED").toUpperCase(),
        name: name.trim() || "Plan",
        forward: towForward,
        straight: straightMode,

        speed: speedSetting,
        nonstop: nonstopMode,
        wait: waitSeconds,
        aircraft: aircraftName(),
        start: { lat: startPosition.lat, lon: startPosition.lon, heading: startHeading },
        stops: stops.map(function (s) { return { lat: s.lat, lon: s.lon, heading: s.heading }; }),
        saved: Date.now()
    };

    const list = loadStore();

    list.push(entry);

    if (writeStore(list)) {
        try { localStorage.setItem(STORE_LAST_AIRPORT_KEY, entry.airport); } catch (e) {}
        notify("SAVED: " + entry.airport + " — " + entry.name);
    }
}

function createSavedMenu() {
    if (document.getElementById("y-pb-saved")) return;

    const m = document.createElement("div");
    m.id = "y-pb-saved";
    m.style.cssText = `
        position:fixed;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%) scale(${UI_SCALE});
        z-index:1000001;
        display:none;

        background:rgba(8,10,12,.97);
        color:#fff;
        border:1px solid rgba(255,255,255,.22);
        border-radius:12px;
        padding:16px 18px;
        min-width:340px;
        max-width:92vw;
        max-height:70vh;
        overflow:auto;
        font-family:Arial,sans-serif;
        box-shadow:0 8px 40px rgba(0,0,0,.6);
    `;

    m.addEventListener("click", function (e) {
        const b = e.target.closest("button");
        if (!b) return;

        const act = b.dataset.act;

        if (act === "close") closeSaved();
        else if (act === "load") loadSaved(b.dataset.id);
        else if (act === "del") {
            if (window.confirm("Delete this saved plan?")) {
                writeStore(loadStore().filter(function (s) { return s.id !== b.dataset.id; }));
                renderSaved();
            }
        }
        b.blur();
    });

    document.body.appendChild(m);

}

function renderSaved() {
    const m = document.getElementById("y-pb-saved");
    if (!m) return;

    const list = loadStore();
    const groups = {};

    list.forEach(function (s) {
        (groups[s.airport || "UNSORTED"] = groups[s.airport || "UNSORTED"] || []).push(s);
    });

    let html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">' +
        '<div style="font-size:17px;font-weight:bold;">Saved plans</div>' +
        '<button class="ypb-btn" style="padding:4px 10px;" data-act="close">✕</button></div>';

    const airports = Object.keys(groups).sort();


    if (!airports.length) {
        html += '<div style="opacity:.7;font-size:13px;">Nothing saved yet. Plan a route, then press “💾 Save plan”.</div>';
    }

    airports.forEach(function (ap) {
        html += '<div style="margin:12px 0 5px;font-size:13px;font-weight:bold;color:#7cc4ff;">' + escapeHtml(ap) + '</div>';

        groups[ap].forEach(function (s) {
            html += '<div style="display:flex;align-items:center;gap:8px;margin:4px 0;">' +
                '<div style="flex:1;font-size:13px;">' + escapeHtml(s.name) +
                '<div style="font-size:11px;opacity:.6;">' + (s.forward ? "Pull forward" : "Pushback") + ' • ' +
                s.stops.length + ' stop(s) • ' + Number(s.speed || PUSHBACK_SPEED).toFixed(1) + ' m/s' +
                (s.nonstop ? ' • nonstop' : (s.wait !== undefined ? ' • wait ' + escapeHtml(s.wait) + ' s' : '')) +
                (s.aircraft ? ' • ' + escapeHtml(s.aircraft) : '') + '</div></div>' +
                '<button class="ypb-btn" style="padding:5px 10px;" data-act="load" data-id="' + escapeHtml(s.id) + '">Load</button>' +
                '<button class="ypb-btn ypb-stop" style="padding:5px 10px;" data-act="del" data-id="' + escapeHtml(s.id) + '">🗑</button>' +
                '</div>';

        });
    });

    m.innerHTML = html;
}

function openSaved() {
    if (pushing) { notify("STOP THE CURRENT MOVEMENT FIRST"); return; }
    renderSaved();
    const m = document.getElementById("y-pb-saved");
    if (m) m.style.display = "block";
}

function closeSaved() {
    const m = document.getElementById("y-pb-saved");

    if (m) m.style.display = "none";
}

function savedOpen() {
    const m = document.getElementById("y-pb-saved");
    return !!m && m.style.display !== "none";
}

// Loads a saved plan into the planner. Press READY afterwards to start.
function loadSaved(id) {
    const entry = loadStore().find(function (s) { return s.id === id; });
    closeSaved();
    if (!entry || pushing) return;

    enterPlanning(!!entry.forward);
    straightMode = !!entry.straight;

    speedSetting = clamp(Number(entry.speed) || PUSHBACK_SPEED, SPEED_MIN, SPEED_MAX);
    nonstopMode = !!entry.nonstop;
    waitSeconds = clamp(entry.wait !== undefined ? Number(entry.wait) : WAYPOINT_PAUSE_S, WAIT_MIN, WAIT_MAX);


    const list = entry.stops.map(function (s) { return { lat: s.lat, lon: s.lon, heading: s.heading }; });

    if (!buildChain(list)) {
        buildChain([]);
        notify("CAN'T FOLLOW THIS PLAN FROM HERE — PARK AT THE SAVED START");
        updatePanel();
        return;
    }

    stops = list;
    preview = null;
    finalHeading = stops[stops.length - 1].heading;


    let msg = "LOADED: " + entry.airport + " — " + entry.name + " — PRESS READY";

    if (entry.start && distance(startPosition, entry.start) > SAVED_START_WARN_M) {
        msg += "  (plane is " + Math.round(distance(startPosition, entry.start)) + " m from the saved start)";
    }

    notify(msg);
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
    updatePanel();
}


function renderSaved() {
    const m = document.getElementById("y-pb-saved");
    if (!m) return;

    const list = loadStore();
    const groups = {};

    list.forEach(function (s) {
        (groups[s.airport || "UNSORTED"] = groups[s.airport || "UNSORTED"] || []).push(s);
    });

    let html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">' +
        '<div style="font-size:17px;font-weight:bold;">Saved plans</div>' +
        '<button class="ypb-btn" style="padding:4px 10px;" data-act="close">✕</button></div>';

    const airports = Object.keys(groups).sort();

    if (!airports.length) {
        html += '<div style="opacity:.7;font-size:13px;">Nothing saved yet. Plan a route, then press “💾 Save plan”.</div>';
    }

    airports.forEach(function (ap) {
        html += '<div style="margin:12px 0 5px;font-size:13px;font-weight:bold;color:#7cc4ff;">' + escapeHtml(ap) + '</div>';

        groups[ap].forEach(function (s) {
            html += '<div style="display:flex;align-items:center;gap:8px;margin:4px 0;">' +
                '<div style="flex:1;font-size:13px;">' + escapeHtml(s.name) +
                '<div style="font-size:11px;opacity:.6;">' + (s.forward ? "Pull forward" : "Pushback") + ' • ' +
                s.stops.length + ' stop(s) • ' + Number(s.speed || PUSHBACK_SPEED).toFixed(1) + ' m/s' +
                (s.aircraft ? ' • ' + escapeHtml(s.aircraft) : '') + '</div></div>' +
                '<button class="ypb-btn" style="padding:5px 10px;" data-act="load" data-id="' + escapeHtml(s.id) + '">Load</button>' +
                '<button class="ypb-btn ypb-stop" style="padding:5px 10px;" data-act="del" data-id="' + escapeHtml(s.id) + '">🗑</button>' +
                '</div>';
        });
    });

    m.innerHTML = html;
}

function openSaved() {
    if (pushing) { notify("STOP THE CURRENT MOVEMENT FIRST"); return; }
    renderSaved();
    const m = document.getElementById("y-pb-saved");
    if (m) m.style.display = "block";
}

function closeSaved() {
    const m = document.getElementById("y-pb-saved");
    if (m) m.style.display = "none";
}

function savedOpen() {
    const m = document.getElementById("y-pb-saved");
    return !!m && m.style.display !== "none";
}

// Loads a saved plan into the planner. Press READY afterwards to start.
function loadSaved(id) {
    const entry = loadStore().find(function (s) { return s.id === id; });
    closeSaved();
    if (!entry || pushing) return;

    enterPlanning(!!entry.forward);
    straightMode = !!entry.straight;

    speedSetting = clamp(Number(entry.speed) || PUSHBACK_SPEED, SPEED_MIN, SPEED_MAX);

    const list = entry.stops.map(function (s) { return { lat: s.lat, lon: s.lon, heading: s.heading }; });

    if (!buildChain(list)) {
        buildChain([]);
        notify("CAN'T FOLLOW THIS PLAN FROM HERE — PARK AT THE SAVED START");
        updatePanel();
        return;
    }

    stops = list;
    preview = null;
    finalHeading = stops[stops.length - 1].heading;

    let msg = "LOADED: " + entry.airport + " — " + entry.name + " — PRESS READY";

    if (entry.start && distance(startPosition, entry.start) > SAVED_START_WARN_M) {
        msg += "  (plane is " + Math.round(distance(startPosition, entry.start)) + " m from the saved start)";
    }

    notify(msg);
    updateDistanceUI(routeTotalLength);
    updateHeadingUI();
    updatePanel();
}


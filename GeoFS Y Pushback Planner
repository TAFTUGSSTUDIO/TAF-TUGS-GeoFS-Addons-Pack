        border:1px solid rgba(255,255,255,.22);
        border-radius:12px;
        padding:16px 18px;
        min-width:340px;
        max-width:92vw;
        max-height:70vh;
        overflow:auto;
        font-family:Arial,sans-serif;
        box-shadow:0 8px 40px rgba(0,0,0,.6);
    `;

    m.addEventListener("click", function (e) {

PAGES.RTE = function () {
    const n = Math.ceil((st.route.length + 1) / 5);
    const pages = 1 + Math.max(1, n);
    if (st.sub >= pages) st.sub = pages - 1;
    const title = (st.active ? 'ACT ' : '') + 'RTE 1';
    const L = [], R = [];
    let rows;
    if (st.sub === 0) {
        rows = fill([
            row('ORIGIN', st.origin || BOX, 'DEST', st.dest || BOX, { lc: 'g', rc: 'g' }),
            row('FLT NO', st.flt || DASH, 'CO ROUTE', st.coRte || DASH),
            blank(), blank(), blank(),
            row('', '<INDEX', '', st.active ? 'LEGS>' : 'ACTIVATE>', { rc: st.active ? '' : 'g' })
        ]);
        const icao = function (s) { return /^[A-Z]{4}$/.test(s) ? s : null; };
        L[0] = edit(function () { return st.origin; }, function (v) { st.origin = v || ''; }, icao, true);
        R[0] = edit(function () { return st.dest; }, function (v) { st.dest = v || ''; }, icao, true);
        L[1] = edit(function () { return st.flt; }, function (v) { st.flt = v || ''; }, function (s) { return /^[A-Z0-9]{1,8}$/.test(s) ? s : null; });
        R[1] = edit(function () { return st.coRte; }, function (v) { st.coRte = v || ''; }, function (s) { return /^[A-Z0-9]{1,10}$/.test(s) ? s : null; });
        L[5] = function () { go('INDEX'); };
        R[5] = function () { if (st.active) go('LEGS'); else st.exec = true; };
    } else {
        const base = (st.sub - 1) * 5;
        rows = [];
        for (let i = 0; i < 5; i++) {
            (function (i) {
                const idx = base + i, w = st.route[idx];
                if (w) rows.push(row('VIA', w.via || 'DIRECT', 'TO', w.id, { rc: 'g' }));
                else if (idx === st.route.length) rows.push(row('VIA', DASH, 'TO', DASH));
                else rows.push(blank());
                if (w) L[i] = edit(function () { return w.via || 'DIRECT'; }, function (v) { w.via = v || 'DIRECT'; },
                    function (s) { return /^[A-Z0-9]{1,6}$/.test(s) ? s : null; }, true);
                R[i] = function () {
                    const s = st.scratch;
                    if (!s) { if (w) st.scratch = w.id; return; }
                    if (s === 'DELETE') { if (w) { st.route.splice(idx, 1); st.scratch = ''; st.exec = true; } return; }
                    if (!w && idx !== st.route.length) return;
                    const f = lookupFix(s);
                    if (!f) return err('NOT IN DATA BASE');
                    if (w) { w.id = f.id; w.lat = f.lat; w.lon = f.lon; }
                    else st.route.push({ id: f.id, lat: f.lat, lon: f.lon, via: 'DIRECT' });
                    st.scratch = ''; st.exec = true;
                };
            })(i);
        }
        rows.push(row('', '<INDEX', '', st.active ? 'LEGS>' : 'ACTIVATE>', { rc: st.active ? '' : 'g' }));
        L[5] = function () { go('INDEX'); };
        R[5] = function () { if (st.active) go('LEGS'); else st.exec = true; };
    }
    return { title: title, pages: pages, rows: rows, L: L, R: R };
};


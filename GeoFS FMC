const MAP_RANGES = [0, 10, 20, 40, 80, 160, 320];
PAGES.MAP = function () {
    const p = me(), hh = hdgNow() || 0, pts = pathPts();
    const cx = 104, cy = 66, R = 50;
    let range = MAP_RANGES[st.mapRange];
    if (!range) {
        let m = 15;
        if (p) pts.forEach(function (q) { m = Math.max(m, distNm(p, q) * 1.15); });
        range = MAP_RANGES.slice(1).find(function (r) { return r >= m; }) || 320;
    }
    let svg = '<svg width="208" height="112" viewBox="0 0 208 112" style="display:block"><defs><clipPath id="fmcmc"><rect width="208" height="112"/></clipPath></defs><g clip-path="url(#fmcmc)">';
    svg += '<circle cx="' + cx + '" cy="' + cy + '" r="' + R + '" fill="none" stroke="#8a8a8a" stroke-dasharray="3 3"/>';
    svg += '<circle cx="' + cx + '" cy="' + cy + '" r="' + (R / 2) + '" fill="none" stroke="#5e5e5e" stroke-dasharray="2 4"/>';
    if (!p) {
        svg += '<text x="104" y="60" text-anchor="middle" fill="#ffb340" font-size="11">NO POSITION</text>';
    } else {
        const k = R / range, h = hh * Math.PI / 180, cH = Math.cos(h), sH = Math.sin(h), ls = 60 * Math.cos(rad(p.lat));
        const proj = function (q) {
            const e = (q.lon - p.lon) * ls, n = (q.lat - p.lat) * 60;
            return [cx + (e * cH - n * sH) * k, cy - (e * sH + n * cH) * k];
        };
        const xy = pts.map(proj);
        if (xy.length > 1) svg += '<polyline fill="none" stroke="#ff5cf0" stroke-width="2" points="' + xy.map(function (q) { return q[0].toFixed(1) + ',' + q[1].toFixed(1); }).join(' ') + '"/>';
        const c = progCalc();
        if (c && c.nxt) { const q = proj(c.nxt); svg += '<line x1="' + cx + '" y1="' + cy + '" x2="' + q[0].toFixed(1) + '" y2="' + q[1].toFixed(1) + '" stroke="#fff" stroke-width="1" stroke-dasharray="4 3"/>'; }
        pts.forEach(function (w, i) {
            const q = xy[i];
            svg += '<path d="M' + q[0].toFixed(1) + ',' + (q[1] - 3.5).toFixed(1) + ' l3.5,3.5 l-3.5,3.5 l-3.5,-3.5z" fill="#ff5cf0"/>' +

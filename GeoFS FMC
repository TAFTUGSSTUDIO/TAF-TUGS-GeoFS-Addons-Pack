function applyFmcTheme(t) {
    const v = {
        '--hb1': shade(t.bg, 0.08), '--hb2': shade(t.bg, -0.35), '--bd': t.bd,
        '--k1': shade(t.key, 0.18), '--k2': shade(t.key, -0.4), '--k3': shade(t.key, -0.6), '--kt': '#f2f2f2',
        '--p1': shade(t.pad, 0.1), '--p2': shade(t.pad, -0.25), '--p3': shade(t.pad, -0.4), '--pt': t.pt,
        '--scr': t.scr, '--sbd': shade(t.bd, -0.3), '--sbd2': shade(t.bg, -0.2), '--lt': shade(t.bg, 0.65),
        '--tbg': t.bd, '--tbd': t.bg, '--ttx': '#f3f3f3'
    };
    Object.keys(v).forEach(function (k) {
        container.style.setProperty(k, v[k]);
        tab.style.setProperty(k, v[k]);
    });
}
applyFmcTheme(FTH.DEFAULT);

let curAcId = null;
function updateAircraftTheme() {
    try {
        if (typeof geofs === 'undefined' || !geofs.aircraft || !geofs.aircraft.instance) return;
        const inst = geofs.aircraft.instance;
        const id = inst.id;
        if (id === curAcId) return;
        curAcId = id;
        const name = String((inst.aircraftRecord && inst.aircraftRecord.name) || inst.name || '').toLowerCase();
        let t = FTH.DEFAULT;
        for (let i = 0; i < FTH_RULES.length; i++) {
            if (FTH_RULES[i][0].test(name)) { t = FTH[FTH_RULES[i][1]]; break; }
        }
        applyFmcTheme(t);
    } catch (e) {}
}

// ------------------------------------------------------------------ GeoFS helpers
function me() {
    try {
        const l = geofs.aircraft.instance.llaLocation;
        if (l && isFinite(l[0]) && isFinite(l[1])) return { lat: l[0], lon: l[1], alt: l[2] * 3.28084 };
    } catch (e) {}
    return null;
}
function vals() { try { return geofs.animation.values || {}; } catch (e) { return {}; } }
function gsKt() { const v = vals(); return Number(v.groundSpeedKnt) || Number(v.kias) || 0; }
function hdgNow() { const v = vals(); return typeof v.heading360 === 'number' ? v.heading360 : null; }
function acModel() {
    try {
        const a = geofs.aircraft.instance;
        return String((a.aircraftRecord && a.aircraftRecord.name) || a.name || 'UNKNOWN').toUpperCase().slice(0, 14);
    } catch (e) { return 'UNKNOWN'; }
}
const rad = function (d) { return d * Math.PI / 180; };
function distNm(a, b) {
    const dLat = rad(b.lat - a.lat), dLon = rad(b.lon - a.lon);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
    return 2 * 3440.065 * Math.asin(Math.min(1, Math.sqrt(h)));
}
function brgDeg(a, b) {
    const dLon = rad(b.lon - a.lon);
    const y = Math.sin(dLon) * Math.cos(rad(b.lat));
    const x = Math.cos(rad(a.lat)) * Math.sin(rad(b.lat)) - Math.sin(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.cos(dLon);
    return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
}
function fmtPos(p) {
    if (!p) return '-----';
    function part(v, pos, neg, w) {
        const a = Math.abs(v), d = Math.floor(a), m = (a - d) * 60;
        return (v >= 0 ? pos : neg) + String(d).padStart(w, '0') + '°' + m.toFixed(1).padStart(4, '0');
    }
    return part(p.lat, 'N', 'S', 2) + ' ' + part(p.lon, 'E', 'W', 3);
}
const pad2 = function (n) { return String(n).padStart(2, '0'); };
function utc(offMin) {
    const d = new Date(Date.now() + (offMin || 0) * 60000);
    return pad2(d.getUTCHours()) + pad2(d.getUTCMinutes()) + 'Z';
}
function fmtEte(hours) {
    if (!isFinite(hours) || hours < 0) return '-----';
    const m = Math.round(hours * 60);
    return Math.floor(m / 60) + '+' + pad2(m % 60);
}

// user-made waypoints (type  NAME/lat/lon  in the scratchpad)
let userFix = {};
try { userFix = JSON.parse(localStorage.getItem('geofs-fmc-userfix')) || {}; } catch (e) {}
function saveFix() { try { localStorage.setItem('geofs-fmc-userfix', JSON.stringify(userFix)); } catch (e) {} }
let wptN = 0;
const tmpFix = {};      // points that came from a flight plan loaded in GeoFS (not saved)
const validLL = function (f) { return Math.abs(f.lat) <= 90 && Math.abs(f.lon) <= 180; };

function lookupFix(raw) {
    const s = String(raw).toUpperCase().trim();
    let m;
    if (!s) return null;
    if (userFix[s]) return userFix[s];
    if (tmpFix[s]) return tmpFix[s];
    if ((m = s.match(/^([A-Z0-9]{2,6})\/(-?\d+(?:\.\d+)?)\/(-?\d+(?:\.\d+)?)$/))) {
        const f = { id: m[1], lat: +m[2], lon: +m[3] };
        if (validLL(f)) { userFix[f.id] = f; saveFix(); return f; }
        return null;
    }
    if ((m = s.match(/^(-?\d+(?:\.\d+)?)\/(-?\d+(?:\.\d+)?)$/))) {
        const f = { id: 'WPT' + pad2(++wptN), lat: +m[1], lon: +m[2] };
        if (validLL(f)) { userFix[f.id] = f; saveFix(); return f; }
        return null;
    }
    try {
        const ap = geofs.mainAirportList;
        if (ap) {
            if (Array.isArray(ap)) {
                for (let i = 0; i < ap.length; i++) {
                    const a = ap[i];
                    if (Array.isArray(a) && String(a[0]).toUpperCase() === s && isFinite(a[1]) && isFinite(a[2])) return { id: s, lat: +a[1], lon: +a[2] };
                }
            } else if (ap[s] && isFinite(ap[s][0]) && isFinite(ap[s][1])) {
                return { id: s, lat: +ap[s][0], lon: +ap[s][1] };
            }
        }
    } catch (e) {}
    try {
        const nv = geofs.nav && geofs.nav.navaids;
        if (nv) {
            const list = Array.isArray(nv) ? nv : Object.values(nv);
            for (let i = 0; i < list.length; i++) {
                const n = list[i];
                if (!n) continue;
                const id = String(n.id || n.ident || n.icao || n.name || '').toUpperCase();
                const la = Number(n.lat !== undefined ? n.lat : n.latitude), lo = Number(n.lon !== undefined ? n.lon : (n.lng !== undefined ? n.lng : n.longitude));
                if (id === s && isFinite(la) && isFinite(lo)) return { id: s, lat: la, lon: lo };
            }
        }
    } catch (e) {}
    return null;
}


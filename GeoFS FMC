         '• Waypoint not found? Use the 4-letter airport code or <code>NAME/lat/lon</code>.<br>• Come back any time: FMC <code>MENU</code> → <b>HELP / TUTORIAL</b>.' }
];
let helpStep = 0;

function helpRender() {
    const s = HELP_STEPS[helpStep];
    let h = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><h3>' + s.t + '</h3><button class="fmc-hb" data-h="close">✕</button></div>';
    h += '<div>' + (s.h || '') + '</div>';
    if (s.form) {
        h += '<div style="margin-top:10px">Destination airport (4 letters)<input id="fmc-q-dest" maxlength="4" placeholder="e.g. ENBR"></div>' +
             '<div>Waypoints in between (optional)<input id="fmc-q-via" placeholder="e.g. ENZV  (space between names)"></div>' +
             '<button class="fmc-hb g" data-h="quick">✈ Create my route</button><div id="fmc-q-out" style="margin-top:8px"></div>';
    }
    if (s.go) h += '<div style="margin-top:10px"><button class="fmc-hb g" data-h="go">' + s.gl + '</button></div>';
    h += '<div style="margin-top:14px;display:flex;justify-content:space-between;align-items:center">' +
         '<button class="fmc-hb" data-h="back"' + (helpStep === 0 ? ' disabled style="opacity:.4"' : '') + '>◀ Back</button>' +
         '<span style="opacity:.7">' + (helpStep + 1) + ' / ' + HELP_STEPS.length + '</span>' +
         '<button class="fmc-hb" data-h="' + (helpStep === HELP_STEPS.length - 1 ? 'close' : 'next') + '">' + (helpStep === HELP_STEPS.length - 1 ? 'Done ✔' : 'Next ▶') + '</button></div>';
    helpEl.innerHTML = h;
}
function showFMC() { if (container.style.display !== 'block') tab.click(); }
helpEl.addEventListener('click', function (e) {
    const b = e.target.closest('button');
    if (!b || b.disabled) return;
    const a = b.dataset.h, s = HELP_STEPS[helpStep];
    if (a === 'close') toggleHelp(false);
    else if (a === 'next') { helpStep = Math.min(HELP_STEPS.length - 1, helpStep + 1); helpRender(); }
    else if (a === 'back') { helpStep = Math.max(0, helpStep - 1); helpRender(); }
    else if (a === 'go') { showFMC(); go(s.go); }
    else if (a === 'quick') {
        const r = quickRoute(($('fmc-q-dest') || {}).value, ($('fmc-q-via') || {}).value);
        const out = $('fmc-q-out');
        if (out) out.innerHTML = '<div class="note"' + (r.ok ? '' : ' style="border-color:#ff6a5a;background:#2a1a1a"') + '>' + r.text + '</div>';
        if (r.ok) showFMC();
    }
});
function toggleHelp(force) {
    const show = force !== undefined ? force : helpEl.style.display !== 'block';
    helpEl.style.display = show ? 'block' : 'none';
    if (show) {
        helpStep = 0; helpRender();
        try { localStorage.setItem('geofs-fmc-help-seen', '1'); } catch (e) {}
    }
}

render();
console.log('[GeoFS FMC] ready');
})();

let curAcId = null;
function updateAircraftTheme() {
    try {
        if (typeof geofs === 'undefined' || !geofs.aircraft || !geofs.aircraft.instance) return;
        const inst = geofs.aircraft.instance;
        const id = inst.id;
        if (id === curAcId) return;
        curAcId = id;
        const name = String((inst.aircraftRecord && inst.aircraftRecord.name) || inst.name || '').toLowerCase();
        let th = FTH.DEFAULT;
        for (let i = 0; i < FTH_RULES.length; i++) {
            if (FTH_RULES[i][0].test(name)) { th = FTH[FTH_RULES[i][1]]; break; }
        }
        applyFmcTheme(th);
    } catch (e) {}
}

// ------------------------------------------------------------------ GeoFS helpers
function me() {
    try {
        const l = geofs.aircraft.instance.llaLocation;
        if (l && isFinite(l[0]) && isFinite(l[1])) return { lat: l[0], lon: l[1], alt: l[2] * 3.28084 };
    } catch (e) {}
    return null;
}
function vals() { try { return geofs.animation.values || {}; } catch (e) { return {}; } }
function gsKt() { const v = vals(); return Number(v.groundSpeedKnt) || Number(v.kias) || 0; }
function hdgNow() { const v = vals(); return typeof v.heading360 === 'number' ? v.heading360 : null; }
function acModel() {
    try {
        const a = geofs.aircraft.instance;
        return String((a.aircraftRecord && a.aircraftRecord.name) || a.name || 'UNKNOWN').toUpperCase().slice(0, 14);
    } catch (e) { return 'UNKNOWN'; }
}
const rad = function (d) { return d * Math.PI / 180; };
function distNm(a, b) {
    const dLat = rad(b.lat - a.lat), dLon = rad(b.lon - a.lon);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLon / 2) ** 2;
    return 2 * 3440.065 * Math.asin(Math.min(1, Math.sqrt(h)));
}
function brgDeg(a, b) {
    const dLon = rad(b.lon - a.lon);
    const y = Math.sin(dLon) * Math.cos(rad(b.lat));
    const x = Math.cos(rad(a.lat)) * Math.sin(rad(b.lat)) - Math.sin(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.cos(dLon);
    return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
}
function fmtPos(p) {
    if (!p) return '-----';
    function part(v, pos, neg, w) {
        const a = Math.abs(v), d = Math.floor(a), m = (a - d) * 60;
        return (v >= 0 ? pos : neg) + String(d).padStart(w, '0') + '°' + m.toFixed(1).padStart(4, '0');
    }
    return part(p.lat, 'N', 'S', 2) + ' ' + part(p.lon, 'E', 'W', 3);
}
const pad2 = function (n) { return String(n).padStart(2, '0'); };
function utc(offMin) {
    const d = new Date(Date.now() + (offMin || 0) * 60000);
    return pad2(d.getUTCHours()) + pad2(d.getUTCMinutes()) + 'Z';
}
function fmtEte(hours) {
    if (!isFinite(hours) || hours < 0) return '-----';
    const m = Math.round(hours * 60);
    return Math.floor(m / 60) + '+' + pad2(m % 60);
}


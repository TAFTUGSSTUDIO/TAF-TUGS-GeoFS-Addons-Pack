const st = {
    page: 'MENU', sub: 0, scratch: '', msg: '', exec: false, active: false, na: '',
    origin: '', dest: '', flt: '', coRte: '', route: [],
    refApt: '', gate: '', irs: null,
    dep: { rwy: '', sid: '' }, arr: { star: '', appr: '', rwy: '' },
    zfw: 0, fuel: 0, resv: 0, ci: '', crz: 0,
    flaps: 0, v1: 0, vr: 0, v2: 0, derate: 0, appFlaps: 30,
    clbSpd: 280, crzMach: 0.78, desSpd: 280, fixId: ''

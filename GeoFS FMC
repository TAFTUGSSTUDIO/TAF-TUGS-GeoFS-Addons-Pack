    MIL_DARK:       { bg: '#33383e', bd: '#141619', key: '#22262a', pad: '#9aa0a6', pt: '#0b0c0d', scr: '#d8ffd0' },
    MIL_BLACK:      { bg: '#1f2124', bd: '#09090a', key: '#141618', pad: '#41464b', pt: '#cdd3d6', scr: '#d0ffe0' },

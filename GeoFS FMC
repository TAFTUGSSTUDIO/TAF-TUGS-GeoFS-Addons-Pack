// ------------------------------------------------------------------ DOM
const container = document.createElement('div');
container.id = 'geofs-fmc-container';
document.body.appendChild(container);

// toggle button: docked into the GeoFS bottom bar (falls back to a floating tab)
const tab = document.createElement('button');
tab.id = 'geofs-fmc-tab';
tab.className = 'mdl-button mdl-js-button geofs-f-standard-ui fmc-toggle-tab';
tab.textContent = '🖥️ FMC';
tab.addEventListener('click', function () { tab.blur(); });
function dockTab() {
    const bar = document.querySelector('.geofs-ui-bottom');
    if (bar) {
        if (tab.parentNode !== bar) {
            const m = $('geofs-mcp-tab');
            if (m && m.parentNode === bar) m.after(tab); else bar.appendChild(tab);
        }
        tab.classList.remove('floating');
    } else {
        if (!tab.parentNode) document.body.appendChild(tab);
        tab.classList.add('floating');
    }
}
dockTab();
setInterval(dockTab, 2000);   // re-dock if GeoFS rebuilds its bar

let scale = 1, placed = false;
function applyScale() { container.style.transform = 'scale(' + scale + ')'; }
applyScale();

tab.addEventListener('click', function () {
    const show = container.style.display !== 'block';
    container.style.display = show ? 'block' : 'none';
    if (show && !placed) {
        placed = true;
        container.style.left = Math.max(10, window.innerWidth - 330) + 'px';
        container.style.top = Math.max(10, window.innerHeight - 560) + 'px';

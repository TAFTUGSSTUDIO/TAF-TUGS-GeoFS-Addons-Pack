function applyFmcTheme(th) {
    const v = {
        '--hb1': shade(th.bg, 0.08), '--hb2': shade(th.bg, -0.35), '--bd': th.bd,
        '--k1': shade(th.key, 0.18), '--k2': shade(th.key, -0.4), '--k3': shade(th.key, -0.6), '--kt': '#f2f2f2',
        '--p1': shade(th.pad, 0.1), '--p2': shade(th.pad, -0.25), '--p3': shade(th.pad, -0.4), '--pt': th.pt,
        '--scr': th.scr, '--sbd': shade(th.bd, -0.3), '--sbd2': shade(th.bg, -0.2), '--lt': shade(th.bg, 0.65),
        '--tbg': th.bd, '--tbd': th.bg, '--ttx': '#f3f3f3'
    };

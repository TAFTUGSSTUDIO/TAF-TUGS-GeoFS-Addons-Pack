    html += '<div class="fmc-lsk" data-s="L" data-i="' + i + '" style="left:10px;top:' + y + 'px"></div>';
    html += '<div class="fmc-lsk" data-s="R" data-i="' + i + '" style="left:260px;top:' + y + 'px"></div>';
}
const FN = [
    [['INIT<br>REF', 'INITREF'], ['RTE', 'RTE'], ['DEP<br>ARR', 'DEPARR'], ['ATC', 'ATC'], ['VNAV', 'VNAV']],
    [['FIX', 'FIX'], ['LEGS', 'LEGS'], ['HOLD', 'HOLD'], ['FMC<br>COMM', 'COMM'], ['PROG', 'PROG'], ['EXEC', 'EXEC']],

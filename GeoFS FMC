            L: [pbAct('ready'), pbAct('undo'), pbAct('straight'), pbAct('spdD'), pbAct('nonstop'), menu],
            R: [pbAct('cancel'), pbAct('clear'), pbAct('savePlan'), pbAct('spdU'), pbAct('waitU'), pbAct('waitD')]
        };
    }
    return {
        title: 'PUSHBACK', rows: fill([
            row('', '<PUSH BACK', '', '', { lc: 'g' }),
            row('', '<PULL FORWARD', '', '', { lc: 'g' }),
            row('', '<SAVED PLANS'),
            blank(), blank(),
            row('', '<MENU')
        ]),
        L: [function () { pb(PB_L + 'push"]'); }, function () { pb(PB_L + 'pull"]'); }, function () { pb(PB_L + 'saved"]'); }, , , menu], R: []
    };
};

// ------------------------------------------------------------------ rendering
const esc = function (s) { return String(s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); };
const sp = function (t, c) { return '<span' + (c ? ' class="' + c + '"' : '') + '>' + esc(t) + '</span>'; };
let curDef = null;

function render() {
    const mk = PAGES[st.page] || PAGES.MENU;
    const def = mk();
    curDef = def;
    const pg = (def.pages && def.pages > 1) ? (st.sub + 1) + '/' + def.pages : '';
    let h = '<div class="ttl">' + esc(def.title) + (pg ? '<i>' + pg + '</i>' : '') + '</div>';
    if (def.raw) h += '<div style="height:112px">' + def.raw + '</div>';
    (def.raw ? def.rows.slice(4) : def.rows).forEach(function (r) {
        h += '<div class="lb">' + sp(r.ll) + sp('') + sp(r.rl) + '</div>';
        h += '<div class="dt">' + sp(r.l, r.lc) + sp(r.c, r.cc) + sp(r.r, r.rc) + '</div>';
    });
    h += '<div class="scr' + (st.msg ? ' a' : '') + '">' + esc(st.msg || st.scratch) + '</div>';
    screen.innerHTML = h;
    const lamp = $('fmc-exec-lamp');
    if (lamp && lamp.parentNode) lamp.parentNode.classList.toggle('on', !!st.exec);
    drawPath();
}

// ------------------------------------------------------------------ input
function press(k) {
    if (st.msg) { st.msg = ''; if (k === 'CLR') { render(); return; } }
    switch (k) {
        case 'INITREF': go(st.page === 'INDEX' ? 'IDENT' : (['IDENT', 'POSINIT', 'PERF', 'TAKEOFF', 'APPREF'].indexOf(st.page) >= 0 ? 'INDEX' : 'IDENT')); return;
        case 'RTE': go('RTE'); return;
        case 'DEPARR': go('DEPARR'); return;
        case 'VNAV': go('VNAV'); return;
        case 'FIX': go('FIX'); return;
        case 'LEGS': go('LEGS'); return;
        case 'PROG': go('PROG'); return;
        case 'MENU': go('MENU'); return;
        case 'N1': go('N1'); return;
        case 'MAP': go('MAP'); return;
        case 'ATC': st.na = 'ATC'; go('NA'); return;
        case 'HOLD': st.na = 'HOLD'; go('NA'); return;
        case 'COMM': st.na = 'FMC COMM'; go('NA'); return;
        case 'EXEC':
            if (st.exec || st.route.length) {
                ensureDest();
                st.exec = false;
                st.active = true;
                err('ROUTE ACTIVE');
            }
            render(); return;
        case 'PREV':
        case 'NEXT': {
            const n = (curDef && curDef.pages) || 1;
            if (n > 1) st.sub = (st.sub + (k === 'NEXT' ? 1 : -1) + n) % n;
            render(); return;
        }
        case 'SP': if (st.scratch.length < 24) st.scratch += ' '; render(); return;
        case 'DEL': st.scratch = 'DELETE'; render(); return;
        case 'CLR': st.scratch = st.scratch === 'DELETE' ? '' : st.scratch.slice(0, -1); render(); return;
        case '+/-': {
            const last = st.scratch.slice(-1);
            if (last === '-') st.scratch = st.scratch.slice(0, -1) + '+';
            else if (last === '+') st.scratch = st.scratch.slice(0, -1) + '-';
            else if (st.scratch.length < 24) st.scratch += '-';
            render(); return;
        }
        default:
            if (st.scratch === 'DELETE') st.scratch = '';
            if (st.scratch.length < 24) st.scratch += k;
            render();
    }
}

function pressLSK(side, i) {
    if (st.msg) st.msg = '';
    const f = curDef && curDef[side] && curDef[side][i];
    if (typeof f === 'function') f();
    render();
}

let clrTimer = null;
container.addEventListener('mousedown', function (e) {
    const k = e.target.closest('.fmc-k'), l = e.target.closest('.fmc-lsk');
    if (k) {
        e.stopPropagation(); e.preventDefault();
        const key = k.dataset.k;
        press(key);
        if (key === 'CLR') clrTimer = setTimeout(function () { st.scratch = ''; st.msg = ''; render(); }, 600);
        return;
    }
    if (l) { e.stopPropagation(); e.preventDefault(); pressLSK(l.dataset.s, +l.dataset.i); return; }
    if (e.target.closest('#fmc-screen')) { e.preventDefault(); return; }
    // drag the unit by its housing
    drag = { x: e.clientX - container.offsetLeft, y: e.clientY - container.offsetTop };
    e.preventDefault();
});
window.addEventListener('mouseup', function () {
    if (clrTimer) { clearTimeout(clrTimer); clrTimer = null; }
    drag = null;
});
let drag = null;
window.addEventListener('mousemove', function (e) {
    if (!drag) return;
    container.style.left = (e.clientX - drag.x) + 'px';
    container.style.top = (e.clientY - drag.y) + 'px';
});
container.addEventListener('wheel', function (e) {
    if (!e.altKey) return;
    scale = Math.min(1.8, Math.max(0.5, scale + (e.deltaY < 0 ? 0.05 : -0.05)));
    applyScale();
    e.preventDefault();
}, { passive: false });

// physical keyboard while the mouse is over the FMC
let hover = false;
container.addEventListener('mouseenter', function () { hover = true; });
container.addEventListener('mouseleave', function () { hover = false; });
window.addEventListener('keydown', function (e) {
    if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
    if (!hover || container.style.display !== 'block') return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const k = e.key;
    let out = null;
    if (/^[a-zA-Z0-9.\/]$/.test(k)) out = k.toUpperCase();
    else if (k === ' ') out = 'SP';
    else if (k === 'Backspace') out = 'CLR';
    else if (k === 'Delete') out = 'DEL';
    else if (k === '-' || k === '+') out = '+/-';
    else if (k === 'PageDown') out = 'NEXT';
    else if (k === 'PageUp') out = 'PREV';
    else if (k === 'Enter') out = 'EXEC';
    if (!out) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    press(out);
}, true);

// live pages refresh themselves
// live pages refresh themselves; the flight plan is imported and the route layer kept in sync even when the FMC is hidden
setInterval(function () {
    updateAircraftTheme();
    const imported = importGeo();
    drawPath();
    if (container.style.display !== 'block') return;
    if (imported || ['PROG', 'LEGS', 'POSINIT', 'PUSHBACK', 'VNAV', 'FIX', 'MAP'].indexOf(st.page) >= 0) render();
}, 500);

// ------------------------------------------------------------------ HELP / TUTORIAL
const helpEl = document.createElement('div');
helpEl.id = 'geofs-fmc-help';
document.body.appendChild(helpEl);
['keydown', 'keyup', 'keypress'].forEach(function (n) { helpEl.addEventListener(n, function (e) { e.stopPropagation(); }); });


PAGES.LEGS = function () {
    const R = st.route, pages = Math.max(1, Math.ceil((R.length + 1) / 5));
    if (st.sub >= pages) st.sub = pages - 1;
    const base = st.sub * 5, p = me(), ni = nextIdx();
    const rows = [], L = [], Rr = [];
    for (let i = 0; i < 5; i++) {
        (function (i) {
            const idx = base + i, w = R[idx];
            if (!w && idx !== R.length) { rows.push(blank()); return; }
            let ll = '', l = DASH, r = '', rc = '';
            if (w) {
                const prev = idx > 0 ? R[idx - 1] : p;
                if (prev) ll = String(Math.round(brgDeg(prev, w)) % 360).padStart(3, '0') + '° ' + Math.round(distNm(prev, w)) + 'NM';
                l = w.id;
                r = (w.spd || '---') + '/' + (w.alt ? fmtAlt(w.alt) : '-----');
                rc = (w.spd || w.alt) ? 'g' : '';
            }
            rows.push(row(ll, l, w ? 'SPD/ALT' : '', r, { lc: (w && idx === ni) ? 'm' : '', rc: rc }));
            L[i] = function () {
                const s = st.scratch;
                if (!s) { if (w) st.scratch = w.id; return; }
                if (s === 'DELETE') { if (w) { R.splice(idx, 1); st.scratch = ''; st.exec = true; } return; }
                const f = lookupFix(s);
                if (!f) return err('NOT IN DATA BASE');
                const j = R.findIndex(function (x, k) { return k > idx && x.id === f.id; });
                if (j > 0) R.splice(idx, j - idx);                          // direct-to: skip the legs in between
                else R.splice(idx, 0, { id: f.id, lat: f.lat, lon: f.lon, via: 'DIRECT' });
                st.scratch = ''; st.exec = true;
            };
            if (w) Rr[i] = function () {
                const s = st.scratch;
                if (!s) return;
                if (s === 'DELETE') { delete w.spd; delete w.alt; st.scratch = ''; return; }
                let a = '', b = '';
                if (s.indexOf('/') >= 0) { const q = s.split('/'); a = q[0]; b = q[1] || ''; }

const BOX = '□□□□', DASH = '-----';
function row(ll, l, rl, r, o) {
    return Object.assign({ ll: ll || '', l: l || '', rl: rl || '', r: r || '', c: '', lc: '', rc: '', cc: '' }, o || {});
}
const blank = function () { return row(); };
function fill(rows) { while (rows.length < 6) rows.push(blank()); return rows; }
function err(m) { st.msg = m; }
function go(p, sub) { st.page = p; st.sub = sub || 0; render(); }

const parseAlt = function (s) {
    s = String(s).toUpperCase().trim();
    let m;
    if ((m = s.match(/^FL(\d{2,3})$/))) return +m[1] * 100;
    if (/^\d+$/.test(s)) { const n = +s; if (n <= 600) return n * 100; if (n <= 60000) return n; }
    return null;
};
const fmtAlt = function (a) { return !a ? '' : (a >= 18000 ? 'FL' + String(Math.round(a / 100)).padStart(3, '0') : String(a)); };
const parseWt = function (s) {
    if (!/^\d+(\.\d+)?$/.test(s)) return null;
    let n = +s; if (n < 1000) n *= 1000;
    return (n >= 5000 && n <= 500000) ? Math.round(n) : null;
};
const fmtWt = function (w) { return w ? (w / 1000).toFixed(1) : ''; };
const gwNow = function () { return (st.zfw && st.fuel) ? st.zfw + st.fuel : 0; };

// generic scratchpad field: empty scratch = copy value into scratch, DELETE = clear, else validate + store
function edit(get, set, val, ex) {
    return function () {
        const s = st.scratch;
        if (!s) { const v = get(); if (v) st.scratch = String(v); return; }
        if (s === 'DELETE') { set(null); st.scratch = ''; if (ex) st.exec = true; return; }
        const r = val ? val(s) : s;
        if (r === null || r === undefined) return err('INVALID ENTRY');
        set(r); st.scratch = ''; if (ex) st.exec = true;
    };
}

// ------------------------------------------------------------------ navigation maths
function nextIdx() {
    const R = st.route, p = me();
    if (!R.length || !p) return 0;
    let best = 0, bd = Infinity;
    R.forEach(function (w, i) { const d = distNm(p, w); if (d < bd) { bd = d; best = i; } });
    return bd < 1.5 ? best + 1 : best;
}
function resolveDest() { return st.dest ? lookupFix(st.dest) : null; }
function progCalc() {
    const p = me();
    if (!p) return null;
    const R = st.route, ni = nextIdx(), dp = resolveDest();
    let nxt = null, dn = 0, dd = 0;
    if (R.length && ni < R.length) {
        nxt = R[ni]; dn = distNm(p, nxt); dd = dn;
        for (let i = ni; i < R.length - 1; i++) dd += distNm(R[i], R[i + 1]);
        if (dp) dd += distNm(R[R.length - 1], dp);
    } else if (dp) {
        dd = distNm(p, dp);
    }
    return { p: p, nxt: nxt, dn: dn, dd: dd, dp: dp };
}

// ------------------------------------------------------------------ GeoFS flight plan <-> FMC route
// Reading: a plan loaded in GeoFS (flight plan panel / file) is imported into the FMC route.
// Writing: EXEC / SYNC LNAV pushes the FMC route into GeoFS's plan (so MCP L NAV can follow it).
let lastGeoSig = '', fromGeo = false;

function geoPlanArray() {
    try {
        const fp = geofs.flightPlan;
        const a = fp && (fp.waypointArray || fp.waypoints);
        return Array.isArray(a) ? a : null;
    } catch (e) { return null; }
}
function normGeo(a) {
    const out = [];
    a.forEach(function (w) {
        if (!w) return;
        const lat = Number(w.lat !== undefined ? w.lat : w.latitude);
        const lon = Number(w.lon !== undefined ? w.lon : (w.lng !== undefined ? w.lng : w.longitude));
        if (!isFinite(lat) || !isFinite(lon)) return;
        const id = String(w.ident || w.id || w.name || w.icao || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 6);
        out.push({ id: id, lat: lat, lon: lon, alt: Number(w.alt) || 0, spd: Number(w.spd) || 0 });
    });
    return out;
}
const geoSig = function (list) {
    return list.map(function (w) { return w.id + ':' + w.lat.toFixed(4) + ':' + w.lon.toFixed(4); }).join(';');
};

function importGeo() {
    const a = geoPlanArray();
    if (!a) return false;
    const list = normGeo(a), sig = geoSig(list);
    if (sig === lastGeoSig) return false;
    lastGeoSig = sig;
    if (!list.length) {                       // plan cleared in GeoFS
        if (!st.route.length) return false;
        st.route = []; st.active = false; st.exec = false; fromGeo = false;
        drawPath(true);
        return true;
    }
    const L = list.slice();
    let org = null, dst = null;
    if (L.length > 1 && /^[A-Z]{4}$/.test(L[0].id)) org = L.shift();
    if (L.length > 1 && /^[A-Z]{4}$/.test(L[L.length - 1].id)) dst = L.pop();
    if (org) { tmpFix[org.id] = { id: org.id, lat: org.lat, lon: org.lon }; st.origin = org.id; if (!st.refApt) st.refApt = org.id; }
    if (dst) { tmpFix[dst.id] = { id: dst.id, lat: dst.lat, lon: dst.lon }; st.dest = dst.id; }
    st.route = L.map(function (w, i) {
        const r = { id: w.id || ('WPT' + pad2(i + 1)), lat: w.lat, lon: w.lon, via: 'DIRECT' };
        if (w.alt > 0) r.alt = Math.round(w.alt);
        if (w.spd > 0) r.spd = Math.round(w.spd);
        return r;
    });
    st.active = true; st.exec = false; fromGeo = true;
    st.msg = 'ROUTE LOADED FROM GEOFS';
    drawPath(true);
    return true;
}

// push the FMC route into GeoFS's own flight plan (so the MCP L NAV button can follow it) and redraw - best effort
function syncGeofs() {
    try {
        const fp = geofs.flightPlan;
        const arr = fp && fp.waypointArray;
        if (!Array.isArray(arr)) { drawPath(true); return false; }
        arr.length = 0;
        st.route.forEach(function (w) {
            arr.push({ lat: w.lat, lon: w.lon, ident: w.id, type: 'FMC', alt: w.alt || undefined, spd: w.spd || undefined });
        });
        const dp = resolveDest();
        if (dp) arr.push({ lat: dp.lat, lon: dp.lon, ident: st.dest, type: 'FMC' });
        lastGeoSig = geoSig(normGeo(arr));          // so we don't re-import our own plan
        ['refreshWaypoints', 'updatePath', 'draw', 'refresh', 'update'].forEach(function (fn) {
            try { if (typeof fp[fn] === 'function') fp[fn](); } catch (e) {}
        });
        drawPath(true);
        return true;
    } catch (e) { drawPath(true); return false; }
}
// set a value on the MCP panel (the MCP script reads geofs.autopilot every 200 ms)
function toMCP(key, v) {
    try {
        const ap = geofs.autopilot;
        if (!ap) return false;
        ap[key] = v;
        if (ap.values) ap.values[key] = v;
        return true;
    } catch (e) { return false; }
}

// ------------------------------------------------------------------ flight path overlay (3D view)
let pathEnts = [], pathSig = '';
function cesiumViewer() {
    try { return (typeof Cesium !== 'undefined' && geofs.api && geofs.api.viewer) || null; } catch (e) { return null; }
}
function clearPath() {
    const v = cesiumViewer();
    if (v) pathEnts.forEach(function (e) { try { v.entities.remove(e); } catch (x) {} });
    pathEnts = [];
}
function drawPath(force) {
    const v = cesiumViewer();
    if (!v) return;
    const pts = [];
    const o = st.origin ? lookupFix(st.origin) : null;
    if (o) pts.push({ id: o.id, lat: o.lat, lon: o.lon });
    st.route.forEach(function (w) { pts.push({ id: w.id, lat: w.lat, lon: w.lon }); });
    const d = resolveDest();
    if (d) pts.push({ id: st.dest, lat: d.lat, lon: d.lon });
    if (pts.length < 2) { if (pathEnts.length) { clearPath(); } pathSig = ''; return; }
    const sig = (st.active ? 'A' : 'M') + pts.map(function (p) { return p.id + p.lat + p.lon; }).join(';');
    if (!force && sig === pathSig) return;
    pathSig = sig;
    clearPath();
    const col = st.active ? Cesium.Color.MAGENTA : Cesium.Color.CYAN;
    const flat = [];
    pts.forEach(function (p) { flat.push(p.lon, p.lat); });
    try {
        pathEnts.push(v.entities.add({
            polyline: {
                positions: Cesium.Cartesian3.fromDegreesArray(flat),
                width: 4,
                clampToGround: true,
                material: col.withAlpha(0.9)
            }
        }));
    } catch (e) { console.warn('[GeoFS FMC] path line failed', e); }
    pts.forEach(function (p) {
        try {
            pathEnts.push(v.entities.add({
                position: Cesium.Cartesian3.fromDegrees(p.lon, p.lat),
                point: { pixelSize: 8, color: col, heightReference: Cesium.HeightReference.CLAMP_TO_GROUND,
                         disableDepthTestDistance: Number.POSITIVE_INFINITY },
                label: {
                    text: p.id, font: '13px monospace', fillColor: Cesium.Color.WHITE,
                    outlineColor: Cesium.Color.BLACK, outlineWidth: 3, style: Cesium.LabelStyle.FILL_AND_OUTLINE,
                    pixelOffset: new Cesium.Cartesian2(0, -16), heightReference: Cesium.HeightReference.CLAMP_TO_GROUND,
                    disableDepthTestDistance: Number.POSITIVE_INFINITY
                }
            }));
        } catch (e) { console.warn('[GeoFS FMC] path point failed', e); }
    });
}

// ------------------------------------------------------------------ approx performance
function calcV() {
    const gw = gwNow();
    if (!gw) { err('ENTER ZFW & FUEL'); return false; }
    if (!st.flaps) { err('ENTER FLAPS'); return false; }
    const t = gw / 1000;
    let v2 = 132 + (t - 60) * 1.15;
    v2 += ({ 1: 4, 5: 0, 10: -2, 15: -4, 25: -8 })[st.flaps] || 0;
    v2 = Math.round(v2);
    st.v2 = v2; st.vr = v2 - 4; st.v1 = v2 - 5;
    return true;
}
function vref(flap) {
    const gw = gwNow() || 60000;
    const t = gw / 1000;
    return Math.round(125 + (t - 50) * 1.2 + ({ 15: 10, 30: 0, 40: -5 })[flap]);
}

